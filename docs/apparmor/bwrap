# AppArmor profile that lets /usr/bin/bwrap (and nothing else) create the user
# namespaces it needs on Ubuntu 24.04+, where
# kernel.apparmor_restrict_unprivileged_userns=1 denies them by default.
# NOT limited to EmuWiz: any program that runs /usr/bin/bwrap gets the exemption,
# and flags=(unconfined) leaves bwrap and its children without AppArmor confinement.
# Prefer the distribution's bwrap-userns-restrict profile where it exists.
# Install only deliberately: see docs/DOSBOX_SANDBOX_UBUNTU.md. EmuWiz never installs it.
abi <abi/4.0>,
include <tunables/global>

profile bwrap /usr/bin/bwrap flags=(unconfined) {
  userns,

  # Site-specific additions and overrides. See local/README for details.
  include if exists <local/bwrap>
}

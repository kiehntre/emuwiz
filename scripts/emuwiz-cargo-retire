#!/usr/bin/env python3
"""emuwiz-cargo-retire: manifest-authorised retirement of Cargo compiler artifacts.

DRY RUN by default.  Nothing is deleted unless --execute is given together with
the approved manifest digest.  It deletes only the exact compiler-artifact paths
named by the approved manifest, and only when every gate below passes; anything
unknown, uncertain or failed is HOLD (left in place, with a reason).

Gates (all required, per cache):
  * the manifest's SHA-256 equals --approved-sha256;
  * the cache is a real directory reached without symlinks, with the manifest's
    device/inode, and no mount point inside the deleted subtrees;
  * a lifecycle record whose adoption is VERIFIED against the source (path hash or
    source path + exact HEAD) - an adoption record alone never authorises deletion;
  * the exclusive lifecycle lock is obtained (builds hold it shared), then a fresh
    process census shows no reference (cwd, exe, fds, maps, CARGO_TARGET_DIR) to
    the cache or its source, with COMPLETE process visibility;
  * no write or recorded build within 48 h and none since the manifest was made;
  * caches that no wrapper-managed build ever recorded need
    --maintenance-window-attested (see docs/CARGO_CACHE_RETENTION.md: advisory
    locks cannot exclude a plain `cargo` that does not use cargo-iso).

Each selected path is re-checked (device/inode/mode, artifact class, no symlink,
no data-looking file) and removed through directory descriptors opened with
O_NOFOLLOW; a changed or rebound path stops that entry.  Cargo's own lock files
(.cargo-lock, .cargo-build-lock, .cargo-artifact-lock) are never removed.
"""
import os
import stat
import sys

# ---------------------------------------------------------------- trust gate
# Runs before ANY other import of this script (os, stat and sys are built in or frozen).
# Kept identical in emuwiz-cargo-maintain and emuwiz-cargo-retire.


def _install_problem(script, siblings, interpreter, module_dirs):
    """None, or why this copy is unfit to run with root privileges: the script, every
    sibling it loads, the interpreter and every module directory, each with all of its
    parent directories, must be root-owned, not group/world writable and symlink-free.

    This is a tripwire for a misplaced or modified copy, checked before this script
    imports anything; it cannot vouch for the interpreter binary or for the few stdlib
    modules the interpreter loads at start-up (encodings), which is why the interpreter
    and its library must live in root-owned directories (verify-install checks them, and
    should first be run unprivileged with the same interpreter)."""
    def problem(path, want_dir):
        cur = path
        while True:
            try:
                st = os.lstat(cur)
            except OSError as error:
                return f"{cur}: {error.strerror}"
            if stat.S_ISLNK(st.st_mode):
                return f"{cur} is a symlink"
            if cur == path and not (stat.S_ISDIR(st.st_mode) if want_dir else stat.S_ISREG(st.st_mode)):
                return f"{cur} is not a {'directory' if want_dir else 'regular file'}"
            if st.st_uid != 0:
                return f"{cur} is owned by uid {st.st_uid}, not root"
            if st.st_mode & 0o022:
                return f"{cur} is group/world writable"
            if cur == "/":
                return None
            cur = os.path.dirname(cur)

    if not interpreter:
        return "the interpreter path is unknown"
    checks = [(os.path.realpath(p), False) for p in [script] + list(siblings) + [interpreter]]
    checks += [(os.path.realpath(p), True) for p in module_dirs if p and os.path.isdir(p)]
    for path, want_dir in checks:
        why = problem(path, want_dir)
        if why:
            return why
    return None


def _require_trusted_install(script, siblings, force=False):
    """Root (or a process that can regain root) runs only root-owned code; unprivileged
    runs are unaffected unless `force` (verify-install)."""
    if not force and os.geteuid() != 0 and os.getresuid()[2] != 0:
        return
    if not (sys.flags.isolated and sys.flags.no_site):
        raise SystemExit("refusing to run with root privileges: start it as `/usr/bin/python3 -I -S <installed script>`")
    why = _install_problem(script, siblings, sys.executable, sys.path)
    if why:
        raise SystemExit(f"refusing to run with root privileges from an untrusted location: {why}. "
                         "Install root-owned copies (docs/CARGO_CACHE_RETENTION.md, privileged installation)")


_require_trusted_install(__file__, [os.path.join(os.path.dirname(os.path.realpath(__file__)),
                                                 "emuwiz-cargo-retention")])

import argparse
import errno
import hashlib
import importlib.machinery
import importlib.util
import json
import signal
import time

CARGO_LOCK_NAMES = (".cargo-lock", ".cargo-build-lock", ".cargo-artifact-lock")
_hook = None  # test seam: called with a stage name; may mutate the filesystem


def load_foundation():
    path = os.path.join(os.path.dirname(os.path.realpath(__file__)), "emuwiz-cargo-retention")
    # Never write bytecode next to the scripts: a retirement tool must not add
    # files to the repository tree it runs from.
    sys.dont_write_bytecode = True
    loader = importlib.machinery.SourceFileLoader("emuwiz_cargo_retention", path)
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


F = load_foundation()


class Refusal(Exception):
    def __init__(self, code, detail=""):
        super().__init__(f"{code}: {detail}" if detail else code)
        self.code = code
        self.detail = detail


def hook(stage):
    if _hook is not None:
        _hook(stage)


def sha256_file(path):
    digest = hashlib.sha256()
    with open(path, "rb") as handle:
        for block in iter(lambda: handle.read(1 << 20), b""):
            digest.update(block)
    return digest.hexdigest()


def real_now():
    return time.time()


def parse_iso(text):
    from datetime import datetime
    try:
        return datetime.fromisoformat(text).timestamp()
    except (TypeError, ValueError):
        return None


# ------------------------------------------------- durable execution journal

SNAPSHOT_LIMIT = 1_000_000
JOURNAL_MAX_PATHS = 20_000
JOURNAL_SUFFIX = ".journal.jsonl"


class JournalError(Exception):
    """Progress evidence could not be published; mutation must stop."""


class Interrupted(BaseException):
    """SIGTERM/SIGHUP during execution: unwound like KeyboardInterrupt."""


def fsync_dir(path):
    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


class Journal:
    """Append-only, fsynced JSON-lines record of one execution, kept outside every
    cache.  Records per run: begin, one group_plan per group, then per manifest
    entry an `intent` (before its first unlink) and an `outcome`, finally `end`.
    Size is O(manifest entries); nothing is written per deleted file."""

    def __init__(self, path, fd):
        self.path = path
        self.fd = fd
        self.seq = 0

    @classmethod
    def create(cls, directory, exec_id):
        os.makedirs(directory, mode=0o700, exist_ok=True)
        path = os.path.join(directory, f"retire-{exec_id}{JOURNAL_SUFFIX}")
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_APPEND | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
        try:
            fsync_dir(directory)
        except BaseException:
            os.close(fd)
            raise
        return cls(path, fd)

    def write(self, record):
        self.seq += 1
        line = (json.dumps(dict(record, seq=self.seq, t=time.time()), sort_keys=True) + "\n").encode()
        view = memoryview(line)
        while view:
            n = os.write(self.fd, view)
            view = view[n:]
        os.fsync(self.fd)

    def close(self):
        try:
            os.close(self.fd)
        except OSError:
            pass


def read_journal(path):
    """(records, torn) - a torn final line (killed mid-write) is reported, not trusted."""
    records, torn = [], False
    with open(path, "rb") as handle:
        for raw in handle.read().split(b"\n"):
            if not raw:
                continue
            try:
                value = json.loads(raw)
            except ValueError:
                torn = True
                continue
            if isinstance(value, dict):
                records.append(value)
            else:
                torn = True
    return records, torn


def incomplete_journals(directory):
    found = []
    try:
        names = sorted(os.listdir(directory))
    except FileNotFoundError:
        return found
    for name in names:
        if not name.endswith(JOURNAL_SUFFIX):
            continue
        path = os.path.join(directory, name)
        try:
            records, torn = read_journal(path)
        except OSError:
            found.append(path)
            continue
        if torn or not any(r.get("event") == "end" for r in records):
            found.append(path)
    return found


def protected_name(name):
    """Journals, databases, saves, ROM-like data and Cargo-adjacent evidence."""
    lower = name.lower()
    return lower.endswith(F.DATA_SUFFIXES) or "journal" in lower or name in F.ALWAYS_PRESERVE


def snapshot_tree(path):
    """key (relative path below `path`, '/'-joined) -> (dev, ino), and counts."""
    snap = {}
    files = dirs = 0
    stack = [("", path)]
    while stack:
        key, directory = stack.pop()
        with os.scandir(directory) as it:
            for entry in it:
                st = entry.stat(follow_symlinks=False)
                child = key + "/" + entry.name
                snap[child] = (st.st_dev, st.st_ino)
                if len(snap) > SNAPSHOT_LIMIT:
                    raise Refusal("SNAPSHOT_TOO_LARGE", path)
                if stat.S_ISDIR(st.st_mode):
                    dirs += 1
                    stack.append((child, entry.path))
                else:
                    files += 1
    return snap, files, dirs


# ------------------------------------------------------- descriptor-bound I/O


def open_dir_nofollow(path):
    """Open an absolute directory with every component opened O_NOFOLLOW."""
    if not os.path.isabs(path) or os.path.normpath(path) != path:
        raise Refusal("PATH_NOT_CANONICAL", path)
    fd = os.open("/", os.O_RDONLY | os.O_DIRECTORY)
    try:
        for part in [p for p in path.split("/") if p]:
            try:
                nxt = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd)
            except OSError as error:
                raise Refusal("SYMLINK_OR_MISSING_COMPONENT", f"{part}: {error.strerror}") from error
            os.close(fd)
            fd = nxt
        return fd
    except BaseException:
        os.close(fd)
        raise


def lstat_at(name, dir_fd):
    return os.stat(name, dir_fd=dir_fd, follow_symlinks=False)


class Counters:
    def __init__(self):
        self.freed = 0
        self.retained = 0
        self.files = 0
        self.dirs = 0


def guard_entry(name, st, snap, key):
    """Deletion-time classification, applied immediately before each unlink."""
    if protected_name(name):
        raise Refusal("PROTECTED_FILE", name)
    if snap is not None and snap.get(key) != (st.st_dev, st.st_ino):
        raise Refusal("NOT_IN_PLANNED_SNAPSHOT", name)


def remove_entry(dir_fd, name, expect, root_dev, counters, top=True, snap=None, key=""):
    """Remove `name` below dir_fd without following links; refuse anything odd.

    `counters` is updated after every successful removal, so a refusal part-way
    leaves an exact account of what was already removed."""
    try:
        st = lstat_at(name, dir_fd)
    except FileNotFoundError:
        raise Refusal("ALREADY_ABSENT", name)
    if top and expect is not None:
        if (st.st_dev, st.st_ino, st.st_mode) != expect:
            raise Refusal("PATH_IDENTITY_MISMATCH", name)
    if st.st_dev != root_dev:
        raise Refusal("CROSSES_FILESYSTEM", name)
    if stat.S_ISLNK(st.st_mode):
        raise Refusal("SYMLINK_FOUND", name)
    if not top:
        guard_entry(name, st, snap, key)
    if stat.S_ISDIR(st.st_mode):
        flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
        try:
            fd = os.open(name, flags, dir_fd=dir_fd)
        except OSError as error:
            raise Refusal("OPEN_FAILED", f"{name}: {error.strerror}") from error
        try:
            fst = os.fstat(fd)
            if (fst.st_dev, fst.st_ino) != (st.st_dev, st.st_ino):
                raise Refusal("PATH_IDENTITY_MISMATCH", f"{name} rebound while opening")
            children = os.listdir(fd)
            # Validate every child before removing any of them, so a late symlink,
            # protected file or unknown entry stops this directory untouched.
            for child in children:
                try:
                    cst = lstat_at(child, fd)
                except FileNotFoundError:
                    continue
                if cst.st_dev != root_dev:
                    raise Refusal("CROSSES_FILESYSTEM", child)
                if stat.S_ISLNK(cst.st_mode):
                    raise Refusal("SYMLINK_FOUND", child)
                guard_entry(child, cst, snap, key + "/" + child)
                if not (stat.S_ISDIR(cst.st_mode) or stat.S_ISREG(cst.st_mode)):
                    raise Refusal("SPECIAL_FILE", child)
            for child in children:
                remove_entry(fd, child, None, root_dev, counters, False, snap, key + "/" + child)
        finally:
            os.close(fd)
        hook("before-rmdir:" + name)
        os.rmdir(name, dir_fd=dir_fd)
        counters.dirs += 1
        return
    if not stat.S_ISREG(st.st_mode):
        raise Refusal("SPECIAL_FILE", name)
    hook("before-unlink:" + name)
    # the file was classified a moment ago; re-establish that it is still the same
    # inode immediately before the unlink
    again = lstat_at(name, dir_fd)
    if (again.st_dev, again.st_ino, again.st_mode) != (st.st_dev, st.st_ino, st.st_mode):
        raise Refusal("PATH_IDENTITY_MISMATCH", f"{name} changed before unlink")
    os.unlink(name, dir_fd=dir_fd)
    if st.st_nlink == 1:
        counters.freed += st.st_blocks * 512
    else:
        counters.retained += st.st_blocks * 512  # other links keep the blocks
    counters.files += 1


# -------------------------------------------------------------- evaluation


def entry_class_problem(rel_parts, parent_path):
    """Why a manifest path is not an enumerated compiler artifact, else None."""
    if not rel_parts or any(p in ("", ".", "..") for p in rel_parts):
        return "PATH_OUTSIDE_TARGET"
    name = rel_parts[-1]
    if name in CARGO_LOCK_NAMES:
        return "CARGO_INTERNAL_LOCK_FILE"
    if len(rel_parts) == 1:
        return None if name in F.TOP_META_FILES else "NOT_A_COMPILER_ARTIFACT"
    if len(rel_parts) > 3 or any(p in F.ALWAYS_PRESERVE for p in rel_parts):
        return "NOT_A_COMPILER_ARTIFACT"
    profile = parent_path
    has_marker = any(
        os.path.isdir(os.path.join(profile, marker)) and not os.path.islink(os.path.join(profile, marker))
        for marker in (".fingerprint", "deps")
    )
    if not has_marker:
        return "NOT_A_COMPILER_ARTIFACT"
    if name in F.ARTIFACT_DIRS:
        return None
    if name.endswith(F.ARTIFACT_FILE_SUFFIXES):
        return None
    full = os.path.join(profile, name)
    try:
        st = os.lstat(full)
    except OSError:
        return None  # absence is handled by the identity check
    if stat.S_ISREG(st.st_mode) and st.st_mode & 0o111 and os.path.exists(full + ".d"):
        return None
    return "NOT_A_COMPILER_ARTIFACT"


def path_has_symlink_component(path):
    cur = "/"
    for part in [p for p in path.split("/") if p]:
        cur = os.path.join(cur, part)
        try:
            if stat.S_ISLNK(os.lstat(cur).st_mode):
                return True
        except OSError:
            return False
    return False


def load_manifest(path, approved):
    actual = sha256_file(path)
    if approved is None or actual != approved.lower():
        raise Refusal("MANIFEST_DIGEST_MISMATCH", f"manifest is {actual}, approved {approved}")
    with open(path) as handle:
        data = json.load(handle)
    groups = []
    for group in data.get("cargo_artifact_groups", []):
        paths = json.loads(group.get("deletion_paths_json") or "[]")
        sources = json.loads(group.get("associated_source_paths") or "[]")
        groups.append({"group": group, "paths": paths, "sources": sources})
    return data, actual, groups


def verified_owner(group, record, source_paths, target):
    """Adoption is only a claim; this is the evidence that makes it count."""
    if not record or not record.get("owner"):
        return "NOT_ADOPTED", "no lifecycle record with an owner"
    if not group.get("source_exists") or not source_paths:
        return "SOURCE_MISSING", "the owning source checkout is not present to verify"
    name = os.path.basename(target)
    recorded = os.path.realpath(record["worktree"]) if record.get("worktree") else None
    matched = False
    for src in source_paths:
        real = os.path.realpath(src)
        if not os.path.isdir(real):
            return "SOURCE_MISSING", real
        head = F.head_of(real)
        if group.get("source_head") and head != group["source_head"]:
            return "OWNER_UNVERIFIED", f"source HEAD {head} differs from the manifest's {group['source_head']}"
        digest = hashlib.sha256(real.encode()).hexdigest()[:12]
        if name.endswith("-" + digest) or recorded == real:
            matched = True
    if not matched:
        return "OWNER_UNVERIFIED", "neither the target's path hash nor the recorded worktree matches the source"
    return None, ""


def evaluate_group(entry, registry, args, census, now_ts, execute, own_lock=False):
    """Group-level holds (read-only). Returns (holds, context)."""
    group, paths, sources = entry["group"], entry["paths"], entry["sources"]
    target = group["directory"]
    holds = []
    ctx = {"target": target, "key": None, "record": None}

    def hold(code, detail=""):
        holds.append({"code": code, "detail": detail})

    if not os.path.isabs(target) or os.path.normpath(target) != target:
        hold("TARGET_PATH_NOT_CANONICAL", target)
        return holds, ctx
    if path_has_symlink_component(target):
        hold("TARGET_PATH_HAS_SYMLINK", target)
        return holds, ctx
    try:
        st = os.lstat(target)
    except OSError as error:
        hold("TARGET_NOT_FOUND", error.strerror or "")
        return holds, ctx
    if not stat.S_ISDIR(st.st_mode):
        hold("TARGET_NOT_A_DIRECTORY")
        return holds, ctx
    if (st.st_dev, st.st_ino) != (group.get("device"), group.get("inode")):
        hold("DIRECTORY_IDENTITY_CHANGED", f"now {st.st_dev}:{st.st_ino}")
    key = F.key_for(target)
    ctx["key"] = key
    rec_state, record = registry.read_checked("targets", key, F.valid_target_record)
    if rec_state == "invalid":
        hold("REGISTRY_RECORD_INVALID", "the lifecycle record is unreadable or malformed; treated as unknown")
        record = None
    ctx["record"] = record
    if not record and rec_state == "absent" and args.assume_adopted and not execute:
        record = {"owner": "ASSUMED-FOR-DRY-RUN", "adopted_at": now_ts, "worktree": sources[0] if sources else None}
        ctx["record"] = record
        ctx["assumed"] = True
    problem, detail = verified_owner(group, record, sources, target)
    if problem:
        hold(problem, detail)
    if record and record.get("identity"):
        ident = record["identity"]
        if (ident.get("dev"), ident.get("ino")) != (st.st_dev, st.st_ino):
            hold("DIRECTORY_IDENTITY_CHANGED", "differs from the identity recorded at first build/adoption")
    pin_state, pins = registry.pin_state(key)
    if pin_state == "invalid":
        hold("PIN_STATE_UNKNOWN", "the pin record is unreadable or malformed; a corrupt pin is never 'no pin'")
    elif pins:
        hold("PINNED", ",".join(sorted({p["reason"] for p in pins})))
    locked = False if own_lock else registry.probe_lock(key)
    if locked:
        hold("BUILD_LOCK_HELD")
    elif locked is None:
        hold("LOCK_STATE_UNKNOWN", "the lifecycle lock could not be probed")
    if record:
        live = [e for e in record.get("active", [])
                if e.get("boot_id") == F.boot_id() and F.proc_starttime(e.get("pid")) == e.get("starttime")]
        if live:
            hold("RECORDED_BUILD_ALIVE", f"{len(live)} build(s)")
    refs = census.refs.get(os.path.realpath(target), []) if census else []
    if refs:
        hold("LIVE_PROCESS_REFERENCE", ", ".join(f"{r['comm']}[{r['pid']}] {r['kind']}" for r in refs[:5]))
    for src in sources:
        real = os.path.realpath(src)
        srefs = census.refs.get(real, []) if census else []
        if srefs:
            hold("LIVE_PROCESS_IN_SOURCE", ", ".join(f"{r['comm']}[{r['pid']}] {r['kind']}" for r in srefs[:5]))
    if census is None or census.unreadable_foreign:
        hold("INCOMPLETE_PROCESS_VISIBILITY",
             f"{census.unreadable_foreign if census else '?'} process(es) of other users are not inspectable")
    # activity
    seen = set()
    m = F.measure_tree(target, seen)
    ctx["measured"] = m
    activity = [v for v in ((record or {}).get("last_use"), (record or {}).get("last_end"), m["newest_mtime"] or None) if v]
    newest = max(activity) if activity else None
    if newest is None:
        hold("UNKNOWN_ACTIVITY")
    elif now_ts - newest < max(F.MIN_IDLE_HOURS, args.min_idle_hours) * 3600:
        hold("RECENT_ACTIVITY", f"{(now_ts - newest) / 3600:.1f} h ago")
    approved_mtime = parse_iso(group.get("latest_mtime_utc"))
    if approved_mtime is not None and m["newest_mtime"] and m["newest_mtime"] > approved_mtime + 1:
        hold("ACTIVITY_SINCE_MANIFEST", "files were written after the manifest was made")
    if m["cross_device"]:
        hold("CONTAINS_MOUNT_POINT")
    participating = bool(record and record.get("last_start"))
    ctx["participating"] = participating
    if not participating and not args.maintenance_window_attested:
        hold("NONPARTICIPATING_WRITERS_NOT_EXCLUDED",
             "no cargo-iso build was ever recorded here; plain cargo is not locked - needs an attested maintenance window")
    return holds, ctx


def evaluate_entry(entry_path, group, dev_expect):
    """Per-path checks, read-only. Returns (reason or None, normalized parts)."""
    target = group["directory"]
    norm = os.path.normpath(entry_path["path"])
    if norm != entry_path["path"] or not (norm + "/").startswith(target + "/") or norm == target:
        return "PATH_OUTSIDE_TARGET", None
    rel = os.path.relpath(norm, target).split("/")
    parent = os.path.dirname(norm)
    if path_has_symlink_component(parent):
        return "SYMLINK_COMPONENT", rel
    reason = entry_class_problem(rel, parent)
    if reason:
        return reason, rel
    try:
        st = os.lstat(norm)
    except FileNotFoundError:
        return "ALREADY_ABSENT", rel
    except OSError:
        return "UNREADABLE", rel
    if (st.st_dev, st.st_ino, st.st_mode) != dev_expect:
        return "PATH_IDENTITY_MISMATCH", rel
    if stat.S_ISLNK(st.st_mode):
        return "SYMLINK", rel
    if stat.S_ISDIR(st.st_mode):
        problem = F.subtree_problem(norm, st.st_dev)
        if problem:
            return "SUBTREE_REFUSED: " + problem, rel
    elif not stat.S_ISREG(st.st_mode):
        return "SPECIAL_FILE", rel
    elif rel[-1].lower().endswith(F.DATA_SUFFIXES):
        return "SUBTREE_REFUSED: looks like data", rel
    return None, rel


# ------------------------------------------------------------------- run


def run(args):
    execute = args.execute
    if execute:
        if args.assume_adopted:
            raise SystemExit("--assume-adopted is for dry runs only")
        if os.environ.get("EMUWIZ_RETENTION_NOW"):
            raise SystemExit("--execute refuses EMUWIZ_RETENTION_NOW: it needs real time")
        if not args.receipt_dir:
            raise SystemExit("--execute requires --receipt-dir (outside every cache)")
        if args.min_idle_hours < F.MIN_IDLE_HOURS:
            raise SystemExit(f"--min-idle-hours cannot go below {F.MIN_IDLE_HOURS} when executing")
    now_ts = real_now()
    receipt = {
        "mode": "EXECUTE" if execute else "DRY RUN (nothing deleted)",
        "started": now_ts,
        "manifest": os.path.realpath(args.manifest),
        "approved_sha256": args.approved_sha256,
        "host": os.uname().nodename,
        "policy": {
            "min_idle_hours": max(F.MIN_IDLE_HOURS, args.min_idle_hours),
            "visibility": "complete required",
            "maintenance_window_attested": bool(args.maintenance_window_attested),
            "assume_adopted": bool(args.assume_adopted),
        },
        "groups": [],
        "totals": {},
    }
    try:
        data, digest, groups = load_manifest(args.manifest, args.approved_sha256)
    except Refusal as refusal:
        receipt["refused"] = {"code": refusal.code, "detail": refusal.detail}
        finish(args, receipt)
        return 3
    receipt["manifest_sha256"] = digest
    directories = [os.path.realpath(g["group"]["directory"]) for g in groups]
    sources = [os.path.realpath(s) for g in groups for s in g["sources"]]
    journal = None
    if execute:
        refusal = prepare_execution(args, groups, directories, sources)
        if refusal is not None:
            receipt["refused"] = refusal
            finish(args, receipt)
            return refusal.get("rc", 4)
        exec_id = time.strftime("%Y%m%dT%H%M%S") + f"-{time.time_ns() % 10**9:09d}-{os.getpid()}"
        try:
            journal = Journal.create(args.receipt_dir, exec_id)
            journal.write({
                "event": "begin", "exec_id": exec_id, "manifest": receipt["manifest"],
                "manifest_sha256": digest, "approved_sha256": args.approved_sha256,
                "host": receipt["host"], "pid": os.getpid(), "policy": receipt["policy"],
                "acknowledged_incomplete": sorted(incomplete_journals(args.receipt_dir)),
            })
            for entry in groups:
                g = entry["group"]
                journal.write({
                    "event": "group_plan", "directory": g["directory"],
                    "device": g.get("device"), "inode": g.get("inode"),
                    "paths": [{"path": i["path"], "device": i.get("device"),
                               "inode": i.get("inode"), "mode": i.get("mode")} for i in entry["paths"]],
                })
        except OSError as error:
            # Progress evidence cannot be published: begin no mutation at all.
            if journal is not None:
                journal.close()
            receipt["refused"] = {"code": "JOURNAL_UNAVAILABLE",
                                  "detail": f"{error.strerror or error}; nothing was changed"}
            finish(args, receipt)
            return 4
        receipt["journal_file"] = journal.path
        for sig in (signal.SIGTERM, signal.SIGHUP):
            signal.signal(sig, _raise_interrupted)
    registry = F.Registry(create=execute)
    census = F.Census(directories + sources)
    receipt["process_census"] = {"examined": census.examined, "unreadable_foreign": census.unreadable_foreign}
    total_selected = total_held = total_partial = 0
    freed_all = retained_all = 0
    status = 0
    try:
        for entry in groups:
            if any(r.get("outcome") == "ABORTED" for r in receipt["groups"]):
                receipt["groups"].append({
                    "directory": entry["group"]["directory"], "outcome": "NOT_STARTED_RUN_ABORTED", "holds": [],
                    "paths": [{"path": i["path"], "outcome": "UNTOUCHED", "reason": "RUN_ABORTED"} for i in entry["paths"]],
                    "paths_selected": 0, "paths_held": 0, "paths_partial": 0, "estimated_recoverable_bytes": 0,
                    "paths_individually_eligible": 0, "accounted_freed_bytes": 0, "retained_hardlink_bytes": 0,
                })
                continue
            result = process_group(entry, registry, args, census, now_ts, execute, journal)
            receipt["groups"].append(result)
            total_selected += result["paths_selected"]
            total_held += result["paths_held"]
            total_partial += result.get("paths_partial", 0)
            freed_all += result["accounted_freed_bytes"]
            retained_all += result["retained_hardlink_bytes"]
    except (KeyboardInterrupt, Interrupted) as error:
        partial = getattr(error, "partial_group", None)
        if partial is not None:
            receipt["groups"].append(partial)
            total_selected += partial["paths_selected"]
            total_held += partial["paths_held"]
            total_partial += partial.get("paths_partial", 0)
            freed_all += partial["accounted_freed_bytes"]
            retained_all += partial["retained_hardlink_bytes"]
        status = 130 if isinstance(error, KeyboardInterrupt) else 143
        receipt["interrupted"] = type(error).__name__
        receipt["mode"] = "EXECUTE (INTERRUPTED: progress is in the journal; run --inspect-journal)"
        if journal is not None:
            try:
                journal.write({"event": "interrupted", "kind": type(error).__name__})
            except OSError:
                pass
    if any(r.get("outcome") == "ABORTED" for r in receipt["groups"]) and status == 0:
        status = 7
    receipt["totals"] = {
        "paths_in_manifest": sum(len(g["paths"]) for g in groups),
        "paths_selected": total_selected,
        "paths_held": total_held,
        "paths_partial": total_partial,
        "paths_individually_eligible": sum(g["paths_individually_eligible"] for g in receipt["groups"]),
        "estimated_recoverable_if_group_gates_pass": sum(g["estimated_recoverable_bytes"] for g in receipt["groups"]),
        "accounted_freed_bytes": freed_all,
        "retained_hardlink_bytes": retained_all,
    }
    receipt["finished"] = real_now()
    if journal is not None and not receipt.get("interrupted"):
        try:
            journal.write({"event": "end", "totals": receipt["totals"], "status": status})
        except OSError:
            status = status or 7  # no `end`: the journal stays "incomplete" on purpose
    try:
        finish(args, receipt)
    except OSError as error:
        # The journal already holds the full account; say so and fail loudly.
        print(f"emuwiz-cargo-retire: receipt could not be published ({error.strerror or error}); "
              f"the execution journal is complete: {journal.path if journal else '-'}", file=sys.stderr)
        if journal is not None:
            try:
                journal.write({"event": "receipt_publication_failed", "error": str(error)})
            except OSError:
                pass
        status = status or 5
    if journal is not None:
        journal.close()
    return status


def _raise_interrupted(signum, frame):
    raise Interrupted(signum)


def prepare_execution(args, groups, directories, sources):
    """Checks that must hold before the journal is created; a refusal dict or None."""
    receipt_dir = os.path.realpath(args.receipt_dir)
    for root in directories + sources:
        if receipt_dir == root or receipt_dir.startswith(root + os.sep):
            return {"code": "RECEIPT_DIR_INSIDE_CACHE", "detail": f"{receipt_dir} is inside {root}", "rc": 4}
    try:
        os.makedirs(args.receipt_dir, mode=0o700, exist_ok=True)
        rst = os.lstat(args.receipt_dir)
    except OSError as error:
        return {"code": "RECEIPT_DIR_UNSAFE", "detail": f"{args.receipt_dir}: {error.strerror or error}", "rc": 4}
    if not stat.S_ISDIR(rst.st_mode) or rst.st_uid != os.geteuid() or rst.st_mode & 0o022:
        return {"code": "RECEIPT_DIR_UNSAFE", "rc": 4,
                "detail": f"{args.receipt_dir} must be a real directory owned by uid {os.geteuid()}, not group/world writable"}
    if sum(len(g["paths"]) for g in groups) > JOURNAL_MAX_PATHS:
        return {"code": "MANIFEST_TOO_LARGE_FOR_JOURNAL",
                "detail": f"more than {JOURNAL_MAX_PATHS} paths; split the manifest", "rc": 4}
    pending = incomplete_journals(args.receipt_dir)
    if pending and not args.acknowledge_incomplete_journals:
        return {"code": "INCOMPLETE_JOURNAL_PRESENT",
                "detail": "an earlier execution did not finish; inspect with --inspect-journal and re-run with "
                          "--acknowledge-incomplete-journals: " + ", ".join(pending), "rc": 6}
    return None


def inspect_journal(path):
    """Classify every planned entry from the journal and the current filesystem.

    KNOWN_COMPLETED / KNOWN_PARTIAL / KNOWN_UNTOUCHED come from recorded outcomes,
    or (untouched only) from an unchanged identity with an unchanged content count.  A missing pathname
    without a recorded outcome is UNCERTAIN: absence alone is never proof of a
    completed deletion."""
    records, torn = read_journal(path)
    begin = next((r for r in records if r.get("event") == "begin"), None)
    plans = [r for r in records if r.get("event") == "group_plan"]
    intents = {r["path"]: r for r in records if r.get("event") == "intent"}
    outcomes = {r["path"]: r for r in records if r.get("event") == "outcome"}
    entries = []
    for plan in plans:
        for item in plan.get("paths", []):
            p = item["path"]
            row = {"path": p, "directory": plan["directory"]}
            if p in outcomes:
                o = outcomes[p]
                row.update(files=o.get("files"), dirs=o.get("dirs"), recorded_outcome=o.get("outcome"))
                if o.get("outcome") == "REMOVED":
                    row["state"] = "KNOWN_COMPLETED"
                elif o.get("outcome") == "PARTIAL" or (o.get("files") or o.get("dirs")):
                    row["state"] = "KNOWN_PARTIAL"
                elif o.get("interrupted"):
                    row["state"] = "UNCERTAIN_INTERRUPTED"
                else:
                    row["state"] = "KNOWN_UNTOUCHED"
            elif p in intents:
                row.update(classify_after_intent(intents[p]))
            else:
                row["state"] = "KNOWN_UNTOUCHED"
                row["why"] = "no intent was recorded, so no unlink was ever started"
            entries.append(row)
    summary = {}
    for row in entries:
        summary[row["state"]] = summary.get(row["state"], 0) + 1
    return {
        "journal": os.path.realpath(path),
        "complete": any(r.get("event") == "end" for r in records),
        "interrupted_record": any(r.get("event") == "interrupted" for r in records),
        "torn_final_record": torn,
        "exec_id": (begin or {}).get("exec_id"),
        "manifest_sha256": (begin or {}).get("manifest_sha256"),
        "summary": summary,
        "entries": entries,
    }


def classify_after_intent(intent):
    p = intent["path"]
    if path_has_symlink_component(os.path.dirname(p)):
        return {"state": "UNCERTAIN_SYMLINK_COMPONENT"}
    try:
        st = os.lstat(p)
    except FileNotFoundError:
        return {"state": "UNCERTAIN_ABSENT_UNCONFIRMED",
                "why": "path is gone but no outcome was recorded; completion is not assumed"}
    except OSError as error:
        return {"state": "UNCERTAIN_UNREADABLE", "why": str(error)}
    if (st.st_dev, st.st_ino, st.st_mode) != (intent.get("device"), intent.get("inode"), intent.get("mode")):
        return {"state": "UNCERTAIN_IDENTITY_CHANGED"}
    if not stat.S_ISDIR(st.st_mode):
        return {"state": "KNOWN_UNTOUCHED", "why": "same file identity still present"}
    try:
        _, files, dirs = snapshot_tree(p)
    except (OSError, Refusal) as error:
        return {"state": "UNCERTAIN_UNREADABLE", "why": str(error)}
    dirs += 1
    want_f, want_d = intent.get("files", 0), intent.get("dirs", 0)
    if (files, dirs) == (want_f, want_d):
        return {"state": "KNOWN_UNTOUCHED", "why": "same identity and unchanged content count"}
    if files <= want_f and dirs <= want_d:
        # Same inode number but fewer entries: removal began.  The extent cannot be
        # proven (an inode number can be reused), so this stays UNCERTAIN.
        return {"state": "UNCERTAIN_PARTIALLY_REMOVED", "files_remaining": files, "files_planned": want_f,
                "dirs_remaining": dirs, "dirs_planned": want_d}
    return {"state": "UNCERTAIN_CONTENT_CHANGED", "files_now": files, "files_planned": want_f}


def process_group(entry, registry, args, census, now_ts, execute, journal=None):
    group = entry["group"]
    target = group["directory"]
    out = {
        "directory": target, "key": None, "holds": [], "paths": [],
        "paths_selected": 0, "paths_held": 0, "estimated_recoverable_bytes": 0,
        "paths_individually_eligible": 0,
        "accounted_freed_bytes": 0, "retained_hardlink_bytes": 0, "outcome": "HELD",
        "paths_partial": 0, "files_removed": 0, "dirs_removed": 0,
    }
    lock_fd = None
    try:
        if execute:
            # Exclusive lifecycle lock BEFORE the final census: a wrapper-managed
            # build starting now blocks on it instead of racing the deletion.
            key = F.key_for(target)
            # never through a symlink, and only a regular lock file of this user: the
            # same file a cargo-iso build of this target can open
            try:
                lock_fd = F.open_lock_file(registry.lifecycle_lock_path(key), os.O_RDWR | os.O_CREAT)
            except OSError as error:
                out["holds"].append({"code": "LIFECYCLE_LOCK_UNAVAILABLE",
                                     "detail": f"the lifecycle lock cannot be used safely: {error.strerror or error}"})
                return hold_all(entry, out, "LIFECYCLE_LOCK_UNAVAILABLE")
            try:
                F.fcntl.flock(lock_fd, F.fcntl.LOCK_EX | F.fcntl.LOCK_NB)
            except OSError:
                os.close(lock_fd)
                lock_fd = None
                out["holds"].append({"code": "LIFECYCLE_LOCK_UNAVAILABLE", "detail": "a build holds the target"})
                return hold_all(entry, out, "LIFECYCLE_LOCK_UNAVAILABLE")
            # a fresh census once the lock is ours
            fresh = F.Census([os.path.realpath(target)] + [os.path.realpath(s) for s in entry["sources"]])
            census = fresh
        holds, ctx = evaluate_group(entry, registry, args, census, now_ts, execute, own_lock=lock_fd is not None)
        out["key"] = ctx.get("key")
        if ctx.get("assumed"):
            out["note"] = "ownership ASSUMED for this dry run; execution would hold on NOT_ADOPTED"
        out["holds"] = holds
        selected = []
        for item in entry["paths"]:
            expect = (item.get("device"), item.get("inode"), item.get("mode"))
            reason, rel = evaluate_entry(item, group, expect)
            if reason == "ALREADY_ABSENT":
                out["paths"].append({"path": item["path"], "outcome": "ABSENT", "reason": reason})
            elif reason:
                out["paths"].append({"path": item["path"], "outcome": "HELD", "reason": reason})
            elif holds:
                out["paths"].append({"path": item["path"], "outcome": "HELD", "reason": holds[0]["code"],
                                     "individually_eligible": True})
            else:
                out["paths"].append({"path": item["path"], "outcome": "SELECTED", "reason": ""})
            if not reason:
                selected.append((item, expect))
        if selected:
            est, retained = F.reclaim_estimate(
                [{"path": i["path"], "type": "dir" if stat.S_ISDIR(e[2]) else "file"} for i, e in selected]
            )
            out["estimated_recoverable_bytes"] = est
            out["retained_hardlink_bytes"] = retained
        out["paths_individually_eligible"] = len(selected)
        if execute and not holds:
            chosen = []
            by_path = {p["path"]: p for p in out["paths"]}
            for item, expect in selected:
                # the planned snapshot is taken under the exclusive lock, before any
                # unlink: anything that appears later is "not planned" and is refused
                try:
                    snap, nfiles, ndirs = (
                        snapshot_tree(item["path"]) if stat.S_ISDIR(expect[2]) else ({}, 1, 0)
                    )
                except (OSError, Refusal) as error:
                    by_path[item["path"]].update(outcome="HELD", reason="SNAPSHOT_FAILED", detail=str(error))
                    continue
                chosen.append((item, expect, snap, nfiles, ndirs + (1 if stat.S_ISDIR(expect[2]) else 0)))
            if chosen:
                execute_group(entry, chosen, out, journal)
        out["paths_selected"] = sum(1 for p in out["paths"] if p["outcome"] in ("SELECTED", "REMOVED"))
        out["paths_partial"] = sum(1 for p in out["paths"] if p["outcome"] == "PARTIAL")
        out["paths_would_be_eligible_if_group_gates_pass"] = out["paths_individually_eligible"]
        out["paths_held"] = sum(1 for p in out["paths"] if p["outcome"] in ("HELD", "REFUSED"))
        removed = any(p["outcome"] == "REMOVED" for p in out["paths"])
        if holds:
            out["outcome"] = "HELD"
        elif execute:
            if out.get("aborted"):
                out["outcome"] = "ABORTED"
            elif out["paths_partial"] or (removed and any(p["outcome"] == "REFUSED" for p in out["paths"])):
                out["outcome"] = "PARTIAL"
            else:
                out["outcome"] = "RETIRED" if removed else "NOTHING_REMOVED"
        else:
            out["outcome"] = "WOULD_RETIRE" if selected else "NOTHING_SELECTED"
        return out
    except BaseException as error:
        # keep what was accounted so far: an interrupted group is still reported
        out["outcome"] = "INTERRUPTED"
        out["paths_partial"] = sum(1 for p in out["paths"] if p["outcome"] == "PARTIAL")
        out["paths_selected"] = sum(1 for p in out["paths"] if p["outcome"] in ("SELECTED", "REMOVED"))
        out["paths_held"] = sum(1 for p in out["paths"] if p["outcome"] in ("HELD", "REFUSED"))
        error.partial_group = out
        raise
    finally:
        if lock_fd is not None:
            os.close(lock_fd)


def hold_all(entry, out, code):
    for item in entry["paths"]:
        out["paths"].append({"path": item["path"], "outcome": "HELD", "reason": code})
    out["paths_held"] = len(out["paths"])
    return out


def execute_group(entry, selected, out, journal):
    group = entry["group"]
    target = group["directory"]
    counters = Counters()
    by_path = {p["path"]: p for p in out["paths"]}

    def refuse_all(code, detail):
        out["holds"].append({"code": code, "detail": detail})
        for p in out["paths"]:
            if p["outcome"] == "SELECTED":
                p.update(outcome="REFUSED", reason=code)

    try:
        root_fd = open_dir_nofollow(target)
    except Refusal as refusal:
        refuse_all(refusal.code, refusal.detail)
        return
    try:
        rst = os.fstat(root_fd)
        if (rst.st_dev, rst.st_ino) != (group.get("device"), group.get("inode")):
            refuse_all("DIRECTORY_IDENTITY_CHANGED", "after opening")
            return
        before = statvfs_free(target)
        hook("after-open-target")
        for index, (item, expect, snap, nfiles, ndirs) in enumerate(selected):
            record = by_path[item["path"]]
            rel = os.path.relpath(item["path"], target).split("/")
            hook("before-entry:" + item["path"])
            one = Counters()
            parent_fd = None
            started = False
            try:
                # walk the parent chain from the already-open, identity-checked root
                parent_fd = os.dup(root_fd)
                for part in rel[:-1]:
                    nxt = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=parent_fd)
                    os.close(parent_fd)
                    parent_fd = nxt
                # the open root must still be what the path names
                try:
                    now_st = os.lstat(target)
                except OSError:
                    raise Refusal("DIRECTORY_IDENTITY_CHANGED", "target path vanished")
                if (now_st.st_dev, now_st.st_ino) != (rst.st_dev, rst.st_ino):
                    raise Refusal("DIRECTORY_IDENTITY_CHANGED", "target path was rebound")
                # Durable intent BEFORE the first unlink of this entry.  If it cannot
                # be published nothing is removed and the run stops.
                if journal is not None:
                    try:
                        journal.write({"event": "intent", "path": item["path"], "device": expect[0],
                                       "inode": expect[1], "mode": expect[2],
                                       "files": nfiles, "dirs": ndirs})
                    except OSError as error:
                        raise JournalError(f"intent: {error.strerror or error}") from error
                started = True
                remove_entry(parent_fd, rel[-1], expect, rst.st_dev, one, snap=snap)
                outcome, reason, detail = "REMOVED", "", ""
            except Refusal as refusal:
                outcome, reason, detail = "REFUSED", refusal.code, refusal.detail
            except JournalError as error:
                record.update(outcome="REFUSED", reason="JOURNAL_WRITE_FAILED", detail=str(error))
                out["aborted"] = "JOURNAL_WRITE_FAILED"
                break
            except OSError as error:
                outcome, reason, detail = "REFUSED", "OS_ERROR", f"{error.strerror}"
            except BaseException as error:  # KeyboardInterrupt / Interrupted / crash
                progress = one.files + one.dirs
                record.update(outcome="PARTIAL" if progress else "INTERRUPTED", reason=type(error).__name__,
                              files=one.files, dirs=one.dirs, freed_bytes=one.freed)
                counters.freed += one.freed
                counters.retained += one.retained
                counters.files += one.files
                counters.dirs += one.dirs
                if journal is not None and started:
                    try:
                        journal.write({"event": "outcome", "path": item["path"], "outcome": record["outcome"],
                                       "reason": record["reason"], "files": one.files, "dirs": one.dirs,
                                       "freed": one.freed, "interrupted": True})
                    except OSError:
                        pass
                out["accounted_freed_bytes"] = counters.freed
                out["retained_hardlink_bytes"] = counters.retained
                out["files_removed"], out["dirs_removed"] = counters.files, counters.dirs
                raise
            finally:
                if parent_fd is not None:
                    os.close(parent_fd)
            progress = one.files + one.dirs
            if outcome == "REFUSED" and progress:
                outcome = "PARTIAL"  # some artifacts were removed before the refusal
            counters.freed += one.freed
            counters.retained += one.retained
            counters.files += one.files
            counters.dirs += one.dirs
            record.update(outcome=outcome, reason=reason, files=one.files, dirs=one.dirs,
                          freed_bytes=one.freed, retained_bytes=one.retained)
            if detail:
                record["detail"] = detail
            if journal is not None and started:
                try:
                    journal.write({"event": "outcome", "path": item["path"], "outcome": outcome,
                                   "reason": reason, "files": one.files, "dirs": one.dirs,
                                   "freed": one.freed, "retained": one.retained})
                except OSError as error:
                    # the unlink happened but could not be recorded: stop mutating
                    out["aborted"] = "JOURNAL_WRITE_FAILED"
                    record["journal_error"] = f"outcome not recorded: {error.strerror or error}"
                    break
        if out.get("aborted"):
            for p in out["paths"]:
                if p["outcome"] == "SELECTED":
                    p.update(outcome="HELD", reason="RUN_ABORTED_" + out["aborted"])
        after = statvfs_free(target)
        out["accounted_freed_bytes"] = counters.freed
        out["retained_hardlink_bytes"] = counters.retained
        out["files_removed"], out["dirs_removed"] = counters.files, counters.dirs
        out["filesystem_free_before"] = before
        out["filesystem_free_after"] = after
    finally:
        # always leave the group accounting current, including on interruption
        out["accounted_freed_bytes"] = counters.freed
        out["retained_hardlink_bytes"] = counters.retained
        out["files_removed"], out["dirs_removed"] = counters.files, counters.dirs
        os.close(root_fd)


def statvfs_free(path):
    try:
        v = os.statvfs(path)
        return v.f_bavail * v.f_frsize
    except OSError:
        return None


def finish(args, receipt):
    text = json.dumps(receipt, indent=1, sort_keys=True)
    # A receipt directory inside a cache is refused: never write the refusal there.
    inside = (receipt.get("refused") or {}).get("code") == "RECEIPT_DIR_INSIDE_CACHE"
    if args.receipt_dir and not inside:
        os.makedirs(args.receipt_dir, mode=0o700, exist_ok=True)
        name = "retire-%s-%s.json" % ("execute" if args.execute else "dryrun", time.strftime("%Y%m%dT%H%M%S"))
        F.atomic_write(os.path.join(args.receipt_dir, name), receipt)
        fsync_dir(args.receipt_dir)
        receipt["receipt_file"] = os.path.join(args.receipt_dir, name)
    if args.json:
        print(json.dumps(receipt, indent=1, sort_keys=True))
        return
    t = receipt.get("totals", {})
    print(receipt["mode"])
    if receipt.get("refused"):
        print(f"REFUSED: {receipt['refused']['code']}: {receipt['refused']['detail']}")
        return
    print(f"  manifest sha256 {receipt['manifest_sha256']}")
    print(f"  census: {receipt['process_census']['examined']} processes examined; "
          f"{receipt['process_census']['unreadable_foreign']} of other users not inspectable")
    for g in receipt["groups"]:
        codes = sorted({h['code'] for h in g["holds"]})
        print(f"  {g['outcome']:<14} {os.path.basename(g['directory'])}: "
              f"{g['paths_selected']} selected, {g['paths_held']} held"
              + (f"  [{','.join(codes)}]" if codes else "")
              + (f"  ~{g['estimated_recoverable_bytes'] / 1e9:.2f} GB" if g["estimated_recoverable_bytes"] else ""))
    print(f"  paths: {t.get('paths_selected', 0)} selected, {t.get('paths_held', 0)} held of {t.get('paths_in_manifest', 0)}")
    print(f"  individually eligible paths (if every cache-level gate passed): "
          f"{t.get('paths_individually_eligible', 0)}, about "
          f"{t.get('estimated_recoverable_if_group_gates_pass', 0) / 1e9:.2f} GB")
    print(f"  actually freed (accounted) {t.get('accounted_freed_bytes', 0) / 1e9:.2f} GB")
    if receipt.get("receipt_file"):
        print(f"  receipt: {receipt['receipt_file']}")


def enter_privileged(as_user):
    """Started as root: become the owner for every file operation (see the foundation's
    drop_to_owner).  Started unprivileged: --as-user, if given, must name this user."""
    if os.geteuid() != 0:
        if as_user is not None:
            import pwd
            if pwd.getpwuid(os.geteuid()).pw_name != as_user:
                raise SystemExit(f"--as-user {as_user}: only root can act for another user")
        return
    if not as_user:
        raise SystemExit("running as root requires --as-user OWNER (the account that owns the caches and registry)")
    if os.environ.get("EMUWIZ_RETENTION_NOW"):
        raise SystemExit("a privileged run refuses EMUWIZ_RETENTION_NOW: it needs real time")
    pw = F.drop_to_owner(as_user)
    F.require_owned_dirs(pw.pw_uid, [F.registry_dir()])


def main(argv=None):
    p = argparse.ArgumentParser(prog="emuwiz-cargo-retire", description=__doc__.split("\n\n")[0])
    p.add_argument("--manifest")
    p.add_argument("--approved-sha256", help="digest of the manifest you approved")
    p.add_argument("--inspect-journal", metavar="FILE",
                   help="read-only: classify an execution journal against the filesystem and exit")
    p.add_argument("--acknowledge-incomplete-journals", action="store_true",
                   help="allow --execute although earlier incomplete journals exist (they are kept)")
    p.add_argument("--execute", action="store_true", help="actually delete (default is a dry run)")
    p.add_argument("--receipt-dir", help="where the receipt JSON goes (required with --execute)")
    p.add_argument("--maintenance-window-attested", action="store_true",
                   help="you attest no non-cargo-iso build can write these targets right now")
    p.add_argument("--assume-adopted", action="store_true",
                   help="DRY RUN ONLY: pretend verified ownership exists, to size the remaining holds")
    p.add_argument("--min-idle-hours", type=float, default=F.MIN_IDLE_HOURS)
    p.add_argument("--json", action="store_true")
    p.add_argument("--as-user", metavar="OWNER",
                   help="required when started as root: do all file work as OWNER (root is kept only for the process census)")
    args = p.parse_args(argv)
    enter_privileged(args.as_user)
    if args.inspect_journal:
        print(json.dumps(inspect_journal(args.inspect_journal), indent=1, sort_keys=True))
        return 0
    if not args.manifest or not args.approved_sha256:
        p.error("--manifest and --approved-sha256 are required")
    return run(args)


if __name__ == "__main__":
    sys.exit(main())

#!/usr/bin/env python3
"""emuwiz-cargo-maintain: policy-driven Cargo cache maintenance (phase 3).

Orchestrates the existing, independently accepted pieces; it contains no deletion
engine of its own:

  * scripts/emuwiz-cargo-retention  inventory, lifecycle states, pins, census;
  * scripts/emuwiz-cargo-retire     the only code that deletes (manifest-bound,
                                    descriptor-bound, journalled, truthful).

A cycle inventories the registered Cargo targets, measures allocated storage,
compares it with the soft/hard budgets and, ONLY when an owner-approved and
explicitly enabled policy allows it, builds an exact manifest of the compiler
artifacts of RETIRABLE targets (oldest first) and hands it to the executor.

Commands
  status [--json]            states, budgets, protected vs eligible, last cleanup
  plan [--json] [--output F] [--only NAME ...]
                             dry run: what a cycle would select (never deletes); --only plans
                             exactly the named targets or refuses the whole request
  run [--dry-run] [--only NAME ...]
                             one maintenance cycle (deletes only when the policy
                             is approved AND enabled AND privileges are complete)
  policy show                the persistent policy and its integrity state
  policy approve ...         record an owner-approved, bounded policy (disabled)
  policy enable | disable    explicit switch; the default is DISABLED
  history                    cleanup history and reclaimed space
  task-complete              release this worktree's cache (idempotent), then report
                             whether the worktree may be removed (explicit invocation)
  worktree-check PATH        CLEAR/HOLD gate: remove a worktree only on CLEAR
  worktree-reconcile PATH    explicit independent checkout gate for an absent
                             legacy target; history stays UNKNOWN; --remove uses Git
  admit --target DIR         admission check used by cargo-iso for cold targets
  units                      print the systemd service/timer units for the root-owned
                             installed copy (installs and enables nothing)
  verify-install             check that this copy may run with root privileges

Started as root (the systemd unit), `--as-user OWNER` is required: the program first
verifies that all code it loads is root-owned, then does every file operation as
OWNER and uses root only for the process census.

A generated manifest's hash is never the authorisation: the persistent policy is.
"""
import os
import stat
import sys

# ---------------------------------------------------------------- trust gate
# Runs before ANY other import of this script (os, stat and sys are built in or frozen).
# Kept identical in emuwiz-cargo-maintain and emuwiz-cargo-retire.


def _install_problem(script, siblings, interpreter, module_dirs):
    """None, or why this copy is unfit to run with root privileges: the script, every
    sibling it loads, the interpreter and every module directory, each with all of its
    parent directories, must be root-owned, not group/world writable and symlink-free.

    This is a tripwire for a misplaced or modified copy, checked before this script
    imports anything; it cannot vouch for the interpreter binary or for the few stdlib
    modules the interpreter loads at start-up (encodings), which is why the interpreter
    and its library must live in root-owned directories (verify-install checks them, and
    should first be run unprivileged with the same interpreter)."""
    def problem(path, want_dir):
        cur = path
        while True:
            try:
                st = os.lstat(cur)
            except OSError as error:
                return f"{cur}: {error.strerror}"
            if stat.S_ISLNK(st.st_mode):
                return f"{cur} is a symlink"
            if cur == path and not (stat.S_ISDIR(st.st_mode) if want_dir else stat.S_ISREG(st.st_mode)):
                return f"{cur} is not a {'directory' if want_dir else 'regular file'}"
            if st.st_uid != 0:
                return f"{cur} is owned by uid {st.st_uid}, not root"
            if st.st_mode & 0o022:
                return f"{cur} is group/world writable"
            if cur == "/":
                return None
            cur = os.path.dirname(cur)

    if not interpreter:
        return "the interpreter path is unknown"
    checks = [(os.path.realpath(p), False) for p in [script] + list(siblings) + [interpreter]]
    checks += [(os.path.realpath(p), True) for p in module_dirs if p and os.path.isdir(p)]
    for path, want_dir in checks:
        why = problem(path, want_dir)
        if why:
            return why
    return None


def _require_trusted_install(script, siblings, force=False):
    """Root (or a process that can regain root) runs only root-owned code; unprivileged
    runs are unaffected unless `force` (verify-install)."""
    if not force and os.geteuid() != 0 and os.getresuid()[2] != 0:
        return
    if not (sys.flags.isolated and sys.flags.no_site):
        raise SystemExit("refusing to run with root privileges: start it as `/usr/bin/python3 -I -S <installed script>`")
    why = _install_problem(script, siblings, sys.executable, sys.path)
    if why:
        raise SystemExit(f"refusing to run with root privileges from an untrusted location: {why}. "
                         "Install root-owned copies (docs/CARGO_CACHE_RETENTION.md, privileged installation)")


HERE = os.path.dirname(os.path.realpath(__file__))
SIBLINGS = ("emuwiz-cargo-retention", "emuwiz-cargo-retire")
_require_trusted_install(__file__, [os.path.join(HERE, n) for n in SIBLINGS])


EXIT_WORKTREE_HOLD = 10


# ------------------------------------------------------------------ loaders


def load(path, name):
    loader = importlib.machinery.SourceFileLoader(name, path)
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


F = load(os.path.join(HERE, "emuwiz-cargo-retention"), "emuwiz_cargo_retention")
RETIRE = os.path.join(HERE, "emuwiz-cargo-retire")
_executor = None


def _verify_hold_release(path, raw):
    """HOLD releases are verified by the deletion engine's owner-signature check."""
    return executor().verify_hold_release(path, raw)


F.HOLD_RELEASE_VERIFIER = _verify_hold_release


def executor():
    """The one deletion engine, loaded in-process (it carries its own census)."""
    global _executor
    if _executor is None:
        _executor = load(RETIRE, "emuwiz_cargo_retire")
    return _executor


def now():
    v = os.environ.get("EMUWIZ_RETENTION_NOW")
    return float(v) if v else time.time()


def gb(n):
    return f"{n / 1e9:.2f} GB"


# ------------------------------------------------------------------- state


INSTANCE_NAME = re.compile(r"[a-z0-9][a-z0-9-]{0,31}")


def maintenance_instance():
    """None for the default instance, else the validated EMUWIZ_MAINTENANCE_INSTANCE name.

    An instance is an independent policy (its own policy, enablement, history, manifests
    and receipts in `maintenance-NAME/`) over the SAME shared lifecycle registry, for one
    more target root.  Its policy must name the root selected by EMUWIZ_TARGET_ROOT
    (load_policy).  A malformed name fails closed rather than falling back to the default."""
    raw = os.environ.get("EMUWIZ_MAINTENANCE_INSTANCE", "")
    if raw in ("", "default"):
        return None
    if not INSTANCE_NAME.fullmatch(raw):
        raise SystemExit(f"EMUWIZ_MAINTENANCE_INSTANCE={raw!r} is not a plain instance name ([a-z0-9-], max 32)")
    return raw


_EVIDENCE_STATE_DIR = None   # set only inside verify_retirement (evidence_state_dir)


def state_dir():
    if _EVIDENCE_STATE_DIR is not None:
        return _EVIDENCE_STATE_DIR
    instance = maintenance_instance()
    return os.path.join(F.registry_dir(), "maintenance" if instance is None else f"maintenance-{instance}")


def evidence_state_dir(record, target, trusted):
    """(dir, why): the maintenance directory holding the evidence for a recorded retirement,
    chosen from the evidence itself rather than from the caller's environment, so a target
    retired by another instance (e.g. nvme2) verifies from a shell that only sets
    EMUWIZ_TARGET_ROOT.  Accepted only if it is `maintenance` or `maintenance-NAME` directly
    inside the registry and its own valid policy names the target's root."""
    receipt = (record.get("last_retired") or {}).get("receipt")
    if not isinstance(receipt, str) or os.path.normpath(receipt) != receipt:
        return None, "evidence path is not directly inside the canonical evidence directory"
    directory = os.path.dirname(os.path.dirname(receipt))
    name = os.path.basename(directory)
    if os.path.dirname(directory) != F.registry_dir() or not (
            name == "maintenance" or (name.startswith("maintenance-")
                                      and INSTANCE_NAME.fullmatch(name[len("maintenance-"):]))):
        return None, "evidence is not in a maintenance directory of this registry"
    text = read_trusted_text(os.path.join(directory, "policy.json"), trusted)
    try:
        policy = json.loads(text) if text is not None else None
    except ValueError:
        policy = None
    if not isinstance(policy, dict) or not validate_policy(policy):
        return None, "the evidence directory has no valid policy"
    if policy["scope"]["target_root"] != os.path.realpath(os.path.dirname(target)):
        return None, "the evidence directory's policy does not cover this target's root"
    return directory, ""


def policy_path():
    return os.path.join(state_dir(), "policy.json")


def enable_path():
    return os.path.join(state_dir(), "enable.json")


def history_path():
    return os.path.join(state_dir(), "history.jsonl")


def usage_path():
    return os.path.join(state_dir(), "usage.json")


def ensure_state():
    os.makedirs(state_dir(), mode=0o700, exist_ok=True)
    for sub in ("manifests", "receipts"):
        os.makedirs(os.path.join(state_dir(), sub), mode=0o700, exist_ok=True)


def append_history(event, at=None):
    ensure_state()
    event = dict(event, at=now() if at is None else at, by=F.owner_name())
    fd = os.open(history_path(), os.O_WRONLY | os.O_CREAT | os.O_APPEND | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or _unsafe_mode(st) or st.st_uid not in trusted_policy_uids():
            raise OSError("history file is not a safe authority file; refusing to append")
        os.write(fd, (json.dumps(event, sort_keys=True) + "\n").encode())
        os.fsync(fd)
    finally:
        os.close(fd)
    fsync_directory(state_dir())


def read_history():
    out = []
    try:
        with open(history_path()) as handle:
            for line in handle:
                try:
                    value = json.loads(line)
                except ValueError:
                    continue
                if isinstance(value, dict):
                    out.append(value)
    except OSError:
        pass
    return out


# ------------------------------------------------------------------ policy


def policy_digest(policy):
    core = {k: policy[k] for k in ("schema", "scope", "limits", "approved_by", "approved_at")}
    return hashlib.sha256(json.dumps(core, sort_keys=True).encode()).hexdigest()


def trusted_policy_uids():
    """Accounts whose files may carry approval: the effective user and the owner of the
    registry directory (the account that approved).  Root is NOT a wildcard: running as
    root accepts only root's own files and the registry owner's."""
    uids = {os.geteuid()}
    try:
        uids.add(os.lstat(F.registry_dir()).st_uid)
    except OSError:
        pass
    return uids


def _trusted_file(path, trusted, want_dir=False):
    """(ok, why): lstat-based, never follows a symlink, owner trusted, not group/world writable."""
    try:
        st = os.lstat(path)
    except OSError as error:
        return False, f"{os.path.basename(path)} unreadable: {error.strerror}"
    kind_ok = stat.S_ISDIR(st.st_mode) if want_dir else stat.S_ISREG(st.st_mode)
    if not kind_ok:
        return False, f"{os.path.basename(path)} is not a regular {'directory' if want_dir else 'file'}"
    if st.st_mode & 0o022:
        return False, f"{os.path.basename(path)} is group/world writable"
    if st.st_uid not in trusted:
        return False, f"{os.path.basename(path)} is owned by uid {st.st_uid}, not an approving account"
    return True, ""


def _unsafe_mode(st):
    return bool(st.st_mode & 0o022)


def read_trusted_text(path, trusted):
    """Contents of an authority file, or None.  Never follows a symlink; requires a regular
    file with a trusted owner and no group/world write; the identity seen by lstat, by
    fstat on the opened descriptor and by lstat after reading must agree (a replacement
    during the read makes the file unreadable).  Parsing alone never makes a file trusted."""
    try:
        before = os.lstat(path)
    except OSError:
        return None
    if not stat.S_ISREG(before.st_mode) or _unsafe_mode(before) or before.st_uid not in trusted:
        return None
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
    except OSError:
        return None
    try:
        st = os.fstat(fd)
        if (st.st_dev, st.st_ino) != (before.st_dev, before.st_ino) or not stat.S_ISREG(st.st_mode) \
                or _unsafe_mode(st) or st.st_uid not in trusted:
            return None
        chunks = []
        while True:
            chunk = os.read(fd, 1 << 20)
            if not chunk:
                break
            chunks.append(chunk)
    except OSError:
        return None
    finally:
        os.close(fd)
    try:
        after = os.lstat(path)
    except OSError:
        return None
    if (after.st_dev, after.st_ino) != (before.st_dev, before.st_ino):
        return None
    try:
        return b"".join(chunks).decode("utf-8")
    except UnicodeDecodeError:
        return None


def authority_dirs_ok(trusted):
    """(ok, why): the maintenance directory is a real directory owned by a trusted account
    and not group/world writable, and the registry directory above it is a real directory
    owned by a trusted account and not world-writable.  The registry directory is
    group-writable by default (umask 002); that cannot substitute the maintenance
    directory with one owned by the approving account, and the maintenance directory's
    own owner/mode are checked here, so only world-writability is refused above it."""
    ok, why = _trusted_file(state_dir(), trusted, want_dir=True)
    if not ok:
        return False, why
    try:
        st = os.lstat(F.registry_dir())
    except OSError as error:
        return False, f"registry directory unreadable: {error.strerror}"
    if not stat.S_ISDIR(st.st_mode):
        return False, "registry directory is not a real directory"
    if st.st_uid not in trusted:
        return False, f"registry directory is owned by uid {st.st_uid}, not an approving account"
    if st.st_mode & 0o002:
        return False, "registry directory is world writable"
    return True, ""


def _is_count(value, minimum=0):
    return isinstance(value, int) and not isinstance(value, bool) and value >= minimum


def validate_policy(policy):
    try:
        scope, limits = policy["scope"], policy["limits"]
        return (
            policy.get("schema") == POLICY_VERSION
            and isinstance(scope["target_root"], str) and os.path.isabs(scope["target_root"])
            and isinstance(scope["owners"], list) and scope["owners"]
            and all(isinstance(o, str) and o for o in scope["owners"])
            and isinstance(scope["kinds"], list) and scope["kinds"]
            and all(k == "per-worktree" for k in scope["kinds"])
            and _is_count(limits["soft_budget_bytes"], 1) and _is_count(limits["hard_budget_bytes"], 1)
            and limits["soft_budget_bytes"] < limits["hard_budget_bytes"]
            and _is_count(limits.get("reserve_free_bytes", 0), 0)
            and _is_count(limits.get("reserve_trigger_free_bytes", 0), 0)
            and limits.get("reserve_trigger_free_bytes", 0) <= limits.get("reserve_free_bytes", 0)
            and _is_count(limits["max_targets_per_cycle"], 1) and _is_count(limits["max_bytes_per_cycle"], 0)
            and isinstance(limits["min_idle_hours"], (int, float)) and not isinstance(limits["min_idle_hours"], bool)
            and math.isfinite(limits["min_idle_hours"]) and limits["min_idle_hours"] >= MIN_IDLE_HOURS
            and isinstance(policy["approved_by"], str) and isinstance(policy["approved_at"], (int, float))
            and isinstance(policy["enabled"], bool)
            and policy["digest"] == policy_digest(policy)
        )
    except (KeyError, TypeError, AttributeError):
        return False


TRANSITIONS = ("policy_approved", "policy_enabled", "policy_disabled")


def _generation(value):
    return value if isinstance(value, int) and not isinstance(value, bool) and value >= 0 else None


def read_authority_history(trusted):
    """(events, why): the COMPLETE history, or (None, why) when it cannot be trusted:
    unsafe file or directory, not newline-terminated (truncated), or any line that is not
    a JSON object.  Every line must parse; a torn or garbage line is not skipped."""
    text = read_trusted_text(history_path(), trusted)
    if text is None:
        return None, "history is missing, unreadable or not a safe authority file"
    if text and not text.endswith("\n"):
        return None, "history is truncated (no final newline)"
    events = []
    for number, line in enumerate(text.split("\n")[:-1] if text else [], 1):
        try:
            value = json.loads(line)
        except ValueError:
            return None, f"history line {number} is not valid JSON"
        if not isinstance(value, dict):
            return None, f"history line {number} is not an object"
        events.append(value)
    return events, ""


def transitions_of(events):
    """(transitions, why): the policy transitions in file order, each fully validated, with
    strictly increasing generations.  Duplicate, conflicting, malformed or out-of-order
    generations make the sequence unreconcilable."""
    out, last_gen = [], -1
    for event in events:
        if event.get("event") not in TRANSITIONS:
            continue
        gen = _generation(event.get("generation"))
        digest = event.get("digest")
        if gen is None or not isinstance(digest, str) or not digest:
            return None, "a policy transition record is malformed"
        if gen <= last_gen:
            return None, f"policy generations are duplicated or out of order (generation {gen} after {last_gen})"
        last_gen = gen
        out.append(event)
    return out, ""


def reconcile_enablement(trans, rec, policy_digest):
    """True iff the whole transition history agrees with the state record and the policy:
    the state generation is the highest recorded one, the final transition is the matching
    `policy_enabled`, and every transition since the latest approval names this digest."""
    if not trans:
        return False
    last = trans[-1]
    if last.get("event") != "policy_enabled" or last.get("digest") != policy_digest \
            or last.get("generation") != rec["generation"] \
            or not isinstance(last.get("code_sha256"), str) or last.get("code_sha256") != rec.get("code_sha256"):
        return False
    since = 0
    for index, event in enumerate(trans):
        if event.get("event") == "policy_approved":
            since = index
    if trans[since].get("event") != "policy_approved":
        return False
    return all(e.get("digest") == policy_digest for e in trans[since:])


def code_fingerprint():
    """sha256 over the exact bytes of the three scripts this copy runs, or None when any
    cannot be read.  An enablement is bound to it, so installing, replacing or modifying
    any of them drops back to DISABLED until `policy enable` is run again, deliberately,
    by the owner, for that exact code."""
    digest = hashlib.sha256()
    for name in ("emuwiz-cargo-maintain",) + SIBLINGS:
        try:
            with open(os.path.join(HERE, name), "rb") as handle:
                data = handle.read()
        except OSError:
            return None
        digest.update(name.encode() + b"\0" + hashlib.sha256(data).hexdigest().encode() + b"\n")
    return digest.hexdigest()


def read_state_record(trusted):
    """(record or None): the single persistent enablement state, or None when it is
    missing, unsafe (symlink, wrong owner/mode, replaced while read) or malformed."""
    text = read_trusted_text(enable_path(), trusted)
    if text is None:
        return None
    try:
        rec = json.loads(text)
    except ValueError:
        return None
    if not isinstance(rec, dict) or rec.get("schema") != 2 or rec.get("state") not in ("ENABLED", "DISABLED") \
            or _generation(rec.get("generation")) is None or not isinstance(rec.get("policy_digest"), str):
        return None
    return rec


def verify_enablement(policy, trusted):
    """True only when authority can be fully reconciled: safe directories; a safe state
    record that is ENABLED for THIS policy digest; a complete, safe, well-formed history
    with strictly increasing generations whose highest generation equals the record's and
    whose final transition is the matching `policy_enabled`.  The record and that transition
    must also carry the fingerprint of the code now running (`code_fingerprint`): an
    enablement made for an older or different install, or before fingerprints existed, is
    disabled.  Anything else, including a replayed older ENABLED record, is disabled.  The `enabled` flag inside the policy file
    is informational and never counts.

    This is STRUCTURAL verification inside one account.  There is no independent trusted
    anchor (no key, no root-owned counter): a writer who rewrites the state record AND the
    whole history consistently is not detected."""
    if not authority_dirs_ok(trusted)[0]:
        return False
    rec = read_state_record(trusted)
    if rec is None or rec["state"] != "ENABLED" or rec["policy_digest"] != policy["digest"]:
        return False
    fingerprint = code_fingerprint()
    if fingerprint is None or rec.get("code_sha256") != fingerprint:
        return False        # recorded for other (or no) code: an install or upgrade resets enablement
    events, _ = read_authority_history(trusted)
    if events is None:
        return False
    trans, _ = transitions_of(events)
    return trans is not None and reconcile_enablement(trans, rec, policy["digest"])


def load_policy(trusted_uids=None):
    """(state, policy, why): state is absent, ok or invalid.  Invalid is never
    treated as absent-and-harmless: automatic retirement fails closed.  The returned
    policy's `enabled` is the VERIFIED enablement, not the file's own flag."""
    trusted = set(trusted_uids) if trusted_uids is not None else trusted_policy_uids()
    path = policy_path()
    try:
        os.lstat(path)
    except FileNotFoundError:
        return "absent", None, "no policy has been approved"
    except OSError as error:
        return "invalid", None, f"policy unreadable: {error.strerror}"
    ok, why = authority_dirs_ok(trusted)
    if not ok:
        return "invalid", None, "policy directory " + why
    ok, why = _trusted_file(path, trusted)
    if not ok:
        return "invalid", None, "policy " + why
    text = read_trusted_text(path, trusted)
    if text is None:
        return "invalid", None, "policy is not a stable, safe authority file"
    try:
        policy = json.loads(text)
    except ValueError as error:
        return "invalid", None, f"policy unreadable: {error}"
    old_schema = policy.get("schema") if isinstance(policy, dict) else None
    if isinstance(old_schema, int) and not isinstance(old_schema, bool) and 0 < old_schema < POLICY_VERSION:
        return "invalid", None, (f"policy schema {old_schema} was approved before the retirement scope was "
                                 f"widened (schema {POLICY_VERSION}: post-retirement binary residue); it no longer "
                                 "authorises anything. Review the scope and run `policy approve` again")
    if not isinstance(policy, dict) or not validate_policy(policy):
        return "invalid", None, "policy is malformed or its integrity digest does not match"
    if maintenance_instance() is not None and policy["scope"]["target_root"] != os.path.realpath(F.target_root()):
        # budgets and free space are measured on F.target_root(); an instance policy that
        # names another root would be measured against the wrong device
        return "invalid", None, (f"instance policy covers {policy['scope']['target_root']} but EMUWIZ_TARGET_ROOT "
                                 f"selects {os.path.realpath(F.target_root())}")
    claimed = policy["enabled"]
    # BOTH are required: the policy file itself says enabled AND a fresh approval exists for
    # the exact code now running.  Either one alone leaves retirement disabled.
    policy["enabled"] = bool(claimed) and verify_enablement(policy, trusted)
    why = ""
    if not policy["enabled"]:
        rec = read_state_record(trusted)
        if rec and rec["state"] == "ENABLED" and rec["policy_digest"] == policy["digest"] \
                and rec.get("code_sha256") != code_fingerprint():
            why = ("a stored enablement does not belong to the code now running (install, upgrade or no recorded code); "
                   "treated as disabled until `policy enable` is run deliberately")
        elif claimed:
            why = "policy file claims enabled but there is no verified `policy enable` approval; treated as disabled"
        elif verify_enablement(policy, trusted):
            why = "a stored enablement exists but the policy file is disabled (enabled=false); treated as disabled"
    return "ok", policy, why


def fsync_directory(path):
    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def durable_write(path, data):
    """Atomic replace with file fsync (F.atomic_write) and parent-directory fsync, so a
    completed transition survives a crash and a torn one is never half-visible."""
    F.atomic_write(path, data)
    fsync_directory(os.path.dirname(path))


def write_policy(policy):
    ensure_state()
    durable_write(policy_path(), policy)


def policy_for_display(policy):
    """Expose documented diagnostics, redacting unrecognised keys AND values.

    Validation accepts extension metadata, which may contain credentials. Keep
    that metadata out of stdout without altering the policy used for integrity
    checks, approval reconciliation or execution.
    """
    if policy is None:
        return None

    def public_fields(section, allowed):
        out = {key: section[key] for key in allowed if key in section}
        if section.keys() - allowed:
            out["redacted_fields"] = "[REDACTED]"
        return out

    out = public_fields(policy, {"schema", "approved_by", "approved_at", "enabled", "digest", "scope", "limits"})
    out["scope"] = public_fields(policy["scope"], {"target_root", "owners", "kinds"})
    out["limits"] = public_fields(policy["limits"], {
        "soft_budget_bytes", "hard_budget_bytes", "min_idle_hours", "reserve_free_bytes",
        "reserve_trigger_free_bytes", "max_targets_per_cycle", "max_bytes_per_cycle",
    })
    return out


def policy_root_owner(root):
    """The other maintenance directory (name) whose policy file names `root`, else None.
    Any unreadable or unparsable other policy that might name it counts as a match
    (fail closed: approval is refused rather than creating two policies over one root)."""
    registry, mine = F.registry_dir(), os.path.basename(state_dir())
    try:
        names = sorted(os.listdir(registry))
    except OSError:
        return None
    for name in names:
        if name == mine or not (name == "maintenance" or (
                name.startswith("maintenance-") and INSTANCE_NAME.fullmatch(name[len("maintenance-"):]))):
            continue
        path = os.path.join(registry, name, "policy.json")
        if not os.path.lexists(path):
            continue
        try:
            with open(path) as handle:
                other = json.load(handle)
            if ((other.get("scope") or {}).get("target_root")) != root:
                continue
        except (OSError, ValueError, AttributeError):
            pass
        return name
    return None


def cmd_policy(args):
    if args.action == "show":
        state, policy, why = load_policy()
        out = {"state": state, "why": why, "policy": policy_for_display(policy), "path": policy_path()}
        print(json.dumps(out, indent=1, sort_keys=True))
        return 0 if state in ("ok", "absent") else 1
    if args.action == "approve":
        owners = [o.strip() for o in (args.owners or "").split(",") if o.strip()]
        if not owners:
            raise SystemExit("policy approve requires --owners (the owner labels whose released targets may be retired)")
        if not math.isfinite(args.reserve_free_gib) or args.reserve_free_gib < 0:
            raise SystemExit("reserve-free-gib must be finite and nonnegative")
        trigger = args.reserve_trigger_free_gib
        if trigger is not None and (not math.isfinite(trigger) or trigger < 0 or trigger > args.reserve_free_gib):
            raise SystemExit("reserve-trigger-free-gib must be finite, nonnegative and not above reserve-free-gib")
        root = os.path.realpath(args.target_root or F.target_root())
        if maintenance_instance() is not None and root != os.path.realpath(F.target_root()):
            raise SystemExit(f"this instance measures {os.path.realpath(F.target_root())}; it cannot approve {root}")
        other = policy_root_owner(root)
        if other is not None:
            raise SystemExit(f"{root} is already covered by the policy in {other}; one policy per root")
        policy = {
            "schema": POLICY_VERSION,
            "approved_by": F.owner_name(),
            "approved_at": now(),
            "scope": {"target_root": root, "owners": sorted(set(owners)), "kinds": ["per-worktree"]},
            "limits": {
                "soft_budget_bytes": int(args.soft_gb * 1e9),
                "hard_budget_bytes": int(args.hard_gb * 1e9),
                "min_idle_hours": max(MIN_IDLE_HOURS, args.min_idle_hours),
                "reserve_free_bytes": int(args.reserve_free_gib * GIB),
                "max_targets_per_cycle": args.max_targets,
                "max_bytes_per_cycle": int(args.max_gb * 1e9),
            },
            "enabled": False,
        }
        if trigger is not None:
            # optional (absent = trigger at the reserve itself, the original behaviour), so
            # existing policies and their digests are unchanged
            policy["limits"]["reserve_trigger_free_bytes"] = int(trigger * GIB)
        if policy["limits"]["soft_budget_bytes"] >= policy["limits"]["hard_budget_bytes"]:
            raise SystemExit("soft budget must be below the hard budget")
        policy["digest"] = policy_digest(policy)
        ensure_state()
        with transition_lock():
            # new policy => DISABLED state at a new generation, then the policy itself:
            # a crash in between leaves the old policy with a newer DISABLED generation
            gen = next_generation()
            rotate_unreconciled_history()
            record_transition("policy_approved", gen, policy["digest"], "DISABLED", scope=policy["scope"])
            write_policy(policy)
        print("policy recorded and left DISABLED; enable it explicitly with `policy enable`")
        return 0
    state, policy, why = load_policy()
    if state != "ok":
        raise SystemExit(f"policy {args.action}: {why}")
    want = args.action == "enable"
    ensure_state()
    with transition_lock():
        state, policy, why = load_policy()          # re-read under the lock
        if state != "ok":
            raise SystemExit(f"policy {args.action}: {why}")
        stored = read_state_record(trusted_policy_uids())
        # a stored ENABLED record that no longer verifies (other code, stale) is still cleared by `disable`
        if policy["enabled"] == want and (want or not (stored and stored["state"] == "ENABLED")):
            print(f"policy already {'enabled' if want else 'disabled'}")
            return 0
        set_enabled_locked(policy, want)
    print(f"automatic retirement {'ENABLED' if want else 'DISABLED'}")
    return 0


def set_enabled_locked(policy, want, **extra):
    """The enable/disable transition.  Caller holds transition_lock()."""
    gen = next_generation()
    if want:
        fingerprint = code_fingerprint()
        if fingerprint is None:
            raise SystemExit("policy enable: the maintenance scripts cannot be read; nothing enabled")
        # state record first, history second: an interruption between them is NOT enabled
        write_state({"schema": 2, "generation": gen, "state": "ENABLED", "policy_digest": policy["digest"],
                     "code_sha256": fingerprint, "by": F.owner_name(), "at": now(), "uid": os.geteuid()})
        append_history(dict(extra, event="policy_enabled", digest=policy["digest"], generation=gen,
                            code_sha256=fingerprint))
        write_policy(dict(policy, enabled=True))     # last: until here the file is still disabled
    else:
        write_policy(dict(policy, enabled=False))    # first: the file is disabled before anything else
        # history first, state second: an interruption leaves a newer DISABLED transition
        record_transition("policy_disabled", gen, policy["digest"], "DISABLED", **extra)


class ConcurrentMaintenance(Exception):
    pass


@contextlib.contextmanager
def transition_lock(wait=True):
    """Serialises policy transitions (approve/enable/disable) across processes.  With
    wait=False a busy lock raises ConcurrentMaintenance instead of waiting."""
    ensure_state()
    fd = os.open(os.path.join(state_dir(), ".policy-transition.lock"), os.O_RDWR | os.O_CREAT | os.O_CLOEXEC, 0o600)
    try:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            if not wait:
                raise ConcurrentMaintenance("another maintenance cycle or policy transition is in progress")
            print("emuwiz-cargo-maintain: waiting for an in-flight maintenance cycle or policy transition "
                  "to finish (a running executor transaction is never interrupted)", file=sys.stderr, flush=True)
            fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        os.close(fd)


def next_generation():
    """One more than the highest generation seen anywhere (state record or any transition
    line, tolerant of a damaged history), so generations never repeat or go backwards."""
    seen = [0]
    rec = read_state_record(trusted_policy_uids())
    if rec is not None:
        seen.append(rec["generation"])
    for event in read_history():
        if event.get("event") in TRANSITIONS and _generation(event.get("generation")) is not None:
            seen.append(event["generation"])
    return max(seen) + 1


def rotate_unreconciled_history():
    """Approval over a history that cannot be reconciled: move it aside (rename, never
    delete) so the new policy starts from a clean, verifiable log; generations continue
    from the highest value seen.  Returns the new name or None."""
    trusted = trusted_policy_uids()
    path = history_path()
    if not os.path.lexists(path):
        return None
    events, _ = read_authority_history(trusted)
    if events is not None and transitions_of(events)[0] is not None:
        return None
    aside = f"{path}.unreconciled-{int(now())}-{os.getpid()}"
    os.replace(path, aside)
    fsync_directory(state_dir())
    return aside


def record_transition(event, gen, digest, state, **extra):
    """History event (fsynced) first, then the state record (atomic, fsynced, dir fsynced)."""
    append_history(dict(extra, event=event, digest=digest, generation=gen))
    write_state({"schema": 2, "generation": gen, "state": state, "policy_digest": digest,
                 "by": F.owner_name(), "at": now(), "uid": os.geteuid()})


def write_state(record):
    durable_write(enable_path(), record)


# --------------------------------------------------------------- inventory


def make_args(policy, extra=None):
    limits = (policy or {}).get("limits", {})
    ns = types.SimpleNamespace(
        repo=None, extra_target=[],
        soft_budget=limits.get("soft_budget_bytes", DEFAULT_SOFT),
        hard_budget=limits.get("hard_budget_bytes", DEFAULT_HARD),
        min_idle_hours=max(MIN_IDLE_HOURS, limits.get("min_idle_hours", MIN_IDLE_HOURS)),
        accept_foreign_process_gap=False,   # never: a partial census fails closed
        strict_atime=False, json=False,
    )
    for k, v in (extra or {}).items():
        setattr(ns, k, v)
    return ns


def policy_reasons(item, policy):
    """Reasons a RETIRABLE target is outside the approved policy scope."""
    out = []
    if policy is None:
        return ["NO_POLICY"]
    scope = policy["scope"]
    root = scope["target_root"]
    path = item["target"]
    if not (path == root or path.startswith(root + os.sep)) or os.path.dirname(path) != root:
        out.append("OUTSIDE_POLICY_ROOT")
    if item["kind"] not in scope["kinds"]:
        out.append("OUTSIDE_POLICY_ROOT")
    record = item["record"] or {}
    if record.get("owner") not in scope["owners"]:
        out.append("OWNER_NOT_IN_POLICY")
    return sorted(set(out))


_MAIN_REFS = {}       # git common dir -> (base ref, problem): one bounded fetch per repository per run
_MERGED_PRS = {}      # git common dir -> {head oid: merge commit oid} or None (unavailable)
FETCH_TIMEOUT = 90


def _git(wt, *args, timeout=30, group_timeout=False):
    env = {k: v for k, v in os.environ.items() if not k.startswith("GIT_")}
    env.update(GIT_NO_REPLACE_OBJECTS="1", GIT_GRAFT_FILE="/nonexistent", GIT_CONFIG_NOSYSTEM="1",
               GIT_OPTIONAL_LOCKS="0", GIT_TERMINAL_PROMPT="0", LC_ALL="C",
               GIT_SSH_COMMAND="ssh -o BatchMode=yes -o ConnectTimeout=15")
    cmd = ["git", "-c", "core.hooksPath=/dev/null", "-C", wt, *args]
    if group_timeout:          # coreutils timeout signals the whole process group (remote helpers, ssh)
        cmd = ["timeout", "-k", "10", str(timeout), *cmd]
        timeout += 30
    return F.run_as_owner(cmd, capture_output=True, text=True, timeout=timeout, env=env)


def _git_env():
    env = {k: v for k, v in os.environ.items() if not k.startswith("GIT_")}
    env.update(GIT_NO_REPLACE_OBJECTS="1", GIT_GRAFT_FILE="/nonexistent", GIT_CONFIG_NOSYSTEM="1",
               GIT_CONFIG_GLOBAL="/dev/null", GIT_OPTIONAL_LOCKS="0", GIT_TERMINAL_PROMPT="0", LC_ALL="C",
               GIT_SSH_COMMAND="ssh -o BatchMode=yes -o ConnectTimeout=15")
    return env


ALLOW_LOCAL_EVIDENCE_REMOTE = False     # tests only (in-process): a local bare repository as origin
STORE_CONFIG = ("[core]\n\trepositoryformatversion = 0\n\tbare = true\n\thooksPath = /dev/null\n"
                "\tcommitGraph = false\n\tmultiPackIndex = false\n[gc]\n\tauto = 0\n[maintenance]\n\tauto = false\n"
                "[fetch]\n\twriteCommitGraph = false\n")


def _git_in(gitdir, *args, timeout=30, group_timeout=False):
    """git against a bare repository (the merge-evidence store), hooks disabled."""
    cmd = ["git", "-c", "core.hooksPath=/dev/null", "-c", "core.commitGraph=false", "--git-dir", gitdir, *args]
    if group_timeout:
        cmd = ["timeout", "-k", "10", str(timeout), *cmd]
        timeout += 30
    return F.run_as_owner(cmd, capture_output=True, text=True, timeout=timeout, env=_git_env())


def _github_repo(url):
    """owner/repo for a GitHub remote URL (SSH or HTTPS), else None."""
    m = re.fullmatch(r"(?:(?:ssh://)?git@github\.com[:/]|https://github\.com/)([\w.-]+/[\w.-]+?)(?:\.git)?/?",
                     url or "")
    return m.group(1) if m else None


def _fetch_url(url):
    """The only URLs merge evidence comes from: a GitHub repository, fetched anonymously
    over HTTPS (no keys, agent or credential helper inside the service; a private
    repository fails closed).  Anything else is None (SOURCE_GIT_UNVERIFIED), except a
    local bare repository when the in-process test switch is set."""
    repo = _github_repo(url)
    if repo:
        return f"https://github.com/{repo}.git"
    if ALLOW_LOCAL_EVIDENCE_REMOTE and url and os.path.isabs(url):
        return url
    return None


def evidence_store(common):
    """The merge-evidence store for a repository: a bare repository inside this instance's
    maintenance state directory (already writable by the sandboxed service), borrowing the
    source repository's objects READ-ONLY through objects/info/alternates.  The service
    never writes to a source .git or worktree; only this store's refs/objects change."""
    path = os.path.join(state_dir(), "git-evidence", hashlib.sha256(common.encode()).hexdigest()[:16] + ".git")
    for part in (os.path.dirname(path), path, os.path.join(path, "objects"), os.path.join(path, "refs")):
        if os.path.islink(part):
            raise OSError(f"{part} is a symlink; the merge-evidence store must be a plain directory")
    if not os.path.isdir(os.path.join(path, "objects")):
        ensure_state()                         # the state directory itself: private (0700)
        try:
            os.mkdir(os.path.dirname(path), 0o700)
        except FileExistsError:
            pass
        done = F.run_as_owner(["git", "init", "-q", "--bare", path], capture_output=True, text=True,
                              timeout=30, env=_git_env())
        if done.returncode != 0:
            raise OSError("cannot create the merge-evidence store: " + done.stderr.strip()[:200])
        for key, value in (("gc.auto", "0"), ("maintenance.auto", "false"), ("core.hooksPath", "/dev/null"),
                           ("fetch.writeCommitGraph", "false")):
            _git_in(path, "config", key, value)
    _write_text(os.path.join(path, "config"), STORE_CONFIG)    # rewritten every run: no inherited settings
    for name in ("commit-graph", os.path.join("info", "commit-graphs")):
        if os.path.lexists(os.path.join(path, "objects", name)):
            raise OSError("the merge-evidence store contains a commit-graph; refusing to trust it")
    alternates = os.path.join(path, "objects", "info", "alternates")
    wanted = os.path.join(common, "objects") + "\n"
    try:
        with open(alternates) as handle:
            current = handle.read()
    except OSError:
        current = None
    if current != wanted:
        os.makedirs(os.path.dirname(alternates), exist_ok=True)
        _write_text(alternates, wanted)
    return path


def _write_text(path, text):
    tmp = f"{path}.tmp-{os.getpid()}"
    with open(tmp, "w") as handle:
        handle.write(text)
        handle.flush()
        os.fsync(handle.fileno())
    os.replace(tmp, path)


def main_ref(wt):
    """(gitdir, ref, problem): where to ask what is merged.  With an `origin` remote:
    refs/remotes/origin/main in the merge-evidence store, refreshed first by ONE bounded
    fetch of exactly main per repository per run (no gc, no hooks, no FETCH_HEAD; a stalled
    transfer is killed with its whole process group).  Nothing in the source repository,
    its branches, HEAD, index or worktrees is written.  A failed fetch is a problem (the
    cache is kept), never a fallback to an older ref.  Without a remote: the repository's
    own local main/master, read-only."""
    try:
        common = os.path.realpath(os.path.join(wt, _git(wt, "rev-parse", "--git-common-dir").stdout.strip()))
    except (OSError, subprocess.SubprocessError) as error:
        return None, None, f"git unavailable ({error})"
    if common in _MAIN_REFS:
        return _MAIN_REFS[common]
    try:
        url = _git(wt, "config", "--get", "remote.origin.url")    # raw: no insteadOf rewriting
        if url.returncode != 0:
            ref = next((r for r in ("refs/heads/main", "refs/heads/master")
                        if _git(wt, "rev-parse", "-q", "--verify", r + "^{commit}").returncode == 0), None)
            result = (None, ref, None if ref else "no main branch")
        else:
            source = _fetch_url(url.stdout.strip())
            if not source:
                result = (None, None, f"origin {url.stdout.strip()[:120]!r} is not a GitHub repository; "
                                      "merge evidence comes only from GitHub")
                _MAIN_REFS[common] = result
                return result
            store = evidence_store(common)
            done = _git_in(store, "-c", "http.lowSpeedLimit=1000", "-c", "http.lowSpeedTime=30",
                           "fetch", "--no-tags", "--no-recurse-submodules", "--no-auto-maintenance",
                           "--no-write-fetch-head", "--quiet", source,
                           "+refs/heads/main:refs/remotes/origin/main", timeout=FETCH_TIMEOUT, group_timeout=True)
            result = (store, "refs/remotes/origin/main", None) if done.returncode == 0 else \
                (None, None, "fetch of origin/main failed: " + (done.stderr.strip().splitlines() or ["?"])[-1][:200])
    except (OSError, subprocess.SubprocessError) as error:
        result = (None, None, f"fetch of origin/main failed ({type(error).__name__}: {str(error)[:120]})")
    _MAIN_REFS[common] = result
    return result


def merged_pr_heads(wt):
    """{head oid: merge commit oid} of merged pull requests (squash merges leave the branch
    HEAD outside main), from one bounded `gh pr list` per repository; None if unavailable."""
    try:
        common = os.path.realpath(os.path.join(wt, _git(wt, "rev-parse", "--git-common-dir").stdout.strip()))
    except (OSError, subprocess.SubprocessError):
        return None
    if common not in _MERGED_PRS:
        try:
            repo = _github_repo(_git(wt, "config", "--get", "remote.origin.url").stdout.strip())
            if not repo:                       # the same repository the evidence was fetched from, only
                _MERGED_PRS[common] = None
                return None
            env = {k: v for k, v in os.environ.items() if not k.startswith(("GH_", "GITHUB_", "GIT_"))}
            env.update(GH_PROMPT_DISABLED="1", GH_NO_UPDATE_NOTIFIER="1", NO_COLOR="1")
            done = F.run_as_owner(["timeout", "-k", "10", str(FETCH_TIMEOUT), "gh", "pr", "list", "-R", repo,
                                   "--state", "merged", "--limit", "1000", "--json", "headRefOid,mergeCommit"],
                                  capture_output=True, text=True, timeout=FETCH_TIMEOUT + 30, env=env)
            prs = json.loads(done.stdout) if done.returncode == 0 else None
            _MERGED_PRS[common] = None if prs is None else {
                p["headRefOid"]: (p.get("mergeCommit") or {}).get("oid") for p in prs if p.get("headRefOid")}
        except (OSError, subprocess.SubprocessError, ValueError, TypeError):
            _MERGED_PRS[common] = None
    return _MERGED_PRS[common]


def routine_source_problems(wt):
    """[] when the cache's source is finished work: its HEAD is merged into main (an
    ancestor of the freshly fetched origin/main, or the exact head of a merged pull request
    whose merge commit is in origin/main: squash merges) and the checkout's history is
    preserved (history_preservation_problem: clean, no unpushed or reflog-only commits, no
    unfinished Git operation).  Fail closed: anything not established is a problem."""
    store, base, problem = main_ref(wt)
    if problem or not base:
        return ["SOURCE_GIT_UNVERIFIED"]

    def is_ancestor(commit):
        if store:
            return _git_in(store, "merge-base", "--is-ancestor", commit, base).returncode == 0
        return _git(wt, "merge-base", "--is-ancestor", commit, base).returncode == 0
    try:
        head = _git(wt, "rev-parse", "HEAD").stdout.strip()
        merged = bool(head) and is_ancestor(head)
        if not merged and store:
            heads = merged_pr_heads(wt)
            if heads is None:
                return ["SOURCE_GIT_UNVERIFIED"]
            merge = heads.get(head)
            merged = bool(merge) and is_ancestor(merge)
    except (OSError, subprocess.SubprocessError):
        return ["SOURCE_GIT_UNVERIFIED"]
    if not merged:
        return ["SOURCE_NOT_MERGED"]
    try:
        problem = history_preservation_problem(wt)
    except (OSError, subprocess.SubprocessError):
        problem = ("GIT_STATE_UNVERIFIED", "")
    return ["SOURCE_HISTORY_UNPRESERVED"] if problem else []


# ------------------------------------------- forgotten --finish-task (routine release)

AUTO_RELEASE_QUIET_HOURS = 24.0
AUTO_RELEASE_TASK = "routine-verified-finished"
SESSION_GLOBS = (".claude/projects/**/*.jsonl", ".codex/sessions/**/*.jsonl")   # incl. subagents/
COORDINATION_GLOB = "emuwiz-audit-ledger/*/COORDINATION.md"
_FINISHED_WORDS = re.compile(r"\b(merged|closed|done|completed?|finished|superseded|abandoned|retired)\b", re.I)
_UNFINISHED_WORDS = re.compile(r"\b(active|paused?|wait(ing)?|hold|held|in[-\s]progress|started|queued|blocked|"
                               r"pending|reassess\w*|handed|resum\w*|draft|open|owner decision|not\s+(yet\s+)?"
                               r"(merged|done|finished|complete\w*)|wip|running|await\w*|review\w*|ongoing|"
                               r"reopen\w*|follow-?ups?|todo|next|unfinished|incomplete|stopped|interrupted)\b", re.I)


def coordination_problem(wt):
    """None only when the coordination/ownership table(s) list this checkout and every
    row naming it in its Worktree column says the task is over (merged/closed/done...)
    without any word of continuing work (active, paused, waiting, hold, ...), and no note
    or other row naming it carries such a word either.  No table, an unreadable table, no
    row, or mixed wording: ownership is unresolved or unfinished, so skip."""
    import glob
    paths = sorted(glob.glob(os.path.join(F.home(), COORDINATION_GLOB)))
    if not paths:
        return "OWNERSHIP_UNRESOLVED"
    names = {os.path.basename(os.path.normpath(wt)), os.path.realpath(wt)}
    pattern = re.compile("|".join(r"(?:^|[\s/(`'\"])" + re.escape(n) + r"(?=$|[\s)/,;:`'\"]|\.(?:\s|$))"
                                  for n in names))
    rows, notes = [], []
    for path in paths:
        try:
            with open(path, encoding="utf-8") as handle:
                lines = handle.read().splitlines()
        except (OSError, UnicodeDecodeError):
            return "OWNERSHIP_UNRESOLVED"
        header = None                      # kept across notes interleaved with the rows
        for n, line in enumerate(lines):
            following = lines[n + 1] if n + 1 < len(lines) else ""
            if line.startswith("|"):
                cells = [c.strip() for c in line.strip().strip("|").split("|")]
                if set("".join(cells)) <= set("-: "):
                    continue
                if following.startswith("|") and set(following.replace("|", "")) <= set("-: ") and following.strip("| "):
                    header = [c.lower() for c in cells]
                    continue
                col = next((i for i, h in enumerate(header or []) if h.startswith("worktree")), None)
                scol = next((i for i, h in enumerate(header or []) if h.startswith("status")), None)
                if col is not None and col < len(cells) and pattern.search(cells[col]):
                    status = cells[scol] if scol is not None and scol < len(cells) else " ".join(cells)
                    rows.append((" ".join(cells), status))
                elif pattern.search(line):
                    notes.append(line)     # named elsewhere in a row: e.g. a hand-over
            elif pattern.search(line):
                notes.append(line)
    if any(_UNFINISHED_WORDS.search(n) for n in notes):
        return "OWNERSHIP_TASK_NOT_FINISHED"
    if not rows:
        return "OWNERSHIP_UNRESOLVED"
    if any(_UNFINISHED_WORDS.search(row) or not _FINISHED_WORDS.search(status) for row, status in rows):
        return "OWNERSHIP_TASK_NOT_FINISHED"
    return None


def _newest_mtime(path, skip=(".git", "target")):
    try:
        newest = os.lstat(path).st_mtime
    except OSError:
        return float("inf")                   # cannot tell: treat as in use
    for root, dirs, files in os.walk(path):
        dirs[:] = [d for d in dirs if d not in skip]
        for name in files + dirs:
            try:
                newest = max(newest, os.lstat(os.path.join(root, name)).st_mtime)
            except OSError:
                pass
    return newest


def _git_admin_mtime(wt):
    """Newest of the checkout's own Git admin files (index, HEAD, reflog): status, commits
    and resets touch them although nothing else in the checkout changes."""
    try:
        gitdir = os.path.join(wt, _git(wt, "rev-parse", "--git-dir").stdout.strip())
    except (OSError, subprocess.SubprocessError):
        return float("inf")
    newest = 0.0
    for name in ("index", "HEAD", "ORIG_HEAD", os.path.join("logs", "HEAD")):
        try:
            newest = max(newest, os.lstat(os.path.join(gitdir, name)).st_mtime)
        except FileNotFoundError:
            pass
        except OSError:
            return float("inf")
    return newest


def _recent_sessions(cutoff):
    import glob
    paths = []
    for pattern in SESSION_GLOBS:
        for path in glob.glob(os.path.join(F.home(), pattern), recursive=True):
            try:
                if os.path.getmtime(path) >= cutoff:
                    paths.append(path)
            except OSError:
                paths.append(path)            # cannot tell: searched (and unreadable = named)
    return sorted(set(paths))


def _session_names(paths, needles):
    """True when any recent transcript contains any needle (or cannot be read).  Streamed
    with mmap, so large transcripts are never loaded whole."""
    import mmap
    for path in paths:
        try:
            with open(path, "rb") as handle:
                if os.fstat(handle.fileno()).st_size == 0:
                    continue
                with mmap.mmap(handle.fileno(), 0, access=mmap.ACCESS_READ) as data:
                    if any(data.find(n) >= 0 for n in needles):
                        return True
        except (OSError, ValueError):
            return True
    return False


def finished_task_candidates(items, policy):
    """Targets whose task was evidently finished but never released: IDLE with no hold but
    NOT_RELEASED (so no build lock, no recorded or live process in the cache OR its source
    checkout, idle long enough, not pinned), inside the policy scope, with a merged, clean,
    history-preserved source (routine_source_problems), and a checkout that neither changed
    nor was named in any agent session transcript for AUTO_RELEASE_QUIET_HOURS.  A merged PR
    alone is never enough.  Returns (candidates, [(item, reasons)] for the rest considered)."""
    quiet = max(AUTO_RELEASE_QUIET_HOURS, float(((policy or {}).get("limits") or {}).get("min_idle_hours") or 0))
    cutoff = now() - quiet * 3600
    sessions = None
    found, skipped = [], []
    for item in items:
        record = item["record"] or {}
        if item["state"] != "IDLE" or set(item["holds"]) != {"NOT_RELEASED"} or not record.get("last_start"):
            continue
        reasons = policy_reasons(item, policy)
        wt = record.get("worktree")
        if not reasons and (not wt or not os.path.isdir(wt)):
            reasons = ["SOURCE_MISSING"]
        if not reasons:
            problem = coordination_problem(wt)
            reasons = [problem] if problem else []
        if not reasons:
            reasons = routine_source_problems(wt)
        if not reasons and max(_newest_mtime(wt), _newest_mtime(item["target"], skip=()),
                               _git_admin_mtime(wt)) >= cutoff:
            reasons = ["CHECKOUT_RECENTLY_USED"]
        if not reasons:
            if sessions is None:
                sessions = _recent_sessions(cutoff)
            names = {os.path.realpath(wt), os.path.normpath(wt), "~/" + os.path.basename(os.path.normpath(wt)),
                     os.path.basename(os.path.normpath(wt))}
            if _session_names(sessions, [n.encode() for n in names]):
                reasons = ["CHECKOUT_NAMED_BY_A_RECENT_SESSION"]
        (skipped.append((item, reasons)) if reasons else found.append(item))
    return found, skipped


def release_finished_tasks(policy, cycle_id):
    """Record the releases (`finish`, record only; nothing is deleted here).  Returns names."""
    _, items, _, _, _ = snapshot(policy)
    candidates, _ = finished_task_candidates(items, policy)
    done = []
    for item in candidates:
        owner = item["record"].get("owner")
        out = io.StringIO()
        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(out):
            try:
                rc = F.main(["finish", item["target"], *(["--owner", owner] if owner else []),
                             "--task", AUTO_RELEASE_TASK, "--note",
                             f"routine cycle {cycle_id}: source merged into main, clean, history preserved, "
                             f"no process, coordination row finished, quiet >= {AUTO_RELEASE_QUIET_HOURS:g} h"])
            except SystemExit as exit_:
                rc = exit_.code if isinstance(exit_.code, int) else 1
        if rc == 0:
            done.append(item["name"])
    if done:
        append_history({"event": "routine_release", "id": cycle_id, "released": done})
    return done


def classify(items, policy):
    """Attach `auto` = (eligible_for_auto, [reasons]) to every item."""
    for item in items:
        record = item["record"] or {}
        reasons = []
        st = item["state"]
        if st == "UNTRACKED":
            reasons.append("NO_LIFECYCLE_RECORD")
        elif not record.get("last_start"):
            reasons.append("NONPARTICIPATING")
        if st in ("IDLE",):
            reasons.append("NOT_RELEASED")
        if st != "RETIRABLE":
            reasons += [h for h in item["holds"] if h in EXPLANATIONS]
        else:
            reasons += policy_reasons(item, policy)
            wt = record.get("worktree")
            if not wt or not os.path.isdir(wt):
                reasons.append("SOURCE_MISSING")
            elif not reasons:
                reasons += routine_source_problems(wt)
        item["auto_reasons"] = sorted(set(reasons))
        item["auto_eligible"] = st == "RETIRABLE" and not item["auto_reasons"]
    return items


def snapshot(policy, args_extra=None):
    ns = make_args(policy, args_extra)
    registry, items, census, measured = F.collect(ns)
    classify(items, policy)
    summ = F.summary(items, ns, census)
    return ns, items, census, measured, summ


def artifacts_of(item):
    selected, preserved = F.select_artifacts(item["target"], None)
    for sel in selected:
        sel["target"] = item["target"]
    return selected, preserved


ONLY_NAME = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]{0,200}")


def parse_only(raw):
    """None when --only was not given; otherwise the validated tuple of requested target
    names.  Empty, malformed (anything but a bare registry name: no path separator, no
    wildcard) and duplicate selections raise ValueError, so a bad request never degrades
    into a smaller or automatic one."""
    if raw is None:
        return None
    if not raw:
        raise ValueError("--only given without a target name")
    names = []
    for name in raw:
        if not isinstance(name, str) or not ONLY_NAME.fullmatch(name):
            raise ValueError(f"--only: {name!r} is not a bare target name")
        if name in names:
            raise ValueError(f"--only: {name!r} given twice")
        names.append(name)
    return tuple(names)


def plan_only(policy, items, summ, census, only, base):
    """The explicit-selection plan: EXACTLY the requested targets or nothing.  Every name
    must match a current auto-eligible target with retirable artifacts, and the whole batch
    must fit the policy's per-cycle caps; otherwise the plan is refused as a whole.  It never
    substitutes, drops or adds a target."""
    def refuse(why):
        base["selected"], base["estimated_total"] = [], 0
        base["blocked"] = "ONLY_REFUSED: " + why
        return base
    by_name = {i["name"]: i for i in items}
    limits = (policy or {}).get("limits", {})
    picked, got = [], 0
    for name in only:
        item = by_name.get(name)
        if item is None:
            return refuse(f"{name} is not a known target")
        if not item["auto_eligible"]:
            return refuse(f"{name} is not eligible ({item.get('explanation') or ','.join(item.get('reasons') or [])})")
        selected, preserved = artifacts_of(item)
        est, retained = F.reclaim_estimate(selected) if selected else (0, 0)
        if not selected or est <= 0:
            return refuse(f"{name} has no retirable artifacts")
        picked.append({"item": item, "paths": selected, "preserved": preserved, "estimated": est})
        got += est
    if len(picked) > limits.get("max_targets_per_cycle", 10):
        return refuse(f"{len(picked)} targets exceed the per-cycle target cap")
    if got > limits.get("max_bytes_per_cycle", 100_000_000_000):
        return refuse(f"{got} estimated bytes exceed the per-cycle byte cap")
    picked.sort(key=lambda e: e["item"]["last_activity"] or 0)
    base["selected"], base["estimated_total"] = picked, got
    return base


def free_space_need(limits, free):
    """Bytes to reclaim for the free-space reserve.  Cleanup starts only when free space is
    below `reserve_trigger_free_bytes` (default: the reserve itself) and then aims to
    restore `reserve_free_bytes`; at or above the trigger the reserve asks for nothing."""
    reserve = limits.get("reserve_free_bytes", 0)
    trigger = limits.get("reserve_trigger_free_bytes", reserve)
    if free is None:   # free space unknown: never treat it as zero (the budget still applies)
        return 0
    return max(0, reserve - free) if free < trigger else 0


def plan_cycle(policy, items, summ, census, only=None):
    """Select eligible released targets, oldest inactive first, until the soft
    budget would be met, within the policy's per-cycle bounds.  With `only`, plan exactly
    the requested targets (see plan_only) under the same protections."""
    limits = policy["limits"] if policy else {}
    soft = limits.get("soft_budget_bytes", DEFAULT_SOFT)
    free_need = free_space_need(limits, summ.get("free_bytes"))
    need = max(0, summ["total_allocated"] - soft, free_need)
    plan = {"need_bytes": need, "free_space_need_bytes": free_need, "selected": [], "skipped": [], "blocked": None}
    if census.unreadable_foreign:
        plan["blocked"] = (
            f"INCOMPLETE_PROCESS_VISIBILITY: {census.unreadable_foreign} process(es) cannot be inspected; "
            "automatic retirement fails closed (run as root: sudo -n)"
        )
        return plan
    if need <= 0:
        plan["blocked"] = "UNDER_SOFT_BUDGET: nothing to reclaim"
        return plan
    if only is not None:
        return plan_only(policy, items, summ, census, only, plan)
    cands = sorted((i for i in items if i["auto_eligible"]), key=lambda i: i["last_activity"] or 0)
    max_t = limits.get("max_targets_per_cycle", 10)
    max_b = limits.get("max_bytes_per_cycle", 100_000_000_000)
    got = 0
    for item in cands:
        if got >= need or len(plan["selected"]) >= max_t:
            break
        selected, preserved = artifacts_of(item)
        if not selected:
            plan["skipped"].append({"name": item["name"], "reason": "NO_ARTIFACTS"})
            continue
        est, retained = F.reclaim_estimate(selected)
        if est <= 0:
            plan["skipped"].append({"name": item["name"], "reason": "NO_ARTIFACTS"})
            continue
        if got + est > max_b:
            # the per-cycle byte cap is an upper bound: a candidate that would cross it is
            # skipped (a younger, smaller one may still fit); oldest-first order is kept
            plan["skipped"].append({"name": item["name"], "reason": "BYTE_CAP_WOULD_BE_EXCEEDED",
                                    "estimated": est, "remaining_allowance": max(0, max_b - got)})
            continue
        plan["selected"].append({"item": item, "paths": selected, "preserved": preserved, "estimated": est})
        got += est
    plan["estimated_total"] = got
    return plan


def build_manifest(policy, plan, measured):
    groups = []
    for entry in plan["selected"]:
        item = entry["item"]
        target = item["target"]
        st = os.lstat(target)
        record = item["record"] or {}
        wt = record["worktree"]
        paths = []
        for sel in entry["paths"]:
            s = os.lstat(sel["path"])
            paths.append({"path": sel["path"], "device": s.st_dev, "inode": s.st_ino, "mode": s.st_mode})
        newest = (measured.get(target) or {}).get("newest_mtime") or 0
        groups.append({
            "directory": target, "disposition": "AUTO_POLICY", "category": "cargo_iso_cache",
            "allocated_bytes": item["allocated"], "estimated_reclaimable_bytes": entry["estimated"],
            "associated_source_paths": json.dumps([wt]), "source_head": F.head_of(wt),
            "source_exists": os.path.isdir(wt),
            "latest_mtime_utc": time.strftime("%Y-%m-%dT%H:%M:%S+00:00", time.gmtime(newest)),
            "deletion_paths_json": json.dumps(paths),
            "preserved_paths_json": json.dumps([p["path"] for p in entry["preserved"]]),
            "device": st.st_dev, "inode": st.st_ino,
            "reason": f"owner-approved automatic policy {policy['digest'][:12]}: released, idle, verified",
        })
    return {
        "mode": "AUTOMATIC_POLICY_CYCLE",
        "authorisation": {"policy_digest": policy["digest"], "approved_by": policy["approved_by"],
                          "approved_at": policy["approved_at"]},
        "created": now(),
        "cargo_artifact_groups": groups,
    }


def verify_manifest_against_policy(manifest, policy, plan=None):
    """The policy, not the manifest hash, is the authorisation: refuse any group
    the approved scope does not cover, a manifest naming another policy, and (given
    the plan) any group that was not selected by this cycle's own planning."""
    scope = policy["scope"]
    auth = manifest.get("authorisation") or {}
    if auth.get("policy_digest") != policy["digest"]:
        raise SystemExit("manifest does not name the approved policy digest; refusing")
    planned = None if plan is None else {e["item"]["target"] for e in plan["selected"]}
    for g in manifest["cargo_artifact_groups"]:
        d = g["directory"]
        if os.path.dirname(os.path.realpath(d)) != scope["target_root"] or os.path.realpath(d) != d:
            raise SystemExit(f"manifest group outside the approved policy scope: {d}")
        if planned is not None and d not in planned:
            raise SystemExit(f"manifest group was not selected by this cycle's plan: {d}")
        if g.get("disposition") != "AUTO_POLICY":
            raise SystemExit(f"manifest group has a disposition the policy does not grant: {d}")


# ------------------------------------------------------------- commands


def explain(item):
    return "; ".join(EXPLANATIONS.get(r, r) for r in item["auto_reasons"]) or "eligible"


def report(args, policy_state, policy, why):
    ns, items, census, measured, s = snapshot(policy)
    hist = read_history()
    last_ok = next((h for h in reversed(hist) if h.get("event") == "cycle" and h.get("outcome") in ("RETIRED", "PARTIAL")), None)
    reclaimed = sum(h.get("reclaimed_bytes", 0) for h in hist if h.get("event") == "cycle")
    elig = [i for i in items if i["auto_eligible"]]
    out = {
        "policy": {"state": policy_state, "why": why, "enabled": bool(policy and policy["enabled"]),
                   "digest": (policy or {}).get("digest")},
        "budgets": {"soft": ns.soft_budget, "hard": ns.hard_budget, "min_free_bytes": s["min_free_bytes"],
                    "min_idle_hours": ns.min_idle_hours,
                    "reserve_free_bytes": (policy or {}).get("limits", {}).get("reserve_free_bytes", 0)},
        "total_allocated": s["total_allocated"],
        "free_bytes": s["free_bytes"],
        "soft_exceeded": s["total_allocated"] > ns.soft_budget,
        "hard_exceeded": s["total_allocated"] > ns.hard_budget,
        "by_state": s["by_state"],
        "protected_allocated": s["protected_allocated"],
        "auto_eligible_targets": len(elig),
        "auto_eligible_allocated": sum(i["allocated"] for i in elig),
        "process_visibility": s["process_visibility"],
        "last_successful_cleanup": last_ok,
        "total_reclaimed_bytes": reclaimed,
        "targets": [
            {"name": i["name"], "state": i["state"], "allocated": i["allocated"], "owner": i["owner"],
             "worktree": i.get("worktree"), "task": (i.get("record") or {}).get("task"),
             "ownership_evidence": "lifecycle-record" if i.get("record") else
                                   "exact-source-path-hash" if i.get("inferred") else "unknown",
             "auto_eligible": i["auto_eligible"], "reasons": i["auto_reasons"], "explanation": explain(i)}
            for i in sorted(items, key=lambda i: -i["allocated"])
        ],
    }
    return out, items, census, measured, s


def write_usage(summary_, items):
    """Cache for the cargo-iso admission check; best effort, outside every cache."""
    try:
        ensure_state()
        # `total` is deliberately not written here: admission measures with quick_total
        # only, so a status/run can never change what admission sees.
        try:
            with open(usage_path()) as handle:
                usage = json.load(handle)
            if not isinstance(usage, dict):
                usage = {}
        except (OSError, ValueError):
            usage = {}
        usage.update({
            "status_at": now(), "status_total": summary_["total_allocated"],
            "auto_eligible_allocated": sum(i["allocated"] for i in items if i.get("auto_eligible")),
        })
        F.atomic_write(usage_path(), usage)
    except OSError:
        pass


def cmd_status(args):
    st, policy, why = load_policy()
    out, items, census, measured, s = report(args, st, policy, why)
    if os.path.isdir(state_dir()):
        write_usage(s, items)
    if args.json:
        print(json.dumps(out, indent=1, sort_keys=True))
        return 0
    p = out["policy"]
    print(f"EmuWiz Cargo maintenance: automatic retirement is "
          f"{'ENABLED' if p['enabled'] else 'DISABLED'} (policy {p['state']}{': ' + p['why'] if p['why'] else ''})")
    print(f"  total allocated     {gb(out['total_allocated'])}  soft {gb(out['budgets']['soft'])}"
          f"  hard {gb(out['budgets']['hard'])}"
          f"  [{'HARD EXCEEDED' if out['hard_exceeded'] else 'SOFT EXCEEDED' if out['soft_exceeded'] else 'within budget'}]")
    if out["free_bytes"] is not None:
        print(f"  free space          {gb(out['free_bytes'])} (build guard minimum {gb(out['budgets']['min_free_bytes'])})")
    for st_name, v in out["by_state"].items():
        print(f"  {st_name:<10} {v['targets']:>4} target(s)  {gb(v['allocated']):>11}")
    print(f"  protected floor     {gb(out['protected_allocated'])}")
    print(f"  auto-eligible now   {out['auto_eligible_targets']} target(s), {gb(out['auto_eligible_allocated'])} allocated")
    pv = out["process_visibility"]
    if pv["unreadable_foreign_uid"]:
        print(f"  process visibility  PARTIAL ({pv['unreadable_foreign_uid']} uninspectable): automatic retirement would fail closed")
    lc = out["last_successful_cleanup"]
    print("  last cleanup        " + (f"{time.strftime('%Y-%m-%d %H:%M', time.localtime(lc['at']))}  reclaimed "
                                      f"{gb(lc.get('reclaimed_bytes', 0))}" if lc else "none"))
    print(f"  total reclaimed     {gb(out['total_reclaimed_bytes'])}")
    held = [t for t in out["targets"] if not t["auto_eligible"] and t["state"] in ("RELEASED", "RETIRABLE", "IDLE", "UNTRACKED")]
    print(f"  held targets ({len(held)}):")
    for t in held[:12]:
        print(f"    {gb(t['allocated']):>11}  {t['state']:<9} {t['name']}\n                           -> {t['explanation']}")
    if len(held) > 12:
        print(f"    ... {len(held) - 12} more (use --json)")
    return 0


def cmd_plan(args):
    try:
        only = parse_only(getattr(args, "only", None))
    except ValueError as error:
        print(f"REFUSED: {error}")
        return 1
    st, policy, why = load_policy()
    ns, items, census, measured, s = snapshot(policy)
    plan = plan_cycle(policy, items, s, census, only)
    refused = 1 if only is not None and (plan["blocked"] or "").startswith("ONLY_REFUSED") else 0
    res = {
        "mode": "DRY RUN: nothing is deleted",
        "policy_state": st,
        "policy_enabled": bool(policy and policy["enabled"]),
        "total_allocated": s["total_allocated"],
        "soft_budget": ns.soft_budget,
        "need_bytes": plan["need_bytes"],
        "free_bytes": s.get("free_bytes"),
        "free_space_need_bytes": plan.get("free_space_need_bytes", 0),
        "blocked": plan["blocked"],
        "selected": [{"name": e["item"]["name"], "target": e["item"]["target"], "allocated": e["item"]["allocated"],
                      "estimated_recoverable": e["estimated"], "paths": len(e["paths"]),
                      "last_activity_age": F.age_text(e["item"]["last_activity"])} for e in plan["selected"]],
        "skipped": plan["skipped"],
        "estimated_total": plan.get("estimated_total", 0),
    }
    if args.output:
        F.atomic_write(args.output, res)
    if args.json:
        print(json.dumps(res, indent=1, sort_keys=True))
        return refused
    print("DRY RUN - nothing is deleted.")
    print(f"  allocated {gb(res['total_allocated'])}; soft budget {gb(res['soft_budget'])}; need {gb(res['need_bytes'])}")
    if res["blocked"]:
        print(f"  no selection: {res['blocked']}")
    for e in res["selected"]:
        print(f"  WOULD RETIRE {e['name']}: {e['paths']} artifact path(s), ~{gb(e['estimated_recoverable'])}, idle {e['last_activity_age']}")
    print(f"  estimated recoverable {gb(res['estimated_total'])}")
    if st != "ok" or not res["policy_enabled"]:
        print("  note: a cycle would NOT delete anything (policy absent, invalid or disabled)")
    return refused


def routine_recheck(policy):
    """The executor's in-process routine authority (see ROUTINE_AUTHORITY): called under the
    target's lifecycle lock immediately before deletion.  None, or why it is not routine."""
    def check(group):
        target = group.get("directory")
        st, current, why = load_policy()
        if st != "ok" or not current["enabled"] or current["digest"] != policy["digest"]:
            return f"the policy is no longer the enabled one this cycle started under ({why or 'changed'})"
        if os.path.dirname(target) != current["scope"]["target_root"]:
            return "outside the policy root"
        _, record = F.Registry(create=False).read_checked("targets", F.key_for(target), F.valid_target_record)
        record = record or {}
        if record.get("owner") not in current["scope"]["owners"]:
            return "owner not covered by the policy"
        wt = record.get("worktree")
        if not wt or not os.path.isdir(wt):
            return "source checkout missing"
        if F.head_of(wt) != group.get("source_head"):
            return "the source HEAD changed since the plan"
        problems = routine_source_problems(wt)
        return ", ".join(problems) if problems else None
    return check


def run_executor(manifest_path, digest, receipts, scoped_run=None, policy=None):
    argv = ["--manifest", manifest_path, "--approved-sha256", digest, "--receipt-dir", receipts, "--execute", "--json"]
    argv += ["--scoped-run", scoped_run] if scoped_run else ["--routine"]
    X = executor()
    X.ROUTINE_AUTHORITY = None if scoped_run else routine_recheck(policy)
    # No --maintenance-window-attested: only participating (cargo-iso) targets can pass.
    out, err = io.StringIO(), io.StringIO()
    saved = {sig: signal.getsignal(sig) for sig in (signal.SIGTERM, signal.SIGHUP, signal.SIGINT)}
    with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
        try:
            rc = executor().main(argv)
        except SystemExit as exit_:
            rc = exit_.code if isinstance(exit_.code, int) else 1
            err.write(str(exit_.code))
        finally:
            X.ROUTINE_AUTHORITY = None
            for sig, handler in saved.items():   # the executor installs its own handlers in-process
                signal.signal(sig, handler)
    try:
        return rc, json.loads(out.getvalue()), err.getvalue()
    except ValueError:
        return rc, None, err.getvalue() + out.getvalue()


def file_sha256(path):
    digest = hashlib.sha256()
    with open(path, "rb") as handle:
        for chunk in iter(lambda: handle.read(1 << 20), b""):
            digest.update(chunk)
    return digest.hexdigest()


def mark_retired(registry, item, freed, receipt):
    """Record where the evidence is and what it hashed to when it was written, so the
    worktree gate can later check provenance (structural: see verify_retirement)."""
    key = item["key"]
    receipt_file = receipt.get("receipt_file")
    journal_file = receipt.get("journal_file")
    try:
        st = os.lstat(item["target"])
        identity = {"dev": st.st_dev, "ino": st.st_ino}
    except OSError:
        identity = None
    meta = registry.meta_lock()
    try:
        state, record = registry.read_checked("targets", key, F.valid_target_record)
        if state != "ok":
            return
        try:
            receipt_sha = file_sha256(receipt_file) if receipt_file else None
            journal_sha = file_sha256(journal_file) if journal_file else None
        except OSError:
            receipt_sha = journal_sha = None
        record["last_retired"] = {
            "at": now(), "bytes": freed, "receipt": receipt_file, "receipt_sha256": receipt_sha,
            "journal": journal_file, "journal_sha256": journal_sha,
            "manifest_sha256": receipt.get("manifest_sha256"), "identity": identity,
        }
        F.atomic_write(registry.path("targets", key), record)
    finally:
        meta.close()


def refusal_summary(receipt):
    """Actionable one-line reason when the executor refused the whole cycle, else None.
    Reporting only: a cleanly self-interrupted run reconciles on restart, but any other
    incomplete journal blocks until a person reviews it with --resolve-journal."""
    refused = (receipt or {}).get("refused")
    if not refused:
        return None
    text = f"{refused.get('code')}: {refused.get('detail')}"
    if refused.get("code") == "INCOMPLETE_JOURNAL_PRESENT":
        text += " (retention stays blocked until a person reviews it; this is not a policy problem)"
    return text


def revoke_stale_enablement():
    """A stored ENABLED record for code that is no longer running is REVOKED (a DISABLED
    transition at a new generation), so rolling back to the bytes that were once enabled
    (A -> B -> A) cannot revive an old approval.  Returns True when it revoked one."""
    state, policy, why = load_policy()
    if state != "ok" or policy["enabled"]:
        return False
    rec = read_state_record(trusted_policy_uids())
    if not (rec and rec["state"] == "ENABLED" and rec["policy_digest"] == policy["digest"]
            and rec.get("code_sha256") != code_fingerprint()):
        return False
    with transition_lock():
        state, policy, why = load_policy()
        rec = read_state_record(trusted_policy_uids())
        if state != "ok" or policy["enabled"] or not (rec and rec["state"] == "ENABLED"
                                                    and rec.get("code_sha256") != code_fingerprint()):
            return False
        gen = next_generation()
        write_policy(dict(policy, enabled=False))
        record_transition("policy_disabled", gen, policy["digest"], "DISABLED", revoked="code changed since enable")
    return True


def cmd_run(args):
    """One maintenance cycle.

    Linearisation point: a destructive cycle holds the policy-transition lock from the
    moment it re-reads authority until the executor has returned.  `policy disable`,
    `enable` and `approve` take the same lock, so (a) none of them returns while an
    executor transaction is running (they wait, and say so; the transaction is never
    interrupted, which would break its journal), and (b) once one has returned, a cycle
    that starts afterwards re-reads the new state under the lock and cannot delete.
    Authority is checked again immediately before the executor is entered."""
    try:
        args.only_names = parse_only(getattr(args, "only", None))
    except ValueError as error:
        if not args.dry_run:
            append_history({"event": "cycle", "id": time.strftime("%Y%m%dT%H%M%S", time.gmtime(now())) + f"-{os.getpid()}",
                            "outcome": "REFUSED", "why": str(error)})
        print(f"REFUSED: {error}")
        return 1
    cycle_id = time.strftime("%Y%m%dT%H%M%S", time.gmtime(now())) + f"-{os.getpid()}"
    temporary = getattr(args, "enable_for_cycle", False)
    if temporary and args.dry_run:
        print("REFUSED: --enable-for-cycle cannot be combined with --dry-run")
        return EXIT_REFUSED
    if getattr(args, "scoped_run", None) and args.only_names is None:
        print("REFUSED: --scoped-run needs --only with exactly the record's target names; nothing was retired")
        return EXIT_REFUSED
    if temporary and not getattr(args, "scoped_run", None):
        # DISABLED is the owner's off switch: only an owner-signed exact batch may lift it for one
        # cycle.  Routine retirement runs only while the policy is enabled through `policy enable`.
        print("REFUSED: --enable-for-cycle needs --only and an owner-signed --scoped-run; nothing was retired")
        return EXIT_REFUSED
    if not args.dry_run and revoke_stale_enablement():
        print("revoked a stored enablement that belonged to different code; `policy enable` is required again")
    st, policy, why = load_policy()
    if st == "invalid":
        append_history({"event": "cycle", "id": cycle_id, "outcome": "REFUSED", "why": why})
        print(f"REFUSED: automatic retirement policy is invalid ({why})")
        return 1
    if temporary:
        return temporary_cycle(args, cycle_id)
    if args.dry_run or not (policy and policy["enabled"]):
        return plan_only_cycle(args, policy, cycle_id)      # deletes nothing (exit 75 when not a dry run)
    # ROUTINE (no --scoped-run): only targets every safety gate accepts, with merged and
    # preserved sources; EXCEPTIONAL (--scoped-run): the owner-signed exact batch
    try:
        with transition_lock(wait=False):
            return locked_cycle(args, cycle_id)
    except ConcurrentMaintenance as error:
        print(f"REFUSED: {error}; nothing was retired")
        return EXIT_REFUSED


EXIT_REFUSED = 1
EXIT_DISABLED = 75          # EX_TEMPFAIL: nothing was deleted because the policy is disabled
EXIT_RESTORE_FAILED = 70    # EX_SOFTWARE: the temporary enablement could not be restored to DISABLED
TEMP_ENABLE_MARKER = "temporary-enable.json"


class TerminatedDuringCycle(BaseException):
    pass


def _raise_terminated(signum, frame):
    raise TerminatedDuringCycle(signum)


def temporary_enable_lock():
    """fd holding the exclusive temporary-enablement lock, or None when another process holds it."""
    ensure_state()
    fd = os.open(os.path.join(state_dir(), ".temporary-enable.lock"), os.O_RDWR | os.O_CREAT | os.O_CLOEXEC, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        os.close(fd)
        return None
    return fd


def recover_stale_temporary_enable():
    """Crash recovery.  A temporary cycle writes the marker BEFORE enabling and removes it
    only after restoring DISABLED, holding the temporary-enable lock throughout.  A marker
    whose lock is free therefore belongs to a cycle that died (SIGKILL, power loss): disable
    the policy before anything else.  Returns "NONE", "LIVE" (a cycle is running) or
    "RECOVERED"; raises if recovery itself fails (callers must not proceed)."""
    marker = os.path.join(state_dir(), TEMP_ENABLE_MARKER)
    if not os.path.lexists(marker):
        return "NONE"
    try:
        with open(marker) as handle:
            if json.load(handle).get("state") == "RESTORED":
                return "NONE"
    except (OSError, ValueError):
        pass                                   # unreadable marker: treat as ACTIVE (fail safe: disable)
    fd = temporary_enable_lock()
    if fd is None:
        return "LIVE"
    try:
        with transition_lock():
            st, policy, why = load_policy()
            if st == "ok" and (policy["enabled"] or (read_state_record(trusted_policy_uids()) or {}).get("state") == "ENABLED"):
                set_enabled_locked(policy, False, reason="stale temporary enablement recovered")
            elif st not in ("ok", "absent"):
                raise SystemExit(f"stale temporary enablement found but the policy is unreadable ({why}); "
                                 "disable it by hand before any maintenance command")
            durable_write(marker, {"state": "RESTORED", "at": now(), "recovered": True})
        print("emuwiz-cargo-maintain: recovered a temporary enablement left by an interrupted cycle; "
              "the policy is DISABLED", file=sys.stderr)
        return "RECOVERED"
    finally:
        os.close(fd)


def temporary_cycle(args, cycle_id):
    """Enable the (DISABLED) policy for exactly one approved, exact-name cycle and restore
    DISABLED afterwards: on success, refusal, exception and SIGTERM/SIGHUP/SIGINT (in a
    finally), and after SIGKILL or power loss by recover_stale_temporary_enable on the next
    run.  Those signals are blocked from before the marker is written until the restoring
    try/finally is in force, so no interruption window can leave the policy ENABLED.
    Exit EXIT_RESTORE_FAILED if the restoration itself fails."""
    lock = temporary_enable_lock()
    if lock is None:
        print("REFUSED: another temporary maintenance cycle is running; nothing was retired")
        return EXIT_REFUSED
    signals = (signal.SIGTERM, signal.SIGHUP, signal.SIGINT)
    old = {sig: signal.signal(sig, _raise_terminated) for sig in signals}
    marker = os.path.join(state_dir(), TEMP_ENABLE_MARKER)
    try:
        try:
            with transition_lock(wait=False):
                st, policy, why = load_policy()
                if st != "ok":
                    print(f"REFUSED: policy unavailable ({why})")
                    return EXIT_REFUSED
                if policy["enabled"]:
                    print("REFUSED: --enable-for-cycle needs a DISABLED policy; nothing was retired")
                    return EXIT_REFUSED
                rc = EXIT_REFUSED
                signal.pthread_sigmask(signal.SIG_BLOCK, signals)
                try:
                    durable_write(marker, {"state": "ACTIVE", "pid": os.getpid(), "cycle": cycle_id, "at": now(),
                                           "digest": policy["digest"]})
                    set_enabled_locked(policy, True, temporary=cycle_id)
                    signal.pthread_sigmask(signal.SIG_UNBLOCK, signals)   # a pending signal lands here, inside try
                    rc = locked_cycle(args, cycle_id)
                except TerminatedDuringCycle:
                    rc = 143
                    print("interrupted by a signal; restoring DISABLED", file=sys.stderr)
                finally:
                    signal.pthread_sigmask(signal.SIG_BLOCK, signals)
                    try:
                        st2, policy2, _ = load_policy()
                        set_enabled_locked(policy2 if st2 == "ok" else policy, False, temporary=cycle_id, restored=True)
                        durable_write(marker, {"state": "RESTORED", "at": now(), "cycle": cycle_id})
                    except BaseException as error:  # noqa: BLE001 - must be loud, never silent
                        print(f"RESTORE FAILED: the policy may still be ENABLED ({error}); the next maintenance "
                              "command will disable it before doing anything else", file=sys.stderr)
                        rc = EXIT_RESTORE_FAILED
                    finally:
                        signal.pthread_sigmask(signal.SIG_UNBLOCK, signals)
                return rc
        except ConcurrentMaintenance as error:
            print(f"REFUSED: {error}; nothing was retired")
            return EXIT_REFUSED
        except TerminatedDuringCycle:
            return 143                     # before anything was enabled, or after it was restored
    finally:
        for sig, handler in old.items():
            signal.signal(sig, handler)
        os.close(lock)


def plan_only_cycle(args, policy, cycle_id):
    ns, items, census, measured, s = snapshot(policy)
    would_release, release_skipped = [], {}
    if policy and getattr(args, "only_names", None) is None and not census.unreadable_foreign:
        candidates, skipped = finished_task_candidates(items, policy)
        for item, reasons in skipped:
            release_skipped.setdefault(reasons[0], []).append(item["name"])
        for item in candidates:              # what a real routine cycle would release first
            item["auto_eligible"], item["would_release"] = True, True
            would_release.append(item["name"])
    plan = plan_cycle(policy, items, s, census, getattr(args, "only_names", None))
    selected = plan["selected"]
    write_usage(s, items)
    mode = "dry-run" if args.dry_run else "disabled"
    append_history({"event": "cycle", "id": cycle_id, "outcome": "DRY_RUN" if args.dry_run else "DISABLED",
                    "would_select": [e["item"]["name"] for e in selected], "would_release": would_release, "release_skipped": release_skipped,
                    "would_reclaim_bytes": plan.get("estimated_total", 0), "blocked": plan["blocked"]})
    print(f"{mode}: automatic retirement did not delete anything "
          f"(would select {len(selected)} target(s), ~{gb(plan.get('estimated_total', 0))}"
          f"{'; ' + plan['blocked'] if plan['blocked'] else ''}"
          f"{f'; would first release {len(would_release)} verified finished task(s)' if would_release else ''})")
    return 0 if args.dry_run else EXIT_DISABLED


def batch_identity(manifest):
    """What an explicit batch is: which targets, and exactly which artifact paths (with
    device and inode) each would delete.  Sizes and timestamps are deliberately excluded."""
    return sorted((g["directory"], g["device"], g["inode"], g["deletion_paths_json"])
                  for g in manifest["cargo_artifact_groups"])


def authority_snapshot(policy):
    """(digest, generation) of the authority a cycle is acting under, or None."""
    rec = read_state_record(trusted_policy_uids())
    return (policy["digest"], rec["generation"]) if rec else None


def locked_cycle(args, cycle_id):
    st, policy, why = load_policy()                      # re-read under the lock
    if st != "ok":
        append_history({"event": "cycle", "id": cycle_id, "outcome": "REFUSED", "why": why})
        print(f"REFUSED: automatic retirement policy is not valid ({why})")
        return 1
    if not policy["enabled"]:
        return plan_only_cycle(args, policy, cycle_id)   # disabled before the cycle began
    authority = authority_snapshot(policy)
    only = getattr(args, "only_names", None)
    if not getattr(args, "scoped_run", None) and only is None:
        released = release_finished_tasks(policy, cycle_id)
        if released:
            print(f"released {len(released)} verified finished task(s): {', '.join(released)}")
    ns, items, census, measured, s = snapshot(policy)
    plan = plan_cycle(policy, items, s, census, only)
    selected = plan["selected"]
    write_usage(s, items)
    if only is not None and (plan["blocked"] or {e["item"]["name"] for e in selected} != set(only)):
        why = plan["blocked"] or "the requested membership is not exactly plannable"
        append_history({"event": "cycle", "id": cycle_id, "outcome": "REFUSED", "why": why, "only": list(only)})
        print(f"REFUSED: {why}")
        return 1
    if plan["blocked"] or not selected:
        append_history({"event": "cycle", "id": cycle_id, "outcome": "NOTHING_TO_DO",
                        "why": plan["blocked"] or "no eligible released targets", "total_allocated": s["total_allocated"]})
        print(f"nothing to do: {plan['blocked'] or 'no eligible released targets'}")
        return 0
    ensure_state()
    manifest = build_manifest(policy, plan, measured)
    verify_manifest_against_policy(manifest, policy, plan)
    scoped_run = getattr(args, "scoped_run", None)
    if scoped_run:
        try:
            mpath, digest, signed = signed_manifest_for(scoped_run, manifest)
        except executor().Refusal as refusal:
            append_history({"event": "cycle", "id": cycle_id, "outcome": "REFUSED", "only": list(only),
                            "why": f"{refusal.code}: {refusal.detail}"})
            print(f"REFUSED: {refusal.code}: {refusal.detail}; nothing was retired")
            return EXIT_REFUSED
        manifest = signed
    else:
        mpath = os.path.join(state_dir(), "manifests", f"cycle-{cycle_id}.json")
        F.atomic_write(mpath, manifest)
    with open(mpath, "rb") as handle:
        digest = hashlib.sha256(handle.read()).hexdigest()
    append_history({"event": "cycle_start", "id": cycle_id, "manifest": mpath, "manifest_sha256": digest,
                    "policy_digest": policy["digest"], "generation": authority[1] if authority else None,
                    "targets": [e["item"]["name"] for e in selected]})
    if only is not None:
        # an explicit batch is all-or-nothing: plan it again from a fresh snapshot and require the
        # same members with the same artifact identities before the executor can be entered
        try:
            ns2, items2, census2, measured2, s2 = snapshot(policy)
            plan2 = plan_cycle(policy, items2, s2, census2, only)
            changed = plan2["blocked"] or (
                batch_identity(build_manifest(policy, plan2, measured2)) != batch_identity(manifest)
                and "the requested batch changed since it was planned")
        except OSError as error:           # an artifact vanished between the two plans
            changed = f"the requested batch changed since it was planned ({error.strerror})"
        if changed:
            append_history({"event": "cycle", "id": cycle_id, "outcome": "REFUSED", "only": list(only),
                            "why": changed})
            print("REFUSED: the requested batch changed before the executor was entered; nothing was retired")
            return 1
    # final revalidation, immediately before the destructive executor is entered
    st2, policy2, why2 = load_policy()
    if st2 != "ok" or not policy2["enabled"] or authority_snapshot(policy2) != authority:
        append_history({"event": "cycle", "id": cycle_id, "outcome": "REFUSED",
                        "why": "policy changed, replaced or lost approval before the executor was entered"})
        print("REFUSED: policy changed, replaced or lost approval before the executor was entered")
        return 1
    receipts = os.path.join(state_dir(), "receipts")
    rc, receipt, err = run_executor(mpath, digest, receipts, scoped_run, policy2)
    registry = F.Registry(create=True)
    outcome = "FAILED"
    reclaimed = 0
    per_target = []
    if receipt is not None:
        by_dir = {g["directory"]: g for g in receipt.get("groups", [])}
        reclaimed = receipt["totals"].get("accounted_freed_bytes", 0)
        for e in selected:
            g = by_dir.get(e["item"]["target"], {})
            per_target.append({"name": e["item"]["name"], "outcome": g.get("outcome"),
                               "freed": g.get("accounted_freed_bytes", 0),
                               "holds": [h["code"] for h in g.get("holds", [])],
                               "hold_details": g.get("holds", [])})
            # owner-signed executions are recorded by the executor (route OWNER_SIGNED); a
            # routine cycle records its fully RETIRED targets here (the automatic-cycle route)
            if not scoped_run and g.get("outcome") == "RETIRED" and g.get("accounted_freed_bytes", 0):
                mark_retired(registry, e["item"], g["accounted_freed_bytes"], receipt)
        outs = {t["outcome"] for t in per_target}
        outcome = ("RETIRED" if outs == {"RETIRED"} else "PARTIAL" if outs & {"RETIRED", "PARTIAL"} else
                   "HELD" if outs <= {"HELD", None} else "PARTIAL")
        if receipt.get("refused"):
            outcome = "REFUSED"
    batch = None
    if only is not None:
        done = [t["name"] for t in per_target if t["outcome"] == "RETIRED"]
        batch = {"requested": list(only), "retired": done, "remaining": [n for n in only if n not in done],
                 "atomic": False, "reclaimed_bytes": reclaimed}
    append_history({"event": "cycle", "id": cycle_id, "outcome": outcome, "rc": rc, "batch": batch,
                    "reclaimed_bytes": reclaimed, "targets": per_target,
                    "journal": (receipt or {}).get("journal_file"), "receipt": (receipt or {}).get("receipt_file"),
                    "refusal": refusal_summary(receipt), "stderr": (err or "")[-400:]})
    print(f"cycle {cycle_id}: {outcome}; reclaimed {gb(reclaimed)}; executor rc={rc}")
    if refusal_summary(receipt):
        print(f"  REFUSAL {refusal_summary(receipt)}")
    for t in per_target:
        print(f"  {t['name']}: {t['outcome']} {gb(t['freed'])} {','.join(t['holds'])}")
    if batch:
        print(f"  explicit batch (NOT atomic): {len(batch['retired'])} of {len(only)} fully retired, "
              f"{gb(reclaimed)} actually reclaimed; remaining: {', '.join(batch['remaining']) or 'none'}")
    if batch and batch["remaining"] and rc == 0:
        return 1                           # an explicit batch that did not fully complete is never exit 0
    return 0 if outcome in ("RETIRED", "HELD", "PARTIAL") and rc == 0 else (rc or 1)


def cmd_history(args):
    hist = [h for h in read_history() if h.get("event") in ("cycle", "policy_approved", "policy_enabled", "policy_disabled")]
    if args.json:
        print(json.dumps(hist, indent=1, sort_keys=True))
        return 0
    for h in hist:
        when = time.strftime("%Y-%m-%d %H:%M", time.localtime(h["at"]))
        if h["event"] == "cycle":
            print(f"{when}  cycle {h.get('id')}  {h.get('outcome')}  reclaimed {gb(h.get('reclaimed_bytes', 0))}")
        else:
            print(f"{when}  {h['event']}")
    return 0


# ----------------------------------------------- task completion workflow


def target_for_worktree(path):
    """The directory scripts/cargo-iso builds this worktree into."""
    wt = os.path.realpath(path)
    name = F.sanitized(os.path.basename(wt))
    digest = hashlib.sha256(wt.encode()).hexdigest()[:12]
    return wt, os.path.join(F.target_root(), f"{name}-{digest}")


def trusted_history_events(trusted):
    """Events from the current history and any rotated (`.unreconciled-*`) logs, each read
    only if it is a safe authority file; unreadable files contribute nothing."""
    names = [history_path()]
    try:
        names += sorted(os.path.join(state_dir(), n) for n in os.listdir(state_dir())
                        if n.startswith("history.jsonl.unreconciled-"))
    except OSError:
        pass
    out = []
    for path in names:
        text = read_trusted_text(path, trusted)
        for line in (text or "").splitlines():
            try:
                value = json.loads(line)
            except ValueError:
                continue
            if isinstance(value, dict):
                out.append(value)
    return out


def _read_json_file(path):
    with open(path) as handle:
        return json.load(handle)


def verify_retirement(record, target):
    """(ok, why): the recorded retirement is backed by canonical, structurally consistent
    evidence.  Checks: receipt, journal and manifest live directly in the registry's
    receipts/manifests directories (no symlink, trusted owner, not group/world writable);
    the recorded SHA-256 of receipt and journal still match; the receipt is a successful
    EXECUTE with no refusal/interruption, no attestation, and names this target with a
    RETIRED/PARTIAL outcome; the journal has begin (same manifest/exec) -> group_plan for
    this directory and its identity -> end; the manifest file is the one executed and a
    `cycle_start` event with the same manifest digest exists in the history; and the
    target directory is still the one retired.  This is STRUCTURAL verification: the
    digests are unkeyed, so an attacker who controls the approving account could forge a
    consistent set.  It rejects accidents, stale or foreign files and casual edits."""
    global _EVIDENCE_STATE_DIR
    trusted = trusted_policy_uids()
    directory, why = evidence_state_dir(record, target, trusted)
    if directory is None:
        return False, why
    previous, _EVIDENCE_STATE_DIR = _EVIDENCE_STATE_DIR, directory
    try:
        return _verify_retirement_in(record, target, trusted)
    finally:
        _EVIDENCE_STATE_DIR = previous


def _verify_retirement_in(record, target, trusted):
    last = record.get("last_retired") or {}
    if last.get("route") == "OWNER_SIGNED":
        return _verify_signed_in(record, target, trusted)
    receipts, manifests = os.path.join(state_dir(), "receipts"), os.path.join(state_dir(), "manifests")
    for d in (state_dir(), receipts, manifests):
        ok, why = _trusted_file(d, trusted, want_dir=True)
        if not ok:
            return False, why

    def canonical(path, directory, suffix=None):
        if not isinstance(path, str) or os.path.normpath(path) != path or os.path.dirname(path) != directory:
            return False, "evidence path is not directly inside the canonical evidence directory"
        if suffix and not path.endswith(suffix):
            return False, "evidence file has an unexpected name"
        return _trusted_file(path, trusted)

    try:
        ok, why = canonical(last.get("receipt"), receipts, ".json")
        if not ok:
            return False, why
        journal_suffix = executor().JOURNAL_SUFFIX
        ok, why = canonical(last.get("journal"), receipts, journal_suffix)
        if not ok:
            return False, why
        if file_sha256(last["receipt"]) != last.get("receipt_sha256") or \
                file_sha256(last["journal"]) != last.get("journal_sha256"):
            return False, "evidence was modified after it was recorded"
        receipt = _read_json_file(last["receipt"])
        if receipt.get("mode") != "EXECUTE" or receipt.get("refused") or receipt.get("interrupted"):
            return False, "receipt does not describe a completed execution"
        if (receipt.get("policy") or {}).get("maintenance_window_attested"):
            return False, "receipt is from an attested manual window, not an automatic cycle"
        msha = receipt.get("manifest_sha256")
        if not msha or msha != receipt.get("approved_sha256") or msha != last.get("manifest_sha256"):
            return False, "manifest identity disagrees between receipt and record"
        if receipt.get("journal_file") != last["journal"]:
            return False, "receipt names a different journal"
        groups = [g for g in receipt.get("groups", []) if g.get("directory") == target]
        if len(groups) != 1 or groups[0].get("outcome") not in ("RETIRED", "PARTIAL"):
            return False, "receipt has no successful outcome for this target"
        manifest_path = receipt.get("manifest")
        ok, why = canonical(manifest_path, manifests, ".json")
        if not ok:
            return False, why
        if file_sha256(manifest_path) != msha:
            return False, "the executed manifest no longer matches its digest"
        manifest = _read_json_file(manifest_path)
        if manifest.get("mode") != "AUTOMATIC_POLICY_CYCLE" or not any(
                g.get("directory") == target for g in manifest.get("cargo_artifact_groups", [])):
            return False, "manifest does not authorise this target"
        events = []
        with open(last["journal"]) as handle:
            for line in handle:
                if line.strip():
                    events.append(json.loads(line))
        kinds = [e.get("event") for e in events]
        if not events or kinds[0] != "begin" or events[0].get("manifest_sha256") != msha or \
                "interrupted" in kinds or "receipt_publication_failed" in kinds or kinds[-1] != "end":
            return False, "journal is not a complete, matching execution"
        st = os.lstat(target)
        plans = [e for e in events if e.get("event") == "group_plan" and e.get("directory") == target]
        if len(plans) != 1 or (plans[0].get("device"), plans[0].get("inode")) != (st.st_dev, st.st_ino):
            return False, "journal does not match this directory's identity"
        ident = last.get("identity")
        if ident and (ident.get("dev"), ident.get("ino")) != (st.st_dev, st.st_ino):
            return False, "directory was replaced after retirement"
        if not any(h.get("event") == "cycle_start" and h.get("manifest_sha256") == msha
                   and os.path.basename(target) in (h.get("targets") or []) for h in trusted_history_events(trusted)):
            return False, "no matching cycle in the maintenance history"
    except (OSError, ValueError, TypeError, KeyError, AttributeError) as error:
        return False, f"evidence unreadable or inconsistent ({type(error).__name__})"
    return True, ""


def _journal_events(path):
    events = []
    with open(path) as handle:
        for line in handle:
            if line.strip():
                events.append(json.loads(line))
    return events


def _complete_journal(events, msha):
    kinds = [e.get("event") for e in events]
    return bool(events) and kinds[0] == "begin" and events[0].get("manifest_sha256") == msha and \
        "interrupted" not in kinds and "receipt_publication_failed" not in kinds and kinds[-1] == "end"


def _verify_signed_in(record, target, trusted):
    """An OWNER_SIGNED execution: receipt and journal canonical and unchanged; the scoped-run
    record canonical, unchanged and consumed by THIS execution; the receipt says the owner
    signature verified; the record and the journal name this directory with the identity it
    still has; the manifest is the one signed; the outcome is a complete RETIRED."""
    X = executor()
    last = record["last_retired"]
    receipts = os.path.join(state_dir(), "receipts")
    scoped_dir = os.path.join(state_dir(), "scoped-runs")
    for d in (state_dir(), receipts, scoped_dir):
        ok, why = _trusted_file(d, trusted, want_dir=True)
        if not ok:
            return False, why
    try:
        for key, directory in (("receipt", receipts), ("journal", receipts), ("scoped_run", scoped_dir)):
            path = last.get(key)
            if not isinstance(path, str) or os.path.normpath(path) != path or os.path.dirname(path) != directory:
                return False, f"{key} is not directly inside the canonical evidence directory"
            ok, why = _trusted_file(path, trusted)
            if not ok:
                return False, why
            if file_sha256(path) != last.get(key + "_sha256"):
                return False, f"{key} was modified after it was recorded"
        receipt = _read_json_file(last["receipt"])
        if receipt.get("mode") != "EXECUTE" or receipt.get("refused") or receipt.get("interrupted"):
            return False, "receipt does not describe a completed execution"
        msha = receipt.get("manifest_sha256")
        if not msha or msha != receipt.get("approved_sha256") or msha != last.get("manifest_sha256"):
            return False, "manifest identity disagrees between receipt and record"
        rs = receipt.get("scoped_run") or {}
        if rs.get("path") != last["scoped_run"] or rs.get("sha256") != last.get("scoped_run_sha256") \
                or rs.get("owner_signature") != "VERIFIED":
            return False, "receipt names a different or unsigned scoped-run record"
        if receipt.get("journal_file") != last["journal"]:
            return False, "receipt names a different journal"
        groups = [g for g in receipt.get("groups", []) if g.get("directory") == target]
        if len(groups) != 1 or groups[0].get("outcome") != "RETIRED":
            return False, "receipt has no complete RETIRED outcome for this target"
        scoped = _read_json_file(last["scoped_run"])
        if scoped.get("kind") != X.SCOPED_KIND or scoped.get("target_root") != os.path.dirname(target) \
                or scoped.get("manifest_sha256") != msha or scoped.get("nonce") != rs.get("nonce"):
            return False, "scoped-run record does not match this target's root, manifest or receipt"
        events = _journal_events(last["journal"])
        if not _complete_journal(events, msha) or (events[0].get("scoped_run") or {}).get("sha256") != rs.get("sha256"):
            return False, "journal is not a complete, matching signed execution"
        consumed = X.consumed_path(last["scoped_run"])
        ok, why = _trusted_file(consumed, trusted)
        if not ok or json.loads(open(consumed).read()).get("exec_id") != events[0].get("exec_id"):
            return False, "the scoped-run record was not consumed by this execution"
        # the stored "VERIFIED" is not evidence: verify the owner's signature again, now,
        # against the trust anchor, and require the same signer the receipt recorded
        try:
            with open(last["scoped_run"], "rb") as handle:
                record_bytes = handle.read()
            facts = X.verify_owner_signature(last["scoped_run"], record_bytes)
        except X.Refusal as refusal:
            return False, f"the owner signature does not verify now ({refusal.code})"
        if facts["signer_fingerprint"] != rs.get("signer_fingerprint") \
                or hashlib.sha256(record_bytes).hexdigest() != last.get("scoped_run_sha256"):
            return False, "the owner signature or signer differs from the one the receipt recorded"
        st = os.lstat(target)
        plans = [e for e in events if e.get("event") == "group_plan" and e.get("directory") == target]
        if len(plans) != 1 or (plans[0].get("device"), plans[0].get("inode")) != (st.st_dev, st.st_ino):
            return False, "journal does not match this directory's identity"
        if [target, st.st_dev, st.st_ino] not in [[t.get("directory"), t.get("device"), t.get("inode")]
                                                 for t in scoped.get("targets", [])]:
            return False, "scoped-run record does not name this directory identity"
        ident = last.get("identity")
        if not ident or (ident.get("dev"), ident.get("ino")) != (st.st_dev, st.st_ino):
            return False, "directory was replaced after retirement"
        manifest_path = receipt.get("manifest")
        if not isinstance(manifest_path, str) or file_sha256(manifest_path) != msha:
            return False, "the executed manifest no longer matches its digest"
        manifest = _read_json_file(manifest_path)
        if not any(g.get("directory") == target and (g.get("device"), g.get("inode")) == (st.st_dev, st.st_ino)
                   for g in manifest.get("cargo_artifact_groups", [])):
            return False, "manifest does not name this target"
    except (OSError, ValueError, TypeError, KeyError, AttributeError) as error:
        return False, f"evidence unreadable or inconsistent ({type(error).__name__})"
    return True, ""


# ------------------------------------------------- historical owner attestation
#
# Evidence ONLY.  For a retirement that already happened under an owner approval given
# outside this tool (before signed scoped runs existed), the owner may record that the
# exact manifest digest was approved, with the approval text pinned by hash.  It is
# accepted only if the original receipt, journal and manifest still verify and are
# unchanged; the original files are never modified.  It never authorises deletion (the
# executor reads approvals only), and it satisfies only the "was the retirement verified"
# question of the worktree gate: every other condition is still checked.

ATTEST_KIND = "HISTORICAL_RETIREMENT_ATTESTATION"
ATTEST_NAME = re.compile(r"attest-[0-9a-f]{16}\.json")


def attestations_dir():
    return os.path.join(state_dir(), "attestations")


def historical_evidence_problem(att, target, record, trusted):
    """Why `att` does not verify a complete retirement of `target`, or None."""
    try:
        if att.get("kind") != ATTEST_KIND or att.get("grants") != "RETIREMENT_EVIDENCE_ONLY":
            return "not a historical retirement attestation"
        if att.get("target_root") != os.path.dirname(target) or att.get("state_dir") != state_dir():
            return "attestation is for another root"
        files = att.get("files") or {}
        for key in ("receipt", "journal", "manifest", "evidence"):
            f = files.get(key) or {}
            if not isinstance(f.get("path"), str) or file_sha256(f["path"]) != f.get("sha256"):
                return f"the original {key} is missing or was modified"
        msha = att.get("manifest_sha256")
        if not isinstance(msha, str) or files["manifest"]["sha256"] != msha:
            return "attested digest is not the manifest's digest"
        evidence = open(files["evidence"]["path"], encoding="utf-8", errors="replace").read()
        if msha not in evidence:
            return "the preserved owner approval does not name this manifest digest"
        receipt = _read_json_file(files["receipt"]["path"])
        if receipt.get("mode") != "EXECUTE" or receipt.get("refused") or receipt.get("interrupted"):
            return "receipt does not describe a completed execution"
        if receipt.get("manifest_sha256") != msha or receipt.get("approved_sha256") != msha:
            return "receipt was not executed against the attested digest"
        if os.path.realpath(receipt.get("manifest") or "") != os.path.realpath(files["manifest"]["path"]) or \
                os.path.realpath(receipt.get("journal_file") or "") != os.path.realpath(files["journal"]["path"]):
            return "receipt names other manifest or journal files"
        hist = att.get("historical") or {}
        if (hist.get("started"), hist.get("finished")) != (receipt.get("started"), receipt.get("finished")):
            return "historical execution time disagrees with the receipt"
        if not isinstance(att.get("attested_at"), (int, float)) or att["attested_at"] < receipt["finished"]:
            return "attestation predates the execution it attests"
        groups = [g for g in receipt.get("groups", []) if g.get("directory") == target]
        if len(groups) != 1 or groups[0].get("outcome") != "RETIRED":
            return "receipt has no complete RETIRED outcome for this target"
        events = _journal_events(files["journal"]["path"])
        if not _complete_journal(events, msha):
            return "journal is not a complete, matching execution"
        st = os.lstat(target)
        plans = [e for e in events if e.get("event") == "group_plan" and e.get("directory") == target]
        if len(plans) != 1 or (plans[0].get("device"), plans[0].get("inode")) != (st.st_dev, st.st_ino):
            return "journal does not match this directory's identity"
        manifest = _read_json_file(files["manifest"]["path"])
        if not any(g.get("directory") == target and (g.get("device"), g.get("inode")) == (st.st_dev, st.st_ino)
                   for g in manifest.get("cargo_artifact_groups", [])):
            return "manifest does not name this directory identity"
        if [target, st.st_dev, st.st_ino] not in [[t.get("directory"), t.get("device"), t.get("inode")]
                                                 for t in att.get("targets", [])]:
            return "attestation does not name this directory identity"
        if not record or (record.get("identity") or {}) != {"dev": st.st_dev, "ino": st.st_ino}:
            return "lifecycle record does not match this directory"
        if any((record.get(k) or 0) > receipt["finished"] for k in ("last_start", "last_end", "last_use")):
            return "the cache was used again after the attested retirement"
    except (OSError, ValueError, TypeError, KeyError, AttributeError) as error:
        return f"evidence unreadable or inconsistent ({type(error).__name__})"
    return None


def attested_retirement(record, target):
    """(ok, why) from a historical attestation in a maintenance directory whose policy
    covers this target's root."""
    global _EVIDENCE_STATE_DIR
    trusted = trusted_policy_uids()
    why = "no historical attestation"
    try:
        names = sorted(n for n in os.listdir(F.registry_dir()) if n == "maintenance" or (
            n.startswith("maintenance-") and INSTANCE_NAME.fullmatch(n[len("maintenance-"):])))
    except OSError:
        return False, why
    for name in names:
        directory = os.path.join(F.registry_dir(), name)
        previous, _EVIDENCE_STATE_DIR = _EVIDENCE_STATE_DIR, directory
        try:
            text = read_trusted_text(policy_path(), trusted)
            policy = json.loads(text) if text else None
            if not (isinstance(policy, dict) and validate_policy(policy)
                    and policy["scope"]["target_root"] == os.path.dirname(target)):
                continue
            ok, _ = _trusted_file(attestations_dir(), trusted, want_dir=True)
            if not ok:
                continue
            for entry in sorted(os.listdir(attestations_dir())):
                if not ATTEST_NAME.fullmatch(entry):
                    continue
                text = read_trusted_text(os.path.join(attestations_dir(), entry), trusted)
                try:
                    att = json.loads(text) if text else None
                except ValueError:
                    continue
                if not isinstance(att, dict) or target not in [t.get("directory") for t in att.get("targets", [])
                                                               if isinstance(t, dict)]:
                    continue
                problem = historical_evidence_problem(att, target, record, trusted)
                if problem is None:
                    return True, ""
                why = problem
        except (OSError, ValueError):
            continue
        finally:
            _EVIDENCE_STATE_DIR = previous
    return False, why


def cmd_attest_retirement(args):
    """Record (once per receipt) the owner's historical approval of an executed manifest."""
    trusted = trusted_policy_uids()
    st_, policy, why = load_policy()
    root = os.path.realpath(F.target_root())
    if st_ != "ok" or policy["scope"]["target_root"] != root:
        raise SystemExit(f"attest-retirement: this instance has no valid policy for {root} ({why})")
    digest = args.manifest_sha256.lower()
    receipt_path, evidence_path = os.path.realpath(args.receipt), os.path.realpath(args.evidence)
    receipt = _read_json_file(receipt_path)
    if receipt.get("manifest_sha256") != digest:
        raise SystemExit("attest-retirement: the receipt was not executed against that digest; nothing recorded")
    files = {"receipt": receipt_path, "journal": os.path.realpath(receipt.get("journal_file") or "/nonexistent"),
             "manifest": os.path.realpath(receipt.get("manifest") or "/nonexistent"), "evidence": evidence_path}
    pinned = {k: {"path": v, "sha256": file_sha256(v)} for k, v in files.items()}
    targets, refused = [], []
    for g in receipt.get("groups", []):
        target = g.get("directory")
        if not isinstance(target, str) or os.path.dirname(target) != root:
            refused.append((target, "not in this instance's root"))
            continue
        try:
            st = os.lstat(target)
        except OSError:
            refused.append((target, "missing"))
            continue
        targets.append({"directory": target, "device": st.st_dev, "inode": st.st_ino})
    att = {"schema": 1, "kind": ATTEST_KIND, "grants": "RETIREMENT_EVIDENCE_ONLY", "target_root": root,
           "state_dir": state_dir(), "manifest_sha256": digest, "files": pinned,
           "historical": {"started": receipt.get("started"), "finished": receipt.get("finished")},
           "attested_at": now(), "attested_by": F.owner_name(), "note": args.note or "", "targets": targets}
    registry = F.Registry(create=False)
    good = []
    for t in targets:
        _, record = registry.read_checked("targets", F.key_for(t["directory"]), F.valid_target_record)
        problem = historical_evidence_problem(att, t["directory"], record, trusted)
        (refused.append((t["directory"], problem)) if problem else good.append(t))
    if refused and not args.allow_partial:
        for target, problem in refused:
            print(f"  NOT ATTESTABLE {target}: {problem}")
        raise SystemExit("attest-retirement: some targets do not verify; nothing recorded "
                         "(each must verify, or pass --allow-partial to attest only the verified ones)")
    if not good:
        raise SystemExit("attest-retirement: no target verifies; nothing recorded")
    att["targets"] = good
    os.makedirs(attestations_dir(), mode=0o700, exist_ok=True)
    name = f"attest-{pinned['receipt']['sha256'][:16]}.json"
    path = os.path.join(attestations_dir(), name)
    data = (json.dumps(att, indent=1, sort_keys=True) + "\n").encode()
    try:
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
    except FileExistsError:
        raise SystemExit(f"attest-retirement: this receipt is already attested ({path})") from None
    try:
        os.write(fd, data)
        os.fsync(fd)
    finally:
        os.close(fd)
    fsync_directory(attestations_dir())
    append_history({"event": "historical_attestation", "path": path, "manifest_sha256": digest,
                    "targets": [t["directory"] for t in good], "receipt_sha256": pinned["receipt"]["sha256"]})
    print(f"attested {len(good)} target(s) as retirement EVIDENCE ONLY (never an approval): {path}")
    for target, problem in refused:
        print(f"  not attested {target}: {problem}")
    return 0


# ------------------------------------------------- scoped-run record (request)
#
# `request-retirement` writes the scoped-run record that the executor needs: the exact
# targets with their identities, this root, the manifest digest, a <=24 h expiry and a
# one-time nonce.  It is ACCIDENT PROTECTION ONLY: any process of this account can write
# one.  Nothing is deleted until the owner signs the record's exact bytes off this
# machine with `ssh-keygen -Y sign` and the executor verifies that signature.

def write_new_file(path, data):
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
    try:
        os.write(fd, data)
        os.fsync(fd)
    finally:
        os.close(fd)
    fsync_directory(os.path.dirname(path))


# ------------------------------------------------------------ HOLD registry lifecycle

def _hold_registry_update(change):
    """Apply `change(doc)` to hold-registry.json under an exclusive lock, atomically."""
    path = F.hold_registry_path()
    fd = os.open(os.path.join(F.registry_dir(), ".hold-registry.lock"), os.O_RDWR | os.O_CREAT | os.O_CLOEXEC, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        with open(path) as handle:
            doc = json.load(handle)
        entries, problem = F._valid_registry(doc)
        if problem:
            raise SystemExit(f"the HOLD registry is not usable ({problem}); fix it first")
        change(doc)
        F.atomic_write(path, doc)
    finally:
        os.close(fd)


def _hold_entry(doc, entry_id):
    entry = next((e for e in doc["entries"] if e.get("id") == entry_id), None)
    if entry is None:
        raise SystemExit(f"no HOLD registry entry {entry_id!r}")
    return entry


def _checkout_caches(wt):
    real = os.path.realpath(wt)
    return [r["target"] for r in F.Registry(create=False).all_records().values()
            if r.get("worktree") and os.path.realpath(r["worktree"]) == real and r.get("target")]


def cmd_hold_release_request(args):
    """Write an UNSIGNED release record for one entry and one exact checkout.  It records the
    checkout identity (path, dev/ino, HEAD, branch) and acknowledges, by hash, every HOLD
    indication that names the checkout or its caches today.  Nothing changes until the
    owner signs it off this machine and `hold-release-apply` verifies it."""
    with open(F.hold_registry_path()) as handle:
        doc = json.load(handle)
    entries, problem = F._valid_registry(doc)
    if problem:
        raise SystemExit(f"the HOLD registry is not usable ({problem})")
    entry = _hold_entry(doc, args.entry)
    ident = F.checkout_identity(args.worktree)
    if ident is None:
        raise SystemExit(f"{args.worktree}: not a readable checkout; a release binds to a verified checkout")
    real = {os.path.realpath(p) for p in entry.get("paths", [])}
    if not (ident["path"] in real or ident["branch"] in entry.get("branches", []) or ident["head"] in entry.get("heads", [])):
        raise SystemExit(f"{ident['path']} is not the checkout entry {args.entry} protects")
    found = F.hold_indications(ident["path"], *_checkout_caches(ident["path"]))
    record = {"kind": F.HOLD_RELEASE_KIND, "schema": 1, "entry": entry["id"], "at": now(), "checkout": ident,
              "acknowledged": sorted({d for _c, _t, d in found}),
              "acknowledged_text": [{"source": c, "text": t[:500]} for c, t, _d in found],
              "requested_by": F.owner_name(), "nonce": secrets.token_hex(16), "note": args.note or ""}
    raw = (json.dumps(record, indent=1, sort_keys=True) + "\n").encode()
    directory = os.path.join(F.registry_dir(), F.HOLD_RELEASES_DIR)
    os.makedirs(directory, mode=0o700, exist_ok=True)
    path = os.path.join(directory, f"release-{hashlib.sha256(raw).hexdigest()[:16]}.json")
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
    with os.fdopen(fd, "wb") as handle:
        handle.write(raw)
    print(path)
    print(f"acknowledges {len(found)} HOLD indication(s); owner signs off this machine with:\n"
          f"  ssh-keygen -Y sign -n {F.HOLD_RELEASE_NAMESPACE} -f <owner key> {os.path.basename(path)}\n"
          f"then: hold-release-apply --record {path}")
    return 0


def cmd_hold_release_apply(args):
    """Record RELEASED for an entry, only from an owner-signed release record bound to the
    checkout's current identity.  Auditable: the transition names the record; history logs it."""
    path = os.path.join(F.registry_dir(), F.HOLD_RELEASES_DIR, os.path.basename(args.record))
    raw = F._read_regular(path, 1 << 20)
    X = executor()
    try:
        facts = X.verify_owner_signature(path, raw, F.HOLD_RELEASE_NAMESPACE)
    except X.Refusal as refusal:
        raise SystemExit(f"hold-release-apply refused: {refusal}") from None
    record = json.loads(raw)
    if record.get("kind") != F.HOLD_RELEASE_KIND:
        raise SystemExit("not a HOLD release record")
    current = F.checkout_identity(record["checkout"]["path"])
    if current is None or any(current.get(k) != record["checkout"].get(k) for k in ("path", "dev", "ino", "head")):
        raise SystemExit("the checkout changed since the release was requested; request and sign a new one")

    def change(doc):
        entry = _hold_entry(doc, record["entry"])
        entry.setdefault("transitions", []).append({
            "state": "RELEASED", "at": record["at"], "release_record": os.path.basename(path),
            "signer_fingerprint": facts.get("signer_fingerprint"), "applied_at": now(), "applied_by": F.owner_name()})
        entry["state"] = "RELEASED"
    _hold_registry_update(change)
    append_history({"event": "hold_release", "entry": record["entry"], "record": os.path.basename(path),
                    "checkout": record["checkout"], "signer_fingerprint": facts.get("signer_fingerprint")})
    print(f"released HOLD entry {record['entry']} for {record['checkout']['path']} at {record['checkout']['head'][:12]}; "
          "pins and every other safety gate still apply")
    return 0


def cmd_hold_set(args):
    """Record HELD (adding protection needs no signature); a later HELD overrides any release."""
    def change(doc):
        entry = next((e for e in doc["entries"] if e.get("id") == args.entry), None)
        if entry is None:
            if not args.path:
                raise SystemExit(f"no entry {args.entry!r}; give --path to create it")
            entry = {"id": args.entry, "state": "HELD", "paths": [os.path.realpath(args.path)], "branches": [],
                     "heads": [], "provenance": [f"hold-set by {F.owner_name()}"]}
            doc["entries"].append(entry)
        entry.setdefault("transitions", []).append({"state": "HELD", "at": now(), "by": F.owner_name(),
                                                    "reason": args.reason or ""})
        entry["state"] = "HELD"
    _hold_registry_update(change)
    append_history({"event": "hold_set", "entry": args.entry, "reason": args.reason or ""})
    print(f"HOLD entry {args.entry}: HELD")
    return 0


def cmd_request_retirement(args):
    X = executor()
    root = os.path.realpath(F.target_root())
    if bool(args.only) == bool(args.manifest):
        raise SystemExit("request-retirement: give either --only NAME (repeatable) or --manifest FILE")
    if not (0 < args.hours <= X.SCOPED_MAX_SECONDS / 3600):
        raise SystemExit("request-retirement: --hours must be above 0 and at most 24")
    ensure_state()
    os.makedirs(os.path.join(state_dir(), "manifests"), mode=0o700, exist_ok=True)
    if args.manifest:
        manifest_path = os.path.realpath(args.manifest)
        manifest = _read_json_file(manifest_path)
    else:
        st_, policy, why = load_policy()
        if st_ != "ok":
            raise SystemExit(f"request-retirement: no valid policy for this instance ({why})")
        only = parse_only(args.only)
        _, items, census, measured, summ = snapshot(policy)
        plan = plan_cycle(policy, items, summ, census, only)
        if plan["blocked"] or {e["item"]["name"] for e in plan["selected"]} != set(only):
            raise SystemExit("request-retirement: the requested targets are not exactly plannable "
                             f"({plan['blocked'] or 'not every name is eligible'}); nothing recorded")
        manifest = build_manifest(policy, plan, measured)
        verify_manifest_against_policy(manifest, policy, plan)
        manifest_path = os.path.join(state_dir(), "manifests",
                                     f"request-{time.strftime('%Y%m%dT%H%M%S', time.gmtime(now()))}-{os.getpid()}.json")
        F.atomic_write(manifest_path, manifest)
    manifest_sha = file_sha256(manifest_path)
    targets = []
    for g in manifest.get("cargo_artifact_groups", []):
        directory = g.get("directory")
        if not isinstance(directory, str) or os.path.dirname(directory) != root or os.path.realpath(directory) != directory:
            raise SystemExit(f"request-retirement: {directory} is not a canonical cache directory in {root}")
        st = os.lstat(directory)
        if not stat.S_ISDIR(st.st_mode) or (g.get("device"), g.get("inode")) != (st.st_dev, st.st_ino):
            raise SystemExit(f"request-retirement: {directory} is not the directory the manifest names")
        targets.append({"directory": directory, "device": st.st_dev, "inode": st.st_ino})
    if not targets or len({t["directory"] for t in targets}) != len(targets):
        raise SystemExit("request-retirement: no targets, or a target named twice")
    at = now()
    record = {"schema": X.SCOPED_SCHEMA, "kind": X.SCOPED_KIND, "operation": X.SCOPED_OPERATION,
              "host": socket.gethostname(), "target_root": root, "state_dir": state_dir(),
              "manifest_path": manifest_path, "manifest_sha256": manifest_sha,
              "targets": sorted(targets, key=lambda t: t["directory"]),
              "created_at": at, "expires_at": at + args.hours * 3600, "nonce": secrets.token_hex(16),
              "recorded_by": F.owner_name(), "note": args.note or "",
              "notice": "accident protection only; not proof of owner consent until signed by the owner's key"}
    data = (json.dumps(record, indent=1, sort_keys=True) + "\n").encode()
    directory = os.path.join(state_dir(), "scoped-runs")
    os.makedirs(directory, mode=0o700, exist_ok=True)
    path = os.path.join(directory, f"scoped-{hashlib.sha256(data).hexdigest()[:16]}.json")
    write_new_file(path, data)
    append_history({"event": "scoped_run_requested", "path": path, "targets": [t["directory"] for t in targets],
                    "manifest_sha256": manifest_sha, "expires_at": record["expires_at"]})
    print(path)
    print(f"  {len(targets)} target(s) in {root}; manifest sha256 {manifest_sha}; expires in {args.hours:g} h")
    print("  NOT AUTHORISED until the owner signs these exact bytes OFF this machine:")
    print(f"    ssh-keygen -Y sign -n {X.SIGNATURE_NAMESPACE} -f <owner key> {os.path.basename(path)}")
    print(f"  and the resulting {os.path.basename(path)}.sig is placed next to the record.")
    return 0


def signed_manifest_for(record_path, fresh):
    """(path, digest, manifest) of the manifest a signed scoped-run record names, after
    checking (signature included) that the record is usable and that a freshly planned
    manifest deletes exactly the same paths with the same identities."""
    X = executor()
    if not record_path:
        raise X.Refusal("SCOPED_RUN_REQUIRED", "no scoped-run record")
    raw = _read_json_file(os.path.normpath(os.path.abspath(record_path)))
    mpath = raw.get("manifest_path") if isinstance(raw, dict) else None
    if not isinstance(mpath, str) or os.path.dirname(mpath) != os.path.join(state_dir(), "manifests"):
        raise X.Refusal("SCOPED_RUN_MISMATCH", "the record's manifest is not in this instance's manifests directory")
    digest = file_sha256(mpath)
    signed = _read_json_file(mpath)
    X.check_scoped_run(record_path, [{"group": g} for g in signed.get("cargo_artifact_groups", [])],
                       digest, mpath, now(), receipt_dir=os.path.join(state_dir(), "receipts"))
    if batch_identity(signed) != batch_identity(fresh):
        raise X.Refusal("SCOPED_RUN_MISMATCH", "the signed batch differs from a fresh plan (paths or identities "
                        "changed since it was signed); request and sign a new record")
    return mpath, digest, signed


# Per-worktree state naming work that `git worktree remove` would delete unchecked.
# FETCH_HEAD is left out on purpose: every fetching checkout has one, and what it
# names came from a remote, not from this checkout.
UNFINISHED_GIT_STATE = ("index.lock", "HEAD.lock", "MERGE_HEAD", "CHERRY_PICK_HEAD", "REVERT_HEAD",
                        "MERGE_AUTOSTASH", "rebase-merge", "rebase-apply", "BISECT_START",
                        "BISECT_LOG", "sequencer", "locked", "modules")
# Everything a checkout's admin directory may hold once the checks above pass. Anything
# else (a custom pseudoref, `git notes merge` state) is state nobody here has judged.
KNOWN_ADMIN_ENTRIES = frozenset(("HEAD", "ORIG_HEAD", "REBASE_HEAD", "FETCH_HEAD", "AUTO_MERGE", "COMMIT_EDITMSG",
                                 "MERGE_MSG", "SQUASH_MSG", "index", "logs", "gitdir", "commondir",
                                 "config.worktree", "refs", "info"))


CACHEDIR_TAG_SIGNATURE = b"Signature: 8a477f597d28d172789f06886806bc55"
IN_TREE_SCAN_LIMIT = 500_000


def in_tree_build_output_problem(wt, rel):
    """Why the ignored directory `rel` (exactly `target/` at the checkout root, or a
    `__pycache__/` directory) is not proven to be reproducible build output, or None.

    `git worktree remove` deletes ignored files, so ignored content is evidence until
    proven otherwise. Proof for `target/`: every file is covered by the retirement
    tool's own artifact selection (the same classification the executor deletes by),
    except Cargo's empty lock files, an exact CACHEDIR.TAG and EMPTY preserved
    directories; no symlink, special file or other filesystem anywhere; and no process
    references it under a complete census. `__pycache__/`: only regular `*.pyc` files.
    Anything unreadable, oversized or unexpected is a problem (fail closed)."""
    path = os.path.join(wt, rel.rstrip("/"))
    try:
        st = os.lstat(path)
        wt_dev = os.lstat(wt).st_dev
    except OSError as error:
        return f"{rel}: cannot inspect ({error.strerror})"
    if not stat.S_ISDIR(st.st_mode) or st.st_dev != wt_dev:
        return f"{rel}: not a plain directory on the checkout's filesystem"
    if rel != "target/":
        try:
            names = os.listdir(path)
        except OSError as error:
            return f"{rel}: cannot list ({error.strerror})"
        for name in names:
            try:
                s = os.lstat(os.path.join(path, name))
            except OSError:
                return f"{rel}{name}: cannot inspect"
            if not (stat.S_ISREG(s.st_mode) and name.endswith(".pyc") and s.st_dev == wt_dev):
                return f"{rel}{name}: not a compiled Python file"
        return None
    selected, preserved = F.select_artifacts(path, None)
    covered = {os.path.normpath(e["path"]) for e in selected}
    allowed_files, empty_dirs = set(), set()
    for p in preserved:
        full = os.path.normpath(p["path"])
        try:
            s = os.lstat(full)
        except OSError:
            return f"{os.path.relpath(full, wt)}: cannot inspect"
        name = os.path.basename(full)
        if stat.S_ISREG(s.st_mode) and name in F.CARGO_LOCK_NAMES and s.st_size == 0:
            allowed_files.add(full)
        elif stat.S_ISREG(s.st_mode) and name == "CACHEDIR.TAG" and os.path.dirname(full) == path:
            try:
                with open(full, "rb") as handle:
                    head = handle.read(4096)
            except OSError:
                return "target/CACHEDIR.TAG: cannot read"
            if not head.startswith(CACHEDIR_TAG_SIGNATURE):
                return "target/CACHEDIR.TAG: not Cargo's cache directory tag"
            allowed_files.add(full)
        elif stat.S_ISDIR(s.st_mode) and name in F.ALWAYS_PRESERVE:
            empty_dirs.add(full)
        else:
            return f"{os.path.relpath(full, wt)}: kept by the retirement tool ({p.get('why')})"

    def is_covered(p):
        while len(p) > len(path):
            if p in covered:
                return True
            p = os.path.dirname(p)
        return False

    def fail(error):
        raise error

    seen = 0
    for root, dirs, files in os.walk(path, onerror=fail):
        for name in dirs + files:
            seen += 1
            if seen > IN_TREE_SCAN_LIMIT:
                return "target/: too large to verify"
            full = os.path.join(root, name)
            s = os.lstat(full)
            if s.st_dev != wt_dev or not (stat.S_ISDIR(s.st_mode) or stat.S_ISREG(s.st_mode)):
                return f"{os.path.relpath(full, wt)}: symlink, special file or other filesystem"
            if stat.S_ISREG(s.st_mode) and not (full in allowed_files or is_covered(full)):
                if any(full.startswith(d + os.sep) for d in empty_dirs):
                    return f"{os.path.relpath(full, wt)}: preserved directory is not empty"
                return f"{os.path.relpath(full, wt)}: not recognised compiler output"
    census = F.Census([path])
    if census.unreadable_foreign:
        return "target/: process visibility is incomplete (run the check as root)"
    if census.refs.get(path):
        return "target/: a process is using it"
    return None


def reproducible_ignored_problem(wt, entries):
    """The CHECKOUT_NOT_CLEAN / IN_TREE_BUILD_OUTPUT_UNVERIFIED result for `git status
    -z --ignored=matching` entries, or None when every entry is an ignored `target/`
    or `__pycache__/` directory proven reproducible by in_tree_build_output_problem."""
    for entry in entries:
        rel = entry[3:]
        if not entry.startswith("!! ") or not rel.endswith("/") or not (
                rel == "target/" or rel == "__pycache__/" or rel.endswith("/__pycache__/")):
            return ("CHECKOUT_NOT_CLEAN", "tracked, untracked or ignored files require preservation")
    for entry in entries:
        try:
            why = in_tree_build_output_problem(wt, entry[3:])
        except OSError as error:
            why = f"{entry[3:]}: cannot inspect ({error})"
        if why:
            return ("IN_TREE_BUILD_OUTPUT_UNVERIFIED",
                    "ignored build output is not proven reproducible and would be deleted with the checkout: " + why)
    return None


def history_preservation_problem(wt):
    """Why removing this checkout could lose work, or None.

    `git worktree remove` deletes the checkout's own refs, HEAD reflog and
    ORIG_HEAD, and silently deletes ignored files, so every gate that can say
    CLEAR must prove them first. HEAD being merged says nothing about them.
    Only a ref proves preservation: a bundle counts once it is imported under
    refs/preservation/. Anything that cannot be established is a problem.

    A path without `.git` cannot be judged from the path alone: `git worktree
    remove` accepts one that has gone and deletes the admin directory, even one a
    moved checkout is using, and `git worktree prune` removes it when `.git` is lost.
    """
    # No inherited GIT_DIR/GIT_WORK_TREE/alternates, and no replace refs or grafts
    # that could make unmerged history look preserved.
    env = {k: v for k, v in os.environ.items() if not k.startswith("GIT_")}
    # GIT_OPTIONAL_LOCKS: a read-only gate must not refresh the index.
    env.update(GIT_NO_REPLACE_OBJECTS="1", GIT_GRAFT_FILE="/nonexistent", GIT_CONFIG_NOSYSTEM="1",
               GIT_OPTIONAL_LOCKS="0", LC_ALL="C")

    def run(*args):
        return F.run_as_owner(["git", "-C", wt, *args], capture_output=True,
                              text=True, timeout=30, env=env)

    def git(*args):
        proc = run(*args)
        if proc.returncode != 0:
            raise LegacyCheckoutHold("GIT_STATE_UNVERIFIED", proc.stderr.strip())
        return proc.stdout.strip()

    def nested_git_entry():
        # `git status` skips anything named .git, but the removal deletes it.
        def fail(error):
            raise error
        for root, dirs, files in os.walk(wt, onerror=fail):
            if root == wt:
                dirs[:] = [d for d in dirs if d != ".git"]
            elif ".git" in dirs or ".git" in files:
                return os.path.relpath(root, wt)
        return None

    def require_own_admin(admin):
        common = git("rev-parse", "--path-format=absolute", "--git-common-dir")
        if admin == common:
            raise LegacyCheckoutHold("GIT_WORKTREE_PROTECTED", "a main checkout or clone is never removable: "
                                     "its own refs cannot prove its history is held elsewhere")
        if os.path.lexists(os.path.join(common, "reftable")):
            raise LegacyCheckoutHold("GIT_STATE_UNVERIFIED", "reftable storage keeps reflogs outside logs/HEAD")
        # A .git file can point at another checkout's admin directory.
        with open(os.path.join(admin, "gitdir")) as handle:
            recorded = os.path.join(admin, handle.read().strip())
        if os.path.realpath(recorded) != os.path.realpath(os.path.join(wt, ".git")):
            raise LegacyCheckoutHold("CHECKOUT_PATH_UNVERIFIED", "this .git names another checkout's admin directory")

    def names_in(path, read):
        # lexists would misclassify permission failures as absence.
        try:
            mode = os.lstat(path).st_mode
        except FileNotFoundError:
            return set()
        if not stat.S_ISREG(mode):
            raise LegacyCheckoutHold("GIT_STATE_UNVERIFIED",
                                     os.path.basename(path) + " is not a regular file")
        return read(path)

    def reflogs(path):
        try:
            mode = os.lstat(path).st_mode
        except FileNotFoundError:
            return set()
        if stat.S_ISDIR(mode):
            return set().union(*(reflogs(os.path.join(path, n)) for n in os.listdir(path)))
        return names_in(path, reflog_names)

    def reflog_names(path):
        # Read the file itself: gc keeps both IDs of every entry, while
        # `git reflog show` lists only the new one.
        names = set()
        with open(path, "rb") as handle:
            for line in handle:
                names.update(line.split(b"\t", 1)[0].decode(errors="replace").split()[:2])
        return names

    def orig_head_name(path):
        with open(path) as handle:
            return {handle.read().strip()}

    try:
        try:
            os.lstat(os.path.join(wt, ".git"))
        except FileNotFoundError:
            return ("CHECKOUT_PATH_UNVERIFIED", "path holds no .git, so its registered Git state cannot be judged")
        if git("rev-parse", "--show-toplevel") != os.path.realpath(wt):
            return ("CHECKOUT_PATH_UNVERIFIED", "path is not a Git checkout root")
        admin = git("rev-parse", "--absolute-git-dir")
        require_own_admin(admin)
        if any(os.path.lexists(os.path.join(admin, n)) for n in UNFINISHED_GIT_STATE):
            return ("GIT_WORKTREE_PROTECTED", "unfinished Git operation or lock")
        # Before status, which does not see these files.
        if any(line and (line[0].islower() or line[0] == "S") for line in git("ls-files", "-v", "-z").split("\0")):
            return ("CHECKOUT_INDEX_UNVERIFIED", "assume-unchanged or skip-worktree entries can hide unfinished code")
        status = run("status", "--porcelain=v1", "-z", "--untracked-files=all", "--ignored=matching",
                     "--ignore-submodules=none")
        if status.returncode != 0 or "could not open directory" in status.stderr:
            return ("GIT_STATE_UNVERIFIED", status.stderr.strip())
        entries = [e for e in status.stdout.split("\0") if e]
        if entries:
            problem = reproducible_ignored_problem(wt, entries)
            if problem:
                return problem
        # Files inside a gitlink's directory are invisible to status, with or without
        # submodule state, and are deleted with the checkout.
        if any(line.startswith("160000 ") for line in git("ls-files", "-s", "-z").split("\0")):
            return ("GIT_STATE_UNVERIFIED", "a gitlink's directory can hold files status does not report")
        nested = nested_git_entry()
        if nested:
            return ("GIT_STATE_UNVERIFIED", "nested .git entry status does not report: " + ascii(nested))
        if git("for-each-ref", "--format=%(refname)", "refs/worktree", "refs/bisect", "refs/rewritten"):
            return ("GIT_HISTORY_NOT_PRESERVED", "per-worktree refs would be deleted with the checkout")
        unknown = sorted(set(os.listdir(admin)) - KNOWN_ADMIN_ENTRIES)
        if unknown:
            return ("GIT_STATE_UNVERIFIED", "unjudged state in the checkout's admin directory: " + ", ".join(unknown))
        names = reflogs(os.path.join(admin, "logs"))
        names |= names_in(os.path.join(admin, "ORIG_HEAD"), orig_head_name)
        # A finished rebase can leave this behind, so it is checked, not held on.
        names |= names_in(os.path.join(admin, "REBASE_HEAD"), orig_head_name)
        names.add(git("rev-parse", "--verify", "HEAD^{commit}"))
        if not all(len(n) in (40, 64) and not n.strip("0123456789abcdef") for n in names):
            return ("GIT_STATE_UNVERIFIED", "reflog or ORIG_HEAD holds something other than an object ID")
        names -= {"0" * 40, "0" * 64}
        # Not --all: that counts worktree HEADs, including this checkout's own.
        # A named object that no longer exists makes rev-list fail, and so HOLD.
        orphans = git("rev-list", *sorted(names), "--not", "--glob=refs/*").split()
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        return ("GIT_STATE_UNVERIFIED", str(error))
    except LegacyCheckoutHold as error:
        return (error.code, error.explanation)
    if orphans:
        return ("GIT_HISTORY_NOT_PRESERVED",
                f"{len(orphans)} commit(s) are named only by this checkout's HEAD, reflog or ORIG_HEAD "
                f"(for example {', '.join(o[:12] for o in orphans[:5])}); retain them under refs/preservation/ first")
    return None


def configured_roots():
    """Every Cargo cache root a worktree can have output in: the default home root, the
    root this shell selects (EMUWIZ_TARGET_ROOT) and the target_root of every valid
    maintenance policy in the registry.  Canonical paths, sorted, without duplicates."""
    roots = {os.path.realpath(os.path.join(F.home(), ".cache", "emuwiz-cargo-targets")),
             os.path.realpath(F.target_root())}
    trusted = trusted_policy_uids()
    try:
        names = os.listdir(F.registry_dir())
    except OSError:
        names = []
    for name in names:
        if not (name == "maintenance" or (name.startswith("maintenance-")
                                          and INSTANCE_NAME.fullmatch(name[len("maintenance-"):]))):
            continue
        text = read_trusted_text(os.path.join(F.registry_dir(), name, "policy.json"), trusted)
        try:
            policy = json.loads(text) if text else None
        except ValueError:
            policy = None
        if isinstance(policy, dict) and validate_policy(policy):
            roots.add(os.path.realpath(policy["scope"]["target_root"]))
    return sorted(roots)


def lifecycle_gate_all_roots(path):
    """lifecycle_gate on every configured root (F3).  CLEAR only when every root is CLEAR;
    otherwise the first HOLD, with each root's verdict listed under "roots"."""
    verdicts = []
    saved = os.environ.get("EMUWIZ_TARGET_ROOT")
    try:
        for root in configured_roots():
            os.environ["EMUWIZ_TARGET_ROOT"] = root
            verdicts.append((root, lifecycle_gate(path)))
    finally:
        if saved is None:
            os.environ.pop("EMUWIZ_TARGET_ROOT", None)
        else:
            os.environ["EMUWIZ_TARGET_ROOT"] = saved
    holds = [v for _, v in verdicts if v["status"] != "CLEAR"]
    current = os.path.realpath(F.target_root())
    res = dict(holds[0] if holds else next((v for r, v in verdicts if r == current), verdicts[0][1]))
    res["roots"] = [{"root": r, "target": v["target"], "status": v["status"], "code": v["code"]} for r, v in verdicts]
    if holds and len(verdicts) > 1:
        res["explanation"] = f"[{os.path.dirname(res['target'])}] " + res["explanation"]
    return res


def worktree_gate(path):
    """The lifecycle gate on every configured root, which can only be CLEAR when the
    checkout's history is also preserved. A HOLD still reports any history problem, so a
    Cargo reason can never hide it."""
    res = lifecycle_gate_all_roots(path)
    listed = F.hold_listed(res.get("worktree") or path, res.get("target"),
                           *[r.get("target") for r in res.get("roots") or []])
    if listed:                                 # unconditional: no Cargo or Git state can clear it
        res.update(status="HOLD", code=listed, explanation=EXPLANATIONS[listed])
        return res
    problem = history_preservation_problem(res["worktree"])
    if problem and res["status"] == "CLEAR":
        res.update(status="HOLD", code=problem[0], explanation=problem[1])
    elif problem:
        res["history_preservation"] = dict(code=problem[0], explanation=problem[1])
    return res


RESIDUE_SCAN_LIMIT = 200_000
RESIDUE_EXAMPLES = 3


def unrecognised_residue(target):
    """Everything in a cache that is neither empty directory structure, one of
    Cargo's own empty lock files, nor an explicitly permitted preserved-evidence
    directory (`F.ALWAYS_PRESERVE`, directly under the cache or one to three
    levels down where a profile directory lives; its contents are evidence and are
    not descended into).

    A cache that retirement has finished with can still hold output the retirement
    tool does not recognise (a standalone executable with no sibling `.d`, a stray
    file, a symlink, another filesystem). Retirement never selects it, so the
    worktree must not be declared removable while it exists: once the worktree is
    gone the residue is an orphan that no gate can ever release.

    Read-only, `lstat` only, never follows a symlink. Anything it cannot judge
    (unreadable directory, another device, an oversized tree) counts as residue.
    Returns (count, bytes, [relative example paths])."""
    count = size = seen = 0
    examples = []
    root_dev = os.lstat(target).st_dev

    def note(path, st_size):
        nonlocal count, size
        count += 1
        size += st_size
        if len(examples) < RESIDUE_EXAMPLES:
            examples.append(ascii(os.path.relpath(path, target)))

    stack = [(target, 0)]
    while stack:
        directory, depth = stack.pop()
        try:
            with os.scandir(directory) as entries:
                children = sorted(entries, key=lambda e: e.name)
        except OSError:
            note(directory, 0)
            continue
        for entry in children:
            seen += 1
            if seen > RESIDUE_SCAN_LIMIT:
                note(entry.path, 0)
                return count, size, examples
            try:
                st = entry.stat(follow_symlinks=False)
            except OSError:
                note(entry.path, 0)
                continue
            if stat.S_ISDIR(st.st_mode):
                if st.st_dev != root_dev:
                    note(entry.path, 0)
                elif entry.name in F.ALWAYS_PRESERVE and 1 <= depth + 1 <= 3:
                    continue
                else:
                    stack.append((entry.path, depth + 1))
            elif stat.S_ISREG(st.st_mode) and entry.name in F.CARGO_LOCK_NAMES and st.st_size == 0:
                continue
            else:
                note(entry.path, st.st_blocks * 512)
    return count, size, examples



def lifecycle_gate(path):
    """CLEAR only when the worktree's compiler artifacts are gone (retired with a
    verified receipt, or never existed).  Otherwise HOLD with the reason and the
    next step.  The gate never deletes and a release record alone never clears it."""
    wt, target = target_for_worktree(path)
    res = {"worktree": wt, "target": target, "worktree_exists": os.path.isdir(wt)}

    def hold(code, why, **extra):
        res.update(status="HOLD", code=code, explanation=why, **extra)
        return res

    def clear(why):
        res.update(status="CLEAR", code="CLEAR", explanation=why)
        return res

    if os.path.islink(target):
        return hold("SYMLINK_OR_MISSING_TARGET", "the cache directory is a symlink; resolve it by hand")
    key = F.key_for(F.canon(target))
    registry = F.Registry(create=False)
    rec_state, record = registry.read_checked("targets", key, F.valid_target_record)
    if rec_state == "invalid":
        return hold("REGISTRY_RECORD_INVALID", "the lifecycle record is malformed; repair it by hand before removing the worktree")
    if not os.path.isdir(target):
        # absent directory: proof of "never created" needs a record that never built
        if record and (record.get("last_retired") or record.get("last_start")):
            ok, why = verify_retirement(record, target) if record.get("last_retired") else (False, "")
            if ok:
                return clear("the cache directory is gone after a verified retirement")
            return hold("ARTIFACTS_MISSING_UNVERIFIED",
                        "this worktree was built through cargo-iso but its cache directory is missing and no verified "
                        "retirement receipt exists" + (f" ({why})" if why else "")
                        + "; the output was removed outside the maintenance workflow. Keep the worktree and review by hand")
        return clear("no Cargo cache exists for this worktree and none was ever built through cargo-iso")
    pin_state, pins = registry.pin_state(key)
    if pin_state == "invalid":
        return hold("PIN_STATE_UNKNOWN", "the pin record is unreadable or malformed")
    locked = registry.probe_lock(key)
    live = []
    if record:
        live = [e for e in record.get("active", [])
                if e.get("boot_id") == F.boot_id() and F.proc_starttime(e.get("pid")) == e.get("starttime")]
    census = F.Census([F.canon(target)])
    refs = census.refs.get(F.canon(target), [])
    if locked or live or refs:
        return hold("ACTIVE", "a build or program is still using this cache; releasing a task never stops it. "
                              "Keep the worktree; re-check when it has finished")
    if pins:
        return hold("PINNED", "explicitly pinned (" + ",".join(sorted({p["reason"] for p in pins})) +
                    "): the cache is protected, so keep the worktree until the pin is released")
    selected, preserved = F.select_artifacts(target, None)
    remnants = [p for p in preserved if p["why"].startswith(("contains ", "crosses ", "unreadable"))
                or p["why"].startswith("looks like data")]
    if remnants and not selected:
        return hold("PROTECTED_REMNANTS",
                    "compiler output remains inside %d protected subtree(s) (for example %s: %s); automatic retirement "
                    "refuses them. Review by hand and keep the worktree until resolved"
                    % (len(remnants), os.path.relpath(remnants[0]["path"], target), remnants[0]["why"]))
    if not selected:
        evidence, why = None, ""
        if record and record.get("last_retired"):
            ok, why = verify_retirement(record, target)
            if ok:
                evidence = "retirement receipt verified"
        if evidence is None and record and record.get("last_start"):
            # historical owner attestation: retirement EVIDENCE only, never an authorisation;
            # every other check below still applies
            ok2, why2 = attested_retirement(record, target)
            if ok2:
                evidence = "historical owner attestation verified, evidence only"
            elif not why and why2 != "no historical attestation":
                why = why2
        if evidence is None and record and record.get("last_retired"):
            return hold("RECEIPT_UNVERIFIED", "artifacts are gone but the retirement evidence could not be verified: "
                        + why + ". Keep the worktree and review the receipt and journal by hand")
        if evidence is not None:
            count, size, examples = unrecognised_residue(target)
            if count:
                return hold("UNRECOGNISED_RESIDUE",
                            "the retirement is verified but %d item(s), %.2f GB, remain that the retirement tool "
                            "does not recognise (for example %s), so it can never retire them and they would be orphaned "
                            "once the worktree is gone. Keep the worktree and review them by hand"
                            % (count, size / 1e9, ", ".join(examples)),
                            residue={"items": count, "bytes": size, "examples": examples})
            return clear(f"no compiler artifacts remain ({evidence}); "
                         "preserved evidence stays in the cache directory")
        try:
            empty = not os.listdir(target)
        except OSError:
            empty = False
        if empty and not (record and record.get("last_start")):
            return clear("the cache directory is empty and nothing was ever built through cargo-iso here")
        return hold("ARTIFACTS_MISSING_UNVERIFIED",
                    "no compiler artifacts are present but there is no verified retirement receipt and no proof that "
                    "none were ever created; they may have been removed outside the maintenance workflow"
                    + (f" ({why})" if why else "") + ". Keep the worktree and review by hand")
    # artifacts remain: the source worktree is what proves ownership at retirement time
    if not record:
        return hold("NO_LIFECYCLE_RECORD", "legacy cache with no lifecycle record: it cannot be retired automatically; "
                    "adopt it (needs this worktree) or discard it by hand first")
    if not record.get("last_start"):
        return hold("NONPARTICIPATING", "never built through cargo-iso; automatic retirement excludes it. Keep the worktree "
                    "until a manual cleanup")
    if not res["worktree_exists"]:
        return hold("SOURCE_MISSING", "the worktree is already gone: ownership cannot be verified, so this cache will not "
                    "be retired automatically; a human must adopt or discard it")
    if not record.get("released"):
        return hold("NOT_RELEASED", "task not finished: run `scripts/cargo-iso --finish-task` (or `emuwiz-cargo-maintain "
                    "task-complete`) in the worktree, then keep it until this check says CLEAR")
    m = F.measure_tree(target, set())
    problem = F.completion_problem(record, m.get("newest_mtime"))
    if problem:
        return hold(problem, EXPLANATIONS[problem] + ". Keep the worktree")
    st, policy, why = load_policy()
    if st != "ok" or not policy["enabled"]:
        return hold("AWAITING_RETIREMENT", "released and idle, but automatic retirement is %s: run a maintenance cycle "
                    "(or enable the approved policy). Keep the worktree until the artifacts are retired"
                    % ("not enabled" if st == "ok" else "unavailable (" + why + ")"))
    return hold("AWAITING_RETIREMENT", "released and idle: waiting for the next maintenance cycle (it only reclaims "
                "when the soft budget is exceeded). Keep the worktree until the artifacts are retired")


def history_note(gate):
    problem = gate.get("history_preservation")
    return f"\n  history: {problem['code']}: {problem['explanation']}" if problem else ""


def cmd_worktree_check(args):
    # --cargo-state-only answers "is there compiler output?"; it never authorizes removal.
    res = (lifecycle_gate if args.cargo_state_only else worktree_gate)(args.worktree)
    if args.json:
        print(json.dumps(res, indent=1, sort_keys=True))
    else:
        print(f"{res['status']}: {res['worktree']}\n  {res['explanation']}{history_note(res)}")
    return 0 if res["status"] == "CLEAR" else EXIT_WORKTREE_HOLD


class LegacyCheckoutHold(Exception):
    def __init__(self, code, explanation):
        self.code, self.explanation = code, explanation


def reconcile_legacy_worktree(path, preserved_ref=None, remove=False):
    """Separate checkout authorization, never a Cargo-retirement receipt.

    Only genuinely absent targets qualify. No saved outcome is consumed as future
    authorization: every invocation repeats the checks, under the existing target
    and registry locks. The normal gate and the cache deletion engine are untouched.
    """
    wt, target = target_for_worktree(path)
    result = dict(worktree=wt, target=target, historical_cache_retirement="UNKNOWN",
                  status="HOLD", outcome="NOT_REMOVED")

    def require(ok, code, explanation):
        if not ok:
            raise LegacyCheckoutHold(code, explanation)

    # No inherited GIT_DIR/GIT_WORK_TREE/alternates, and no replace refs or grafts that
    # could make unmerged history look merged.
    git_env = {k: v for k, v in os.environ.items() if not k.startswith("GIT_")}
    git_env.update(GIT_NO_REPLACE_OBJECTS="1", GIT_GRAFT_FILE="/nonexistent", GIT_CONFIG_NOSYSTEM="1")

    def git(*args):
        proc = F.run_as_owner(["git", "-C", wt, *args], capture_output=True,
                              text=True, timeout=30, env=git_env)
        require(proc.returncode == 0, "GIT_STATE_UNVERIFIED", proc.stderr.strip())
        return proc.stdout.strip()

    def history():
        problem = history_preservation_problem(wt)
        if problem:
            raise LegacyCheckoutHold(*problem)

    def absent():
        listed = F.hold_listed(wt, target)       # HOLD overrides removal: checked at every re-check
        require(not listed, listed or "", EXPLANATIONS.get(listed or "", ""))
        # exists/isdir would misclassify dangling symlinks and permission failures.
        try:
            os.lstat(target)
        except FileNotFoundError:
            require(os.path.isdir(os.path.dirname(target)) and
                    os.path.realpath(os.path.dirname(target)) == os.path.dirname(target),
                    "TARGET_PATH_UNVERIFIED", "target parent must exist without symlink aliases")
            return
        raise LegacyCheckoutHold("TARGET_PRESENT_USE_NORMAL_LIFECYCLE",
                                 "a target object exists; use normal Cargo lifecycle rules")

    def checkout():
        require(os.path.abspath(path) == wt and os.path.isdir(wt),
                "CHECKOUT_PATH_UNVERIFIED", "checkout must be its existing canonical path")
        require(git("rev-parse", "--show-toplevel") == wt,
                "CHECKOUT_PATH_UNVERIFIED", "path is not a Git checkout root")
        listing = git("worktree", "list", "--porcelain")
        blocks = [dict(line.partition(" ")[::2] for line in b.splitlines())
                  for b in listing.split("\n\n")]
        rows = [b for b in blocks if b.get("worktree") == wt]
        require(len(rows) == 1 and not any(k in rows[0] for k in ("locked", "prunable")),
                "GIT_WORKTREE_PROTECTED", "checkout must be registered, unlocked and not prunable")
        history()
        head = git("rev-parse", "HEAD")
        main = git("rev-parse", "--verify", "refs/remotes/origin/main^{commit}")
        merged = F.run_as_owner(["git", "-C", wt, "merge-base", "--is-ancestor", head, main],
                                capture_output=True, text=True, timeout=30, env=git_env).returncode == 0
        preserved = None
        if not merged:
            require(isinstance(preserved_ref, str) and preserved_ref.startswith(("refs/heads/", "refs/tags/", "refs/preservation/", "refs/archive/")),
                    "GIT_HISTORY_NOT_PRESERVED", "unmerged HEAD needs an explicit retained local ref")
            preserved = git("rev-parse", "--verify", preserved_ref + "^{commit}")
            require(preserved == head, "GIT_HISTORY_NOT_PRESERVED", "preserved ref must name exact HEAD")
        st = os.stat(wt)
        return dict(head=head, branch=rows[0].get("branch", ""), main=main,
                    preserved_ref=preserved_ref, preserved_head=preserved,
                    checkout_identity=[st.st_dev, st.st_ino])

    def ownership(registry, key, branch):
        records = []
        # all_records() silently drops corrupt records: that cannot prove exclusivity.
        for name in sorted(os.listdir(os.path.join(registry.root, "targets"))):
            if not name.endswith(".json"):
                continue
            filename = registry.path("targets", name[:-5])
            st = os.lstat(filename)
            state, record = registry.read_checked("targets", name[:-5], F.valid_target_record)
            require(stat.S_ISREG(st.st_mode) and st.st_uid == os.geteuid() and state == "ok",
                    "TARGET_OWNERSHIP_UNVERIFIED", "unreadable, aliased or malformed registry record")
            require(record["target"] == os.path.normpath(record["target"]) and
                    os.path.isabs(record["target"]) and name[:-5] == F.key_for(record["target"]) and
                    record.get("key", name[:-5]) == name[:-5],
                    "TARGET_OWNERSHIP_UNVERIFIED", "record target/key identity is inconsistent")
            if record.get("worktree") and os.path.realpath(record["worktree"]) == wt:
                require(record["target"] == target, "TARGET_OWNERSHIP_UNVERIFIED",
                        "checkout also owns a different recorded target")
            if os.path.realpath(record["target"]) == target:
                require(record.get("worktree") == wt, "TARGET_OWNERSHIP_UNVERIFIED",
                        "target is shared or claimed by another checkout")
                records.append(record)
        require(len(records) <= 1, "TARGET_OWNERSHIP_UNVERIFIED", "target has multiple owners")
        state, pins = registry.pin_state(key)
        require(state != "invalid", "PIN_STATE_UNKNOWN", "pin record is unreadable or malformed")
        require(not pins, "PINNED", "target retains an explicit pin")
        for record in records:
            for entry in record.get("active", []):
                require(entry.get("boot_id") is not None and entry.get("starttime") is not None,
                        "RECORDED_BUILD_UNVERIFIED", "recorded build identity cannot be resolved")
                require(not (entry["boot_id"] == F.boot_id() and
                             F.proc_starttime(entry["pid"]) == entry["starttime"]),
                        "RECORDED_BUILD_ALIVE", "recorded Cargo build is still alive")
        identities = [wt, branch] + [str(r.get(k) or "") for r in records
                                     for k in ("task", "worktree")]
        if any(re.search(r"(?:^|[/_-])r[23](?:$|[/_-])", value, re.I) for value in identities):
            result["deployment_conditions"] = "UNKNOWN"
            raise LegacyCheckoutHold("PRODUCTION_DEPLOYMENT_UNRESOLVED",
                                     "R2/R3 deployment and ownership conditions need independent resolution; this is not proof of a live owner")
        census = F.Census([wt, target])
        measured = F.measure_tree(wt, set(), with_identities=True)
        require(not measured["errors"] and not measured["cross_device"],
                "CHECKOUT_IDENTITIES_UNVERIFIED", "checkout inode identities could not be completely inspected")
        census.match_inodes(measured["identities"], wt)
        require(not census.unreadable_foreign, "INCOMPLETE_PROCESS_VISIBILITY",
                "cannot independently exclude host process references")
        require(not census.refs.get(wt) and not census.refs.get(target),
                "LIVE_PROCESS_REFERENCE", "a process references the checkout or target")

    try:
        # First: a present target must not be able to hide lost history.
        history()
        absent()
        registry = F.Registry(create=True)
        key = F.key_for(target)
        with contextlib.ExitStack() as stack:
            # Same ordering as task completion: target lock, then metadata lock.
            for lockpath in (registry.lifecycle_lock_path(key), os.path.join(registry.root, "locks", "registry.meta")):
                fd = F.open_lock_file(lockpath, os.O_RDWR | os.O_CREAT)
                stack.callback(os.close, fd)
                try:
                    fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                except BlockingIOError:
                    raise LegacyCheckoutHold("LIFECYCLE_LOCKED", "build or registry ownership transition is in progress")
            absent()
            snapshot = checkout()
            ownership(registry, key, snapshot["branch"])
            result.update(snapshot, status="CLEAR", code="LEGACY_ABSENT_TARGET_RECONCILED",
                          outcome="CHECKOUT_ELIGIBLE", explanation="independent checkout checks passed; historical cache retirement remains UNKNOWN")
            if remove:
                event = dict(result, event="legacy_checkout_reconciliation", outcome="CHECKOUT_REMOVAL_INTENT")
                append_history(event)
                # An intent is evidence, never reusable authorization. Revalidate after publication.
                absent()
                ownership(registry, key, snapshot["branch"])
                # Census can take time; ignored QA evidence appearing during it must
                # be found before Git, which otherwise silently removes ignored files.
                require(checkout() == snapshot, "CHECKOUT_CHANGED", "checkout or preservation ref changed")
                absent()
                git("worktree", "remove", wt)  # intentionally never --force
                result["outcome"] = "CHECKOUT_REMOVED"
                append_history(dict(result, event="legacy_checkout_reconciliation"))
    except LegacyCheckoutHold as error:
        result.update(status="HOLD", code=error.code, explanation=error.explanation)
        if result["outcome"] != "CHECKOUT_REMOVED":
            result["outcome"] = "NOT_REMOVED"
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        result.update(status="HOLD", code="RECONCILIATION_UNVERIFIED", explanation=str(error))
        if result["outcome"] != "CHECKOUT_REMOVED":
            result["outcome"] = "NOT_REMOVED"
    return result


def cmd_worktree_reconcile(args):
    result = reconcile_legacy_worktree(args.worktree, args.preserved_ref, args.remove)
    if args.json:
        print(json.dumps(result, indent=1, sort_keys=True))
    else:
        print(f"{result['status']}: {result['worktree']}: {result['code']}; historical cache retirement UNKNOWN")
        print("  " + result["explanation"])
    return 0 if result["status"] == "CLEAR" else EXIT_WORKTREE_HOLD


def cmd_task_complete(args):
    """The explicit task-completion step: release the cache (idempotent) while the
    worktree still exists, then report whether the worktree may be removed.  It does
    not remove anything and runs only when an agent invokes it."""
    wt = os.path.realpath(args.worktree)
    if not os.path.isdir(wt):
        raise SystemExit("task-complete must run while the worktree still exists "
                         "(ownership is verified from it at retirement time)")
    out = io.StringIO()
    argv = ["finish", wt] + (["--task", args.task] if args.task else [])
    with contextlib.redirect_stdout(out):
        try:
            rc = F.main(argv)
        except SystemExit as exit_:
            rc = 1
            out.write(str(exit_.code) + "\n")
    msg = out.getvalue().strip()
    gate = worktree_gate(wt)
    if rc != 0:
        print(msg, file=sys.stderr)
        # a target that was never built has nothing to release or strand, whatever
        # the checkout's Git state: that is reported below, and is not a release failure
        if lifecycle_gate(wt)["status"] != "CLEAR":
            return rc
    res = {"released": rc == 0, "message": msg, "gate": gate}
    if args.json:
        print(json.dumps(res, indent=1, sort_keys=True))
    else:
        if msg:
            print(msg)
        print(f"worktree: {gate['status']} - {gate['explanation']}{history_note(gate)}")
        if gate["status"] != "CLEAR":
            print("  KEEP this worktree. Do not remove it until "
                  f"`scripts/emuwiz-cargo-maintain worktree-check {wt}` reports CLEAR.")
    return 0


# ---------------------------------------------------------------- admission


def quick_total(root):
    """(allocated bytes below the target root, complete).  `complete` is False when the
    listing or any `du` run failed, in which case the number is only a lower bound."""
    try:
        names = [os.path.join(root, n) for n in sorted(os.listdir(root))]
    except FileNotFoundError:
        return 0, True
    except OSError:
        return 0, False
    names = [n for n in names if os.path.isdir(n) and not os.path.islink(n)]
    if not names:
        return 0, True
    total, complete = 0, True
    for i in range(0, len(names), 200):
        try:
            proc = F.run_as_owner(["du", "-sxB1", "--"] + names[i:i + 200], capture_output=True, text=True)
        except OSError:
            return total, False
        if proc.returncode != 0:
            complete = False
        for line in proc.stdout.splitlines():
            try:
                total += int(line.split("\t", 1)[0])
            except ValueError:
                complete = False
    return total, complete


def _env_number(name, default, kind, problems, minimum=0, maximum=None):
    """Strict parse of an optional environment number: finite, within bounds, else the
    default is used and the problem is reported (never a crash, never a silent change)."""
    raw = os.environ.get(name)
    if raw is None or raw == "":
        return default
    try:
        value = kind(raw)
        if not math.isfinite(value) or value <= minimum or (maximum is not None and value > maximum):
            raise ValueError("out of range")
    except (ValueError, OverflowError):
        problems.append(f"{name}={raw!r}")
        return default
    return value


def _record_admission(event):
    try:
        append_history(event)
    except OSError:
        pass


def cmd_admit(args):
    """Budget admission for a new or re-created cargo-iso target.

    ADVISORY ONLY.  It warns and records; it never refuses a build (exit 0 always, so
    cargo-iso's 8 GiB physical free-space guard remains the only blocker).  An enforcing
    mode is intentionally NOT available: it needs one trusted measurement shared with
    status/run, an atomic reservation for concurrent cold builds and validated
    configuration, none of which exist yet (see docs/CARGO_CACHE_RETENTION.md)."""
    target = os.path.realpath(args.target)
    raw_mode = (os.environ.get("EMUWIZ_ADMISSION") or "advisory").strip().lower()
    notes = []
    if raw_mode in ("0", "off", "false", "no"):
        reason = os.environ.get("EMUWIZ_ADMISSION_REASON", "")
        print("cargo-iso: note: Cargo cache budget advisory is switched off (EMUWIZ_ADMISSION=0); recorded", file=sys.stderr)
        _record_admission({"event": "admission_disabled", "target": target, "reason": reason})
        return 0
    if raw_mode == "enforce":
        notes.append("EMUWIZ_ADMISSION=enforce was requested but enforce mode is not available in this release; "
                     "running advisory only (nothing is refused)")
    elif raw_mode not in ("advisory", "1", "on", "true", "yes"):
        notes.append(f"unknown EMUWIZ_ADMISSION={raw_mode!r} ignored; running advisory only")
    # An existing directory that still holds compiler output allocates nothing new; a
    # missing, empty or artifact-free (retired) directory is a cold start.
    try:
        if os.path.isdir(target) and F.select_artifacts(target, None)[0]:
            if notes:
                print("cargo-iso: note: " + "; ".join(notes), file=sys.stderr)
            return 0
    except OSError:
        pass
    st, policy, why = load_policy()
    limits = (policy or {}).get("limits", {})
    problems = []
    hard = _env_number("EMUWIZ_HARD_BUDGET_BYTES", limits.get("hard_budget_bytes", DEFAULT_HARD), int, problems)
    allow_gb = _env_number("EMUWIZ_COLD_TARGET_GB", None, float, problems, maximum=10_000)
    allowance = int(allow_gb * 1e9) if allow_gb else DEFAULT_COLD_ALLOWANCE
    if problems:
        notes.append("ignored invalid setting(s) " + ", ".join(problems) + "; using the defaults")
        _record_admission({"event": "admission_config_invalid", "target": target, "settings": problems})
    root = F.target_root()
    usage = None
    try:
        with open(usage_path()) as handle:
            usage = json.load(handle)
        if not isinstance(usage, dict) or now() - usage["measured_at"] > USAGE_TTL_SECONDS \
                or not _is_count(usage["total"]) or usage.get("complete") is not True:
            usage = None
    except (OSError, ValueError, KeyError, TypeError):
        usage = None
    if usage is None:
        total, complete = quick_total(root)
        usage = {"measured_at": now(), "total": total, "complete": complete}
        try:
            prior = {}
            try:
                with open(usage_path()) as handle:
                    prior = json.load(handle)
            except (OSError, ValueError):
                pass
            keep = {k: prior[k] for k in ("auto_eligible_allocated", "status_at", "status_total") if k in prior} \
                if isinstance(prior, dict) else {}
            ensure_state()
            F.atomic_write(usage_path(), dict(keep, **usage))
        except OSError:
            pass
    reclaimable = None
    try:
        with open(usage_path()) as handle:
            reclaimable = json.load(handle).get("auto_eligible_allocated")
    except (OSError, ValueError, AttributeError):
        pass
    if not usage["complete"]:
        notes.append("the cache allocation could not be measured completely; no budget conclusion drawn")
    elif usage["total"] + allowance > hard:
        notes.append(f"Cargo cache budget advisory: {gb(usage['total'])} allocated + {gb(allowance)} for a new target "
                     f"would exceed the hard budget {gb(hard)}")
        if reclaimable:
            notes.append(f"about {gb(reclaimable)} of released output is auto-eligible for the maintenance cycle")
        else:
            notes.append("no released output is known to be reclaimable; release finished tasks with "
                         "`scripts/cargo-iso --finish-task`")
        _record_admission({"event": "admission_advisory", "target": target, "total": usage["total"],
                           "allowance": allowance, "hard": hard})
    if notes:
        print("cargo-iso: advisory: " + "; ".join(notes) + " (not enforced; the build continues)", file=sys.stderr)
    return 0


# --------------------------------------------------------------- systemd


DEFAULT_INSTALL_DIR = "/usr/local/libexec/emuwiz-cargo-maintain"
UNIT_SAFE = re.compile(r"^/[A-Za-z0-9._/-]+$")
USER_SAFE = re.compile(r"^[a-z_][a-z0-9_.-]*$")

SERVICE = """[Unit]
Description=EmuWiz Cargo cache maintenance cycle (policy-gated; deletes nothing unless the policy is enabled)
ConditionPathExists={state}/policy.json
RequiresMountsFor={targets}

[Service]
Type=oneshot
TimeoutStartSec=30min
# Root is used only for a COMPLETE process census (a partial census fails closed).
# The program refuses to start unless it and all code it loads are root-owned and not
# writable by anyone else, then does every file operation as {user}.
User=root
Group=root
{environment}UMask=0077
# Routine cycle: only caches every safety gate accepts (released, idle, census-clear, merged
# and preserved source); stops at the first uncertain target.  Exits 75 while the policy is
# disabled.  Exceptional retirements need an owner-signed scoped run and never run here.
ExecStart={python} -I -S {script} --as-user {user} run
SuccessExitStatus=75
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths={registry} {targets}
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_SYS_PTRACE CAP_DAC_READ_SEARCH
Nice=10
IOSchedulingClass=idle
"""

TIMER = """[Unit]
Description=EmuWiz Cargo cache maintenance (opt-in timer; install and enable deliberately)

[Timer]
OnBootSec=5m
OnUnitInactiveSec=5m
RandomizedDelaySec=30s
Persistent=true

[Install]
WantedBy=timers.target
"""


def unit_texts(user, install_dir, python="/usr/bin/python3"):
    """(service, timer) for the installed copy in `install_dir`, never for this checkout."""
    import pwd
    pw = pwd.getpwnam(user)
    if pw.pw_uid == 0:
        raise SystemExit("units: --as-user must name the unprivileged owner, not root")
    home = pw.pw_dir
    env = {"HOME": home}
    for name in ("EMUWIZ_RETENTION_DIR", "EMUWIZ_TARGET_ROOT", "EMUWIZ_OWNER", "EMUWIZ_MAINTENANCE_INSTANCE"):
        if os.environ.get(name):
            env[name] = os.environ[name]
    registry = os.environ.get("EMUWIZ_RETENTION_DIR") or os.path.join(home, ".cache", "emuwiz-cargo-retention")
    targets = os.environ.get("EMUWIZ_TARGET_ROOT") or os.path.join(home, ".cache", "emuwiz-cargo-targets")
    instance = maintenance_instance()
    if instance is not None and not os.environ.get("EMUWIZ_TARGET_ROOT"):
        raise SystemExit("units: an EMUWIZ_MAINTENANCE_INSTANCE needs an explicit EMUWIZ_TARGET_ROOT")
    state = os.path.join(registry, "maintenance" if instance is None else f"maintenance-{instance}")
    script = os.path.join(install_dir, "emuwiz-cargo-maintain")
    if not USER_SAFE.match(env.get("EMUWIZ_OWNER", user)):
        raise SystemExit(f"units: unusual owner label {env.get('EMUWIZ_OWNER')!r}")
    for value in (registry, targets, script, home, python):
        if name_unsafe(value):
            raise SystemExit(f"units: {value!r} is not a plain absolute path; refusing to write it into a unit")
    if not USER_SAFE.match(user):
        raise SystemExit(f"units: unusual user name {user!r}")
    environment = "".join(f"Environment={k}={v}\n" for k, v in env.items())
    return SERVICE.format(registry=registry, targets=targets, state=state, user=user, script=script,
                          python=python, environment=environment), TIMER


def unit_basename():
    instance = maintenance_instance()
    return "emuwiz-cargo-maintain" if instance is None else f"emuwiz-cargo-maintain-{instance}"


def name_unsafe(value):
    return not (UNIT_SAFE.match(value) and os.path.normpath(value) == value)


def cmd_units(args):
    import pwd
    user = args.as_user or pwd.getpwuid(os.geteuid()).pw_name
    install_dir = os.path.normpath(args.install_dir)
    if name_unsafe(install_dir):
        raise SystemExit(f"units: install directory {install_dir!r} is not a plain absolute path")
    script = os.path.join(install_dir, "emuwiz-cargo-maintain")
    why = _install_problem(script, [os.path.join(install_dir, n) for n in SIBLINGS], os.path.realpath(args.python), [])
    if why:
        raise SystemExit(f"units: refusing to write units for an untrusted installation or interpreter: {why}")
    service, timer = unit_texts(user, install_dir, args.python)
    base = unit_basename()
    if args.output_dir:
        for name, text in ((f"{base}.service", service), (f"{base}.timer", timer)):
            path = os.path.join(args.output_dir, name)
            fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o644)
            with os.fdopen(fd, "w") as handle:
                handle.write(text)
        print(f"wrote {base}.service and .timer to {args.output_dir} (nothing installed or enabled)")
        return 0
    print(f"# {base}.service")
    print(service)
    print(f"# {base}.timer")
    print(timer)
    print(f"# Nothing is installed or enabled by this command.  The service runs the ROOT-OWNED copy in\n"
          f"# {install_dir} (never a Git worktree); install it first and check it with `verify-install`\n"
          "# (docs/CARGO_CACHE_RETENTION.md, privileged installation).  Enabling the timer is a separate,\n"
          "# explicit owner decision, after `policy approve` + `policy enable`.")
    return 0


def cmd_verify_install(args):
    """The trusted-install gate, run on demand (it also runs on every privileged start)."""
    _require_trusted_install(__file__, [os.path.join(HERE, n) for n in SIBLINGS], force=True)
    out = {"install_dir": HERE, "interpreter": os.path.realpath(sys.executable), "trusted": True, "files": {}}
    for name in ("emuwiz-cargo-maintain",) + SIBLINGS:
        out["files"][name] = file_sha256(os.path.join(HERE, name))
    print(json.dumps(out, indent=1, sort_keys=True))
    return 0


# ---------------------------------------------------------- privileged start


PRIVILEGED_COMMANDS = ("status", "plan", "run", "history", "worktree-check", "worktree-reconcile", "units", "verify-install")


def enter_privileged(args):
    """Started as root: only the read/cycle commands, only for an explicit owner, and
    every file operation as that owner (the foundation's drop_to_owner)."""
    import pwd
    if os.geteuid() != 0:
        if args.as_user is not None and args.command != "units" \
                and pwd.getpwuid(os.geteuid()).pw_name != args.as_user:
            raise SystemExit(f"--as-user {args.as_user}: only root can act for another user")
        return
    if args.command not in PRIVILEGED_COMMANDS:
        raise SystemExit(f"`{args.command}` is an owner action: run it as the owner, not as root")
    if not args.as_user:
        raise SystemExit("running as root requires --as-user OWNER (the account that owns the caches and registry)")
    if os.environ.get("EMUWIZ_RETENTION_NOW"):
        raise SystemExit("a privileged run refuses EMUWIZ_RETENTION_NOW: it needs real time")
    pw = F.drop_to_owner(args.as_user)
    if args.command not in ("units", "verify-install"):
        F.require_owned_dirs(pw.pw_uid, [F.registry_dir(), F.target_root()])


# ------------------------------------------------------------------ main


def build_parser():
    p = argparse.ArgumentParser(prog="emuwiz-cargo-maintain", description=__doc__.split("\n\n")[0])
    p.add_argument("--as-user", metavar="OWNER",
                   help="required when started as root: do all file work as OWNER (root only for the census)")
    sub = p.add_subparsers(dest="command", required=True)
    for name, fn in (("status", cmd_status), ("plan", cmd_plan)):
        sp = sub.add_parser(name)
        sp.add_argument("--json", action="store_true")
        if name == "plan":
            sp.add_argument("--output")
            sp.add_argument("--only", action="append", metavar="TARGET",
                            help="plan exactly these target names (repeatable); refuses the whole request unless every one is eligible")
        sp.set_defaults(func=fn)
    r = sub.add_parser("run")
    r.add_argument("--dry-run", action="store_true")
    r.add_argument("--only", action="append", metavar="TARGET",
                   help="retire exactly these target names (repeatable); all-or-nothing, never substitutes another target")
    r.add_argument("--scoped-run", metavar="FILE",
                   help="owner-signed scoped-run record (FILE and FILE.sig) for exactly --only; "
                        "without it the cycle is routine (verified-reproducible caches only)")
    r.add_argument("--enable-for-cycle", action="store_true",
                   help="enable the DISABLED policy for this one cycle and restore DISABLED afterwards (also on error or signal)")
    r.set_defaults(func=cmd_run)
    hr = sub.add_parser("hold-release-request", help="write an unsigned HOLD release record for one checkout")
    hr.add_argument("--entry", required=True)
    hr.add_argument("--worktree", required=True)
    hr.add_argument("--note")
    hr.set_defaults(func=cmd_hold_release_request)
    ha = sub.add_parser("hold-release-apply", help="record RELEASED from an owner-signed release record")
    ha.add_argument("--record", required=True)
    ha.set_defaults(func=cmd_hold_release_apply)
    hs = sub.add_parser("hold-set", help="record HELD for an entry (overrides any earlier release)")
    hs.add_argument("--entry", required=True)
    hs.add_argument("--path")
    hs.add_argument("--reason")
    hs.set_defaults(func=cmd_hold_set)
    rq = sub.add_parser("request-retirement",
                        help="write a scoped-run record (accident protection only; the owner must sign it before anything is deleted)")
    rq.add_argument("--only", action="append", metavar="TARGET")
    rq.add_argument("--manifest", help="an existing manifest instead of --only")
    rq.add_argument("--hours", type=float, default=4.0, help="validity, at most 24 (default 4)")
    rq.add_argument("--note")
    rq.set_defaults(func=cmd_request_retirement)
    at = sub.add_parser("attest-retirement",
                        help="record historical retirement EVIDENCE for an executed receipt (never authorises deletion)")
    at.add_argument("--receipt", required=True)
    at.add_argument("--manifest-sha256", required=True)
    at.add_argument("--evidence", required=True, help="file preserving the owner's approval text; must quote the digest")
    at.add_argument("--note")
    at.add_argument("--allow-partial", action="store_true")
    at.set_defaults(func=cmd_attest_retirement)
    pol = sub.add_parser("policy")
    pol.add_argument("action", choices=("show", "approve", "enable", "disable"))
    pol.add_argument("--owners", help="comma-separated owner labels covered by the policy")
    pol.add_argument("--target-root")
    pol.add_argument("--soft-gb", type=float, default=DEFAULT_SOFT / 1e9)
    pol.add_argument("--hard-gb", type=float, default=DEFAULT_HARD / 1e9)
    pol.add_argument("--min-idle-hours", type=float, default=MIN_IDLE_HOURS)
    pol.add_argument("--reserve-free-gib", type=float, default=100,
                     help="restore this free-space reserve, subject to all safety gates")
    pol.add_argument("--reserve-trigger-free-gib", type=float, default=None,
                     help="start reclaiming for the reserve only below this much free space "
                          "(default: the reserve itself); must not exceed --reserve-free-gib")
    pol.add_argument("--max-targets", type=int, default=10)
    pol.add_argument("--max-gb", type=float, default=100.0)
    pol.set_defaults(func=cmd_policy)
    h = sub.add_parser("history")
    h.add_argument("--json", action="store_true")
    h.set_defaults(func=cmd_history)
    a = sub.add_parser("admit")
    a.add_argument("--target", required=True)
    a.set_defaults(func=cmd_admit)
    wc = sub.add_parser("worktree-check", help="may this worktree be removed? (CLEAR/HOLD, exit 10 on HOLD)")
    wc.add_argument("worktree")
    wc.add_argument("--json", action="store_true")
    wc.add_argument("--cargo-state-only", action="store_true",
                    help="report only the Cargo cache state; never an authority to remove the worktree")
    wc.set_defaults(func=cmd_worktree_check)
    wr = sub.add_parser("worktree-reconcile", help="independent legacy checkout reconciliation; never claims cache retirement")
    wr.add_argument("worktree")
    wr.add_argument("--preserved-ref", help="explicit retained local ref naming exact unmerged HEAD")
    wr.add_argument("--remove", action="store_true", help="recheck under lifecycle locks and run git worktree remove without force")
    wr.add_argument("--json", action="store_true")
    wr.set_defaults(func=cmd_worktree_reconcile)
    tc = sub.add_parser("task-complete", help="release this worktree's cache (idempotent) and report whether it may be removed")
    tc.add_argument("--worktree", default=os.getcwd())
    tc.add_argument("--task")
    tc.add_argument("--json", action="store_true")
    tc.set_defaults(func=cmd_task_complete)
    u = sub.add_parser("units", help="print (or --output-dir: write) the units for the root-owned installed copy")
    u.add_argument("--install-dir", default=DEFAULT_INSTALL_DIR)
    u.add_argument("--output-dir", help="write the two unit files here instead of printing them")
    u.add_argument("--python", default="/usr/bin/python3",
                   help="interpreter for ExecStart; it and its directories must be root-owned (verify-install checks)")
    u.set_defaults(func=cmd_units)
    vi = sub.add_parser("verify-install", help="check that this copy is fit to run with root privileges")
    vi.set_defaults(func=cmd_verify_install)
    return p


def main(argv=None):
    args = build_parser().parse_args(argv)
    enter_privileged(args)
    if args.command not in ("units", "verify-install"):
        if recover_stale_temporary_enable() == "LIVE" and args.command == "policy" and args.action == "enable":
            raise SystemExit("policy enable: a temporary maintenance cycle is running")
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
